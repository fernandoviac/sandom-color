  ;; Source-plane ABI v1: 64-byte record, u32 fields src,length,width,height,
  ;; stride,sample,bits,layout,alpha,transfer,primaries,mode, then f64 gamma,
  ;; reference-white. Enum values match color-source.js and the color ABI.
  (func $source_positive (param $value f64) (result i32)
    (i32.and (f64.gt (local.get $value) (f64.const 0)) (f64.lt (local.get $value) (f64.const inf))))

  (func $source_sample (param $pointer i32) (param $sample i32) (param $maximum f64) (param $degraded i32) (result f64)
    (if (i32.eqz (local.get $sample))
      (then
        (if (local.get $degraded) (then (return (f64.convert_i32_u (i32.load8_u (local.get $pointer))))))
        (return (f64.div (f64.convert_i32_u (i32.load8_u (local.get $pointer))) (f64.const 255)))))
    (if (i32.eq (local.get $sample) (i32.const 1))
      (then
        (if (local.get $degraded) (then (return (f64.convert_i32_u (i32.shr_u (i32.load16_u (local.get $pointer)) (i32.const 8))))))
        (return (f64.div (f64.convert_i32_u (i32.load16_u (local.get $pointer))) (local.get $maximum)))))
    (if (i32.eq (local.get $sample) (i32.const 2))
      (then (return (call $packing_unhalf (i32.load16_u (local.get $pointer))))))
    (f64.promote_f32 (f32.load (local.get $pointer))))

  (func $source_channel (param $base i32) (param $channel i32) (param $channels i32) (param $step i32) (param $sample i32) (param $maximum f64) (param $degraded i32) (result f64)
    (local $index i32)
    (if (i32.and (i32.eq (local.get $channel) (i32.const 3)) (i32.and (local.get $channels) (i32.const 1)))
      (then (return (select (f64.const 255) (f64.const 1) (local.get $degraded)))))
    (local.set $index (local.get $channel))
    (if (i32.lt_u (local.get $channels) (i32.const 3))
      (then (local.set $index (select (i32.const 1) (i32.const 0) (i32.eq (local.get $channel) (i32.const 3))))))
    (call $source_sample (i32.add (local.get $base) (i32.mul (local.get $index) (local.get $step))) (local.get $sample) (local.get $maximum) (local.get $degraded)))

  (func $source_decode (param $value f64) (param $transfer i32) (param $gamma f64) (result f64)
    (if (i32.eqz (local.get $transfer)) (then (return (call $srgb_decode (local.get $value)))))
    (if (i32.eq (local.get $transfer) (i32.const 2)) (then (return (call $gamma_decode (local.get $value) (local.get $gamma)))))
    (if (i32.eq (local.get $transfer) (i32.const 3)) (then (return (call $pq_to_working (local.get $value)))))
    (if (i32.eq (local.get $transfer) (i32.const 5)) (then (return (call $rec2020_decode (local.get $value)))))
    (if (i32.eq (local.get $transfer) (i32.const 6)) (then (return (call $prophoto_decode (local.get $value)))))
    ;; HLG is RGB-coupled and is applied to VEC by the caller.
    (local.get $value))

  (func $source_prepare (param $record i32) (param $dst i32) (param $capacity i32) (param $operation i32) (param $destinationPrimaries i32) (result i32)
    (local $src i32) (local $length i32) (local $width i32) (local $height i32) (local $stride i32)
    (local $sample i32) (local $bits i32) (local $layout i32) (local $alphaMode i32) (local $transfer i32) (local $primaries i32) (local $mode i32)
    (local $gamma f64) (local $white f64) (local $maximum f64) (local $linearScale f64) (local $alpha f64) (local $value f64)
    (local $step i32) (local $channels i32) (local $size i32) (local $status i32) (local $degraded i32)
    (local $base i32) (local $x i32) (local $y i32) (local $channel i32) (local $outputStep i32) (local $table i32) (local $i i32)
    (if (i32.eqz (call $color_span (local.get $record) (global.get $COLOR_SOURCE_SIZE))) (then (return (call $color_fail (i32.const 2) (i32.const 0)))))
    (if (i32.and (local.get $record) (i32.const 7)) (then (return (call $color_fail (i32.const 2) (i32.const 0)))))
    (local.set $src (i32.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_SRC))))
    (local.set $length (i32.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_LENGTH))))
    (local.set $width (i32.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_WIDTH))))
    (local.set $height (i32.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_HEIGHT))))
    (local.set $stride (i32.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_STRIDE))))
    (local.set $sample (i32.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_SAMPLE))))
    (local.set $bits (i32.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_BITS))))
    (local.set $layout (i32.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_LAYOUT))))
    (local.set $alphaMode (i32.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_ALPHA))))
    (local.set $transfer (i32.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_TRANSFER))))
    (local.set $primaries (i32.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_PRIMARIES))))
    (local.set $mode (i32.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_MODE))))
    (local.set $gamma (f64.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_GAMMA))))
    (local.set $white (f64.load (i32.add (local.get $record) (global.get $COLOR_SOURCE_REFERENCE_WHITE))))
    (if (i32.gt_u (local.get $sample) (i32.const 3)) (then (return (call $color_fail (i32.const 1) (i32.const 20)))))
    (if (i32.gt_u (local.get $layout) (i32.const 3)) (then (return (call $color_fail (i32.const 1) (i32.const 28)))))
    (if (i32.gt_u (local.get $alphaMode) (i32.const 2)) (then (return (call $color_fail (i32.const 1) (i32.const 32)))))
    (if (i32.gt_u (local.get $transfer) (i32.const 7)) (then (return (call $color_fail (i32.const 1) (i32.const 36)))))
    (if (i32.gt_u (local.get $primaries) (i32.const 6)) (then (return (call $color_fail (i32.const 1) (i32.const 40)))))
    (if (i32.gt_u (local.get $mode) (i32.const 1)) (then (return (call $color_fail (i32.const 1) (i32.const 44)))))
    (if (i32.eqz (call $source_positive (local.get $gamma))) (then (return (call $color_fail (i32.const 3) (i32.const 48)))))
    (if (i32.eqz (call $source_positive (local.get $white))) (then (return (call $color_fail (i32.const 3) (i32.const 56)))))
    (local.set $step (select (i32.const 1) (select (i32.const 4) (i32.const 2) (i32.eq (local.get $sample) (i32.const 3))) (i32.eqz (local.get $sample))))
    (if (i32.or (i32.eqz (local.get $bits)) (i32.gt_u (local.get $bits) (i32.mul (local.get $step) (i32.const 8))))
      (then (return (call $color_fail (i32.const 1) (i32.const 24)))))
    (local.set $channels (i32.add (local.get $layout) (i32.const 1)))
    (if (i32.and (i32.and (local.get $channels) (i32.const 1)) (i32.ne (local.get $alphaMode) (i32.const 0)))
      (then (return (call $color_fail (i32.const 1) (i32.const 32)))))
    (local.set $degraded (i32.eqz (local.get $operation)))
    (local.set $outputStep (select (i32.const 4) (select (i32.const 24) (i32.const 16) (i32.eq (local.get $operation) (i32.const 1))) (local.get $degraded)))
    (local.set $size (call $packing_size (local.get $width) (local.get $height) (local.get $outputStep)))
    (if (i32.eqz (local.get $size)) (then (return (call $color_fail (i32.const 2) (i32.const 8)))))
    (if (i64.lt_u (i64.extend_i32_u (local.get $stride)) (i64.mul (i64.extend_i32_u (local.get $width)) (i64.extend_i32_u (i32.mul (local.get $channels) (local.get $step)))))
      (then (return (call $color_fail (i32.const 2) (i32.const 16)))))
    (if (i32.or (i32.rem_u (local.get $stride) (local.get $step)) (i32.rem_u (local.get $src) (local.get $step)))
      (then (return (call $color_fail (i32.const 2) (i32.const 16)))))
    (if (i64.ne (i64.mul (i64.extend_i32_u (local.get $stride)) (i64.extend_i32_u (local.get $height))) (i64.extend_i32_u (local.get $length)))
      (then (return (call $color_fail (i32.const 2) (i32.const 4)))))
    (if (local.get $degraded)
      (then
        (if (i32.gt_u (local.get $sample) (i32.const 1)) (then (return (call $color_fail (i32.const 1) (i32.const 20)))))
        (if (i32.eqz (i32.or (i32.or (i32.eqz (local.get $transfer)) (i32.eq (local.get $transfer) (i32.const 2))) (i32.eq (local.get $transfer) (i32.const 7))))
          (then (return (call $color_fail (i32.const 1) (i32.const 36)))))
        (if (i32.and (i32.ne (local.get $transfer) (i32.const 7)) (i32.ne (local.get $primaries) (i32.const 0)))
          (then (return (call $color_fail (i32.const 1) (i32.const 40))))))
      (else
        (if (i32.eq (local.get $transfer) (i32.const 7)) (then (return (call $color_fail (i32.const 6) (i32.const 36)))))
        (if (i32.eq (local.get $operation) (i32.const 1))
          (then
            (if (i32.gt_u (local.get $destinationPrimaries) (i32.const 6))
              (then (return (call $color_fail (i32.const 1) (i32.const 1)))))))))
    (local.set $status (call $packing_buffers (local.get $record) (global.get $COLOR_SOURCE_SIZE) (local.get $dst) (local.get $size) (local.get $capacity)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $packing_buffers (local.get $src) (local.get $length) (local.get $dst) (local.get $size) (local.get $capacity)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $packing_alignment (local.get $src) (local.get $step) (local.get $dst)
      (select (i32.const 1) (select (i32.const 8) (i32.const 4) (i32.eq (local.get $operation) (i32.const 1))) (local.get $degraded))))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $maximum (f64.const 1))
    (if (i32.eq (local.get $sample) (i32.const 1))
      (then (local.set $maximum (f64.convert_i32_u (i32.sub (i32.shl (i32.const 1) (local.get $bits)) (i32.const 1))))))
    (local.set $linearScale (f64.const 1))
    (if (i32.and (i32.ne (local.get $transfer) (i32.const 3)) (i32.ne (local.get $transfer) (i32.const 4)))
      (then (local.set $linearScale (f64.div (local.get $white) (f64.const 203)))))
    ;; Preserve the old degraded bridge's high-eight-bit truncation BEFORE
    ;; gamma conversion, and compute its 256-entry table only once per image.
    (if (i32.and (local.get $degraded) (i32.eq (local.get $transfer) (i32.const 2)))
      (then
        (local.set $table (call $color_alloc (i32.const 256)))
        (if (i32.eqz (local.get $table)) (then (return (call $color_fail (i32.const 4) (i32.const 48)))))
        (loop $gammaTable
          (i32.store8 (i32.add (local.get $table) (local.get $i))
            (call $packing_quantize
              (call $srgb_encode (call $gamma_decode (f64.div (f64.convert_i32_u (local.get $i)) (f64.const 255)) (local.get $gamma)))
              (f64.const 255)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $gammaTable (i32.lt_u (local.get $i) (i32.const 256))))))
    (loop $row
      (local.set $x (i32.const 0))
      (loop $pixel
        (local.set $base (i32.add (local.get $src) (i32.add (i32.mul (local.get $y) (local.get $stride)) (i32.mul (local.get $x) (i32.mul (local.get $channels) (local.get $step))))))
        (local.set $alpha (call $source_channel (local.get $base) (i32.const 3) (local.get $channels) (local.get $step) (local.get $sample) (local.get $maximum) (local.get $degraded)))
        (if (i32.and (i32.eq (local.get $operation) (i32.const 2)) (i32.eqz (local.get $alphaMode)))
          (then (local.set $alpha (f64.const 1))))
        (local.set $channel (i32.const 0))
        (loop $readChannel
          (local.set $value (call $source_channel (local.get $base) (local.get $channel) (local.get $channels) (local.get $step) (local.get $sample) (local.get $maximum) (local.get $degraded)))
          (if (local.get $degraded)
            (then
              (if (local.get $table) (then (local.set $value (f64.convert_i32_u (i32.load8_u (i32.add (local.get $table) (i32.trunc_f64_u (local.get $value))))))))
              (i32.store8 (i32.add (local.get $dst) (local.get $channel)) (i32.trunc_f64_u (local.get $value))))
            (else
              (if (i32.eq (local.get $operation) (i32.const 2))
                (then
                  (if (f64.eq (local.get $alpha) (f64.const 0))
                    (then (local.set $value (f64.const 0)))
                    (else
                      (if (i32.and (i32.eq (local.get $alphaMode) (i32.const 2)) (f64.gt (local.get $alpha) (f64.const 0)))
                        (then (local.set $value (f64.div (local.get $value) (local.get $alpha)))))))))
              (local.set $value (call $source_decode (local.get $value) (local.get $transfer) (local.get $gamma)))
              (if (i32.eq (local.get $operation) (i32.const 2))
                (then (local.set $value (f64.mul (local.get $value) (local.get $linearScale)))))
              (f64.store (i32.add (call $VEC) (i32.mul (local.get $channel) (i32.const 8))) (local.get $value))))
          (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
          (br_if $readChannel (i32.lt_u (local.get $channel) (i32.const 3))))
        (if (local.get $degraded)
          (then (i32.store8 offset=3 (local.get $dst) (i32.trunc_f64_u (local.get $alpha))))
          (else
            (if (i32.eq (local.get $operation) (i32.const 1))
              (then
                (if (i32.eq (local.get $transfer) (i32.const 4)) (then (call $hlg_rgb_to_working)))
                (if (i32.lt_u (local.get $primaries) (i32.const 5))
                  (then (call $apply_matrix (i32.mul (local.get $primaries) (i32.const 2)))))
                (if (i32.or (i32.eq (local.get $primaries) (i32.const 4)) (i32.eq (local.get $primaries) (i32.const 5)))
                  (then (call $apply_matrix (i32.const 10))))
                (if (i32.eq (local.get $destinationPrimaries) (i32.const 5))
                  (then (call $apply_matrix (i32.const 11)))
                  (else (if (i32.lt_u (local.get $destinationPrimaries) (i32.const 5))
                    (then (call $apply_matrix (i32.add (i32.mul (local.get $destinationPrimaries) (i32.const 2)) (i32.const 1)))))))
                (memory.copy (local.get $dst) (call $VEC) (i32.const 24)))
              (else
                (if (i32.eq (local.get $transfer) (i32.const 4)) (then (call $hlg_rgb_to_working)))
                (if (i32.ne (local.get $primaries) (select (i32.const 0) (i32.const 2) (i32.eqz (local.get $mode))))
                  (then
                    (if (i32.lt_u (local.get $primaries) (i32.const 5))
                      (then (call $apply_matrix (i32.mul (local.get $primaries) (i32.const 2)))))
                    (if (i32.or (i32.eq (local.get $primaries) (i32.const 4)) (i32.eq (local.get $primaries) (i32.const 5)))
                      (then (call $apply_matrix (i32.const 10))))
                    (call $apply_matrix (select (i32.const 1) (i32.const 5) (i32.eqz (local.get $mode))))))
                (local.set $channel (i32.const 0))
                (loop $writeChannel
                  (local.set $value (f64.load (i32.add (call $VEC) (i32.mul (local.get $channel) (i32.const 8)))))
                  (if (i32.eqz (local.get $mode)) (then (local.set $value (call $srgb_encode (local.get $value)))))
                  (if (f64.eq (local.get $alpha) (f64.const 0))
                    (then (local.set $value (f64.const 0)))
                    (else (local.set $value (f64.mul (local.get $value) (local.get $alpha)))))
                  (f32.store (i32.add (local.get $dst) (i32.mul (local.get $channel) (i32.const 4))) (f32.demote_f64 (local.get $value)))
                  (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
                  (br_if $writeChannel (i32.lt_u (local.get $channel) (i32.const 3))))
                (f32.store offset=12 (local.get $dst) (f32.demote_f64 (local.get $alpha)))))))
        (local.set $dst (i32.add (local.get $dst) (local.get $outputStep)))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $pixel (i32.lt_u (local.get $x) (local.get $width))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $row (i32.lt_u (local.get $y) (local.get $height))))
    (if (local.get $table) (then (drop (call $color_free (local.get $table)))))
    (i32.const 0))

  (func (export "color_source_degraded") (param $record i32) (param $dst i32) (param $capacity i32) (result i32)
    (call $source_prepare (local.get $record) (local.get $dst) (local.get $capacity) (i32.const 0) (i32.const 0)))
  (func (export "color_source_linear") (param $record i32) (param $destinationPrimaries i32) (param $dst i32) (param $capacity i32) (result i32)
    (call $source_prepare (local.get $record) (local.get $dst) (local.get $capacity) (i32.const 1) (local.get $destinationPrimaries)))
  (func (export "color_source_working") (param $record i32) (param $dst i32) (param $capacity i32) (result i32)
    (call $source_prepare (local.get $record) (local.get $dst) (local.get $capacity) (i32.const 2) (i32.const 0)))
