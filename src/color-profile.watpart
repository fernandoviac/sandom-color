    (block $done (loop $rows
      (br_if $done (i32.eq (local.get $row) (local.get $height)))
      (local.set $p (i32.add (local.get $input) (i32.mul (local.get $row) (local.get $stride))))
      (local.set $col (i32.const 0))
      (block $rowDone (loop $pixels
        (br_if $rowDone (i32.eq (local.get $col) (local.get $width)))
        (local.set $a (f64.const 1))
        (if (i32.and (i32.ne (local.get $alpha) (i32.const 0)) (i32.and (local.get $layout) (i32.const 1))) (then
          (local.set $a (call $cp_sample
            (i32.add (local.get $p) (i32.mul (i32.sub (local.get $channels) (i32.const 1)) (local.get $bytes)))
            (local.get $sample) (local.get $denominator)))))
        (local.set $ch (i32.const 0))
        (block $channelsDone (loop $channel
          (br_if $channelsDone (i32.eq (local.get $ch) (i32.const 3)))
          (local.set $at (i32.add (local.get $p) (select (i32.const 0) (i32.mul (local.get $ch) (local.get $bytes)) (i32.lt_u (local.get $layout) (i32.const 2)))))
          (local.set $v (call $cp_sample (local.get $at) (local.get $sample) (local.get $denominator)))
          (if (i32.eq (local.get $alpha) (i32.const 2)) (then
            (local.set $v (if (result f64) (f64.eq (local.get $a) (f64.const 0))
              (then (f64.const 0)) (else (f64.div (local.get $v) (local.get $a)))))))
          (f64.store (i32.add (call $VEC) (i32.mul (local.get $ch) (i32.const 8))) (local.get $v))
          (local.set $ch (i32.add (local.get $ch) (i32.const 1))) (br $channel)))
        (call $cp_run (local.get $h) (call $VEC))
        (if (global.get $cp_status) (then
          (drop (call $color_free (local.get $scratch)))
          (return (call $color_fail (global.get $cp_status)
            (i32.or (i32.shl (global.get $cp_field) (global.get $COLOR_PROFILE_ERROR_SAMPLE_BITS))
              (i32.add (i32.mul (local.get $row) (local.get $width)) (local.get $col)))))))
        (f32.store (local.get $out) (f32.demote_f64 (call $load0 (call $VEC))))
        (f32.store offset=4 (local.get $out) (f32.demote_f64 (call $load1 (call $VEC))))
        (f32.store offset=8 (local.get $out) (f32.demote_f64 (call $load2 (call $VEC))))
        (f32.store offset=12 (local.get $out) (f32.demote_f64 (local.get $a)))
        (local.set $out (i32.add (local.get $out) (i32.const 16)))
        (local.set $p (i32.add (local.get $p) (i32.mul (local.get $channels) (local.get $bytes))))
        (local.set $col (i32.add (local.get $col) (i32.const 1))) (br $pixels)))
      (local.set $row (i32.add (local.get $row) (i32.const 1))) (br $rows)))
    (memory.copy (local.get $output) (local.get $scratch) (local.get $size))
    (drop (call $color_free (local.get $scratch)))
    (i32.const 0))
