  (func $color_depth_bit (param $depth i32) (result i32)
    (if (i32.eq (local.get $depth) (i32.const 8)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $depth) (i32.const 10)) (then (return (i32.const 2))))
    (if (i32.eq (local.get $depth) (i32.const 12)) (then (return (i32.const 4))))
    (if (i32.eq (local.get $depth) (i32.const 16)) (then (return (i32.const 8))))
    (if (i32.eq (local.get $depth) (i32.const 116)) (then (return (i32.const 16))))
    (if (i32.eq (local.get $depth) (i32.const 132)) (then (return (i32.const 32))))
    (i32.const 0))

  ;; Return -1 when the capability accepts the policy, otherwise the exact
  ;; record field responsible for rejection.
  (func $color_capability_field (param $policy i32) (param $capability i32) (result i32)
    (local $encoding i32) (local $mask i32) (local $accepted i32)
    (if (i32.ne
      (i32.load (i32.add (local.get $capability) (global.get $COLOR_CAPABILITY_VERSION)))
      (global.get $COLOR_ABI_VERSION))
      (then (return (global.get $COLOR_CAPABILITY_VERSION))))
    (local.set $mask
      (call $color_depth_bit
        (i32.load (i32.add (local.get $policy) (global.get $COLOR_POLICY_DEPTH)))))
    (if (i32.eqz
      (i32.and (local.get $mask)
        (i32.load (i32.add (local.get $capability) (global.get $COLOR_CAPABILITY_DEPTH_MASK)))))
      (then (return (global.get $COLOR_POLICY_DEPTH))))
    (if (i32.ne
      (i32.load (i32.add (local.get $policy) (global.get $COLOR_POLICY_ALPHA)))
      (i32.load (i32.add (local.get $capability) (global.get $COLOR_CAPABILITY_ALPHA))))
      (then (return (global.get $COLOR_POLICY_ALPHA))))
    (local.set $encoding
      (i32.add
        (i32.mul
          (i32.load (i32.add (local.get $policy) (global.get $COLOR_POLICY_PRIMARIES)))
          (i32.const 8))
        (i32.load (i32.add (local.get $policy) (global.get $COLOR_POLICY_TRANSFER)))))
    (local.set $accepted
      (if (result i32) (i32.lt_u (local.get $encoding) (i32.const 32))
        (then
          (i32.and
            (i32.shr_u
              (i32.load (i32.add (local.get $capability) (global.get $COLOR_CAPABILITY_ENCODING_LOW)))
              (local.get $encoding))
            (i32.const 1)))
        (else
          (i32.and
            (i32.shr_u
              (i32.load (i32.add (local.get $capability) (global.get $COLOR_CAPABILITY_ENCODING_HIGH)))
              (i32.sub (local.get $encoding) (i32.const 32)))
            (i32.const 1)))))
    (if (result i32) (local.get $accepted)
      (then (i32.const -1))
      (else (global.get $COLOR_POLICY_TRANSFER))))
