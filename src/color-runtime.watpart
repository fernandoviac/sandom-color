  ;; Standalone arena. Fixed kernel/parser reservations end at 8192.
  ;; Block headers: capacity, next, live, reserved. Free blocks never move.
  (global $color_heap (mut i32) (i32.const 8192))
  (global $color_first (mut i32) (i32.const 0))
  (global $color_last (mut i32) (i32.const 0))
  (global $color_limit (mut i32) (i32.const 268435456))
  (func $color_span (param $ptr i32) (param $length i32) (result i32)
    (local $block i32) (local $end i64)
    (local.set $end (i64.add (i64.extend_i32_u (local.get $ptr)) (i64.extend_i32_u (local.get $length))))
    (local.set $block (global.get $color_first))
    (block $done (loop $next
      (br_if $done (i32.eqz (local.get $block)))
      (if (i32.and (i32.load offset=8 (local.get $block))
          (i32.ge_u (local.get $ptr) (i32.add (local.get $block) (i32.const 16))))
        (then (if (i64.le_u (local.get $end)
          (i64.add (i64.extend_i32_u (local.get $block))
            (i64.add (i64.const 16) (i64.extend_i32_u (i32.load (local.get $block))))))
          (then (return (i32.const 1))))))
      (local.set $block (i32.load offset=4 (local.get $block))) (br $next)))
    (i32.const 0))
  (func (export "color_set_memory_limit") (param $bytes i32) (result i32)
    (if (i32.or (i32.lt_u (local.get $bytes) (global.get $color_heap))
      (i32.gt_u (local.get $bytes) (i32.const 268435456)))
      (then (return (call $color_fail (i32.const 4) (i32.const 0)))))
    (global.set $color_limit (local.get $bytes)) (i32.const 0))
  (func $color_alloc (export "color_alloc") (param $size i32) (result i32)
    (local $block i32) (local $end i32) (local $pages i32)
    (if (i32.or (i32.eqz (local.get $size)) (i32.gt_u (local.get $size) (i32.const 268435424)))
      (then (drop (call $color_fail (i32.const 4) (local.get $size))) (return (i32.const 0))))
    (local.set $size (i32.and (i32.add (local.get $size) (i32.const 7)) (i32.const -8)))
    (local.set $block (global.get $color_first))
    (block $fresh (loop $next
      (br_if $fresh (i32.eqz (local.get $block)))
      (if (i32.and (i32.eqz (i32.load offset=8 (local.get $block)))
        (i32.ge_u (i32.load (local.get $block)) (local.get $size)))
        (then (i32.store offset=8 (local.get $block) (i32.const 1))
          (return (i32.add (local.get $block) (i32.const 16)))))
      (local.set $block (i32.load offset=4 (local.get $block))) (br $next)))
    (local.set $block (global.get $color_heap))
    (local.set $end (i32.add (local.get $block) (i32.add (local.get $size) (i32.const 16))))
    (if (i32.gt_u (local.get $end) (global.get $color_limit))
      (then (drop (call $color_fail (i32.const 4) (local.get $size))) (return (i32.const 0))))
    (local.set $pages (i32.shr_u (i32.add (local.get $end) (i32.const 65535)) (i32.const 16)))
    (if (i32.gt_u (local.get $pages) (memory.size))
      (then (if (i32.eq (memory.grow (i32.sub (local.get $pages) (memory.size))) (i32.const -1))
        (then (drop (call $color_fail (i32.const 4) (local.get $size))) (return (i32.const 0))))))
    (i32.store (local.get $block) (local.get $size))
    (i32.store offset=4 (local.get $block) (i32.const 0))
    (i32.store offset=8 (local.get $block) (i32.const 1))
    (if (global.get $color_last)
      (then (i32.store offset=4 (global.get $color_last) (local.get $block)))
      (else (global.set $color_first (local.get $block))))
    (global.set $color_last (local.get $block)) (global.set $color_heap (local.get $end))
    (i32.add (local.get $block) (i32.const 16)))
  (func $color_free (export "color_free") (param $ptr i32) (result i32)
    (local $block i32)
    (local.set $block (global.get $color_first))
    (block $done (loop $next
      (br_if $done (i32.eqz (local.get $block)))
      (if (i32.eq (local.get $ptr) (i32.add (local.get $block) (i32.const 16)))
        (then (if (i32.eqz (i32.load offset=8 (local.get $block)))
          (then (return (call $color_fail (i32.const 7) (local.get $ptr)))))
          (i32.store offset=8 (local.get $block) (i32.const 0)) (return (i32.const 0))))
      (local.set $block (i32.load offset=4 (local.get $block))) (br $next)))
    (call $color_fail (i32.const 7) (local.get $ptr)))
