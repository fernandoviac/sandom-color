  (func $color_direct_srgb (result i32)
    (i32.and (call $in_gamut (call $VEC))
      (i32.and (call $color_finite (call $load0 (call $VEC)))
        (i32.and (call $color_finite (call $load1 (call $VEC))) (call $color_finite (call $load2 (call $VEC)))))))
  ;; The shared scalar approximations accept finite arguments. Preserve the
  ;; predecessor's IEEE classifications explicitly at this bulk boundary.
