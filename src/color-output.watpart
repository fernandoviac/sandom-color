    (if (i32.and (i32.eq (local.get $range) (i32.const 1)) (i32.eq (call $color_policy_get (local.get $p) (global.get $COLOR_POLICY_DEPTH)) (i32.const 8)))
      (then (return (call $color_fail (i32.const 1) (global.get $COLOR_POLICY_DEPTH)))))
    (if (i32.and (i32.and (i32.load (i32.add (local.get $capability) (global.get $COLOR_CAPABILITY_FLAGS))) (i32.const 1))
      (i32.and (i32.eq (local.get $range) (i32.const 1)) (i32.eqz (call $color_policy_get (local.get $p) (global.get $COLOR_POLICY_MASTERING_PRESENT)))))
      (then (return (call $color_fail (i32.const 3) (global.get $COLOR_POLICY_MASTERING_PRESENT)))))
    (local.set $peak (f64.load (i32.add (local.get $p) (global.get $COLOR_POLICY_SOURCE_MIN))))
    (if (i32.and (call $color_policy_get (local.get $p) (global.get $COLOR_POLICY_MASTERING_PRESENT)) (i32.or (i32.eqz (call $color_finite (local.get $peak))) (f64.lt (local.get $peak) (f64.const 0))))
      (then (return (call $color_fail (i32.const 3) (global.get $COLOR_POLICY_SOURCE_MIN)))))
    (local.set $peak (f64.load (i32.add (local.get $p) (global.get $COLOR_POLICY_SOURCE_PEAK))))
    (if (i32.or (i32.eqz (call $color_finite (local.get $peak))) (f64.le (local.get $peak) (f64.const 0))) (then (return (call $color_fail (i32.const 3) (global.get $COLOR_POLICY_SOURCE_PEAK)))))
    (local.set $peak (f64.load (i32.add (local.get $p) (global.get $COLOR_POLICY_TARGET_PEAK))))
    (if (i32.or (i32.eqz (call $color_finite (local.get $peak))) (f64.le (local.get $peak) (f64.const 0))) (then (return (call $color_fail (i32.const 3) (global.get $COLOR_POLICY_TARGET_PEAK)))))
