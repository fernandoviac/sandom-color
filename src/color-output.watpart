    (i32.const 0))

  (func $color_validate_policy (export "color_validate_policy") (param $p i32) (param $capability i32) (result i32)
    (local $transfer i32) (local $range i32) (local $field i32) (local $peak f64)
    (if (i32.or (i32.and (local.get $p) (i32.const 7)) (i32.eqz (call $color_span (local.get $p) (global.get $COLOR_POLICY_SIZE))))
      (then (return (call $color_fail (i32.const 2) (i32.const 0)))))
    (if (i32.or (i32.and (local.get $capability) (i32.const 3)) (i32.eqz (call $color_span (local.get $capability) (global.get $COLOR_CAPABILITY_SIZE))))
      (then (return (call $color_fail (i32.const 2) (i32.const 1)))))
