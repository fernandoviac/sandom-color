      (if (i32.eq (local.get $transfer) (i32.const 5)) (then (local.set $x (call $rec2020_encode (local.get $x)))))
      (if (i32.eq (local.get $transfer) (i32.const 3)) (then (local.set $x (call $working_to_pq (local.get $x)))))
      (if (i32.eq (local.get $transfer) (i32.const 4)) (then (local.set $x (call $scene_to_hlg_signal (f64.div (local.get $x) (local.get $gain))))))
