    (if (i32.eqz (local.get $bit))
      (then (return (call $color_fail (i32.const 1) (global.get $COLOR_CAPABILITY_DEPTH_MASK)))))
    (local.set $at (i32.add (local.get $capability) (global.get $COLOR_CAPABILITY_DEPTH_MASK)))
    (i32.store (local.get $at) (i32.or (i32.load (local.get $at)) (local.get $bit)))
    (i32.const 0))

  ;; Adds the encoding $primaries / $transfer: bit primaries * 8 + transfer
  ;; of the low mask, or of the high mask from bit 32.
  (func (export "color_capability_accept_encoding") (param $capability i32) (param $primaries i32) (param $transfer i32) (result i32)
    (local $bit i32) (local $at i32)
    (if (i32.or (i32.gt_u (local.get $primaries) (i32.const 6)) (i32.gt_u (local.get $transfer) (i32.const 7)))
      (then (return (call $color_fail (i32.const 1) (global.get $COLOR_CAPABILITY_ENCODING_LOW)))))
    (local.set $bit (i32.add (i32.mul (local.get $primaries) (i32.const 8)) (local.get $transfer)))
    (local.set $at (i32.add (local.get $capability)
