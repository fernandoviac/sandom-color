            (if (i32.ne (local.get $transfer) (i32.const 1))
              (then (local.set $alpha (f64.min (f64.const 1) (f64.max (f64.const 0) (local.get $alpha))))))
            (local.set $factor (if (result f64) (i32.and (local.get $finiteAlpha) (i32.eq (local.get $destinationAlpha) (i32.const 2)))
              (then (local.get $alpha)) (else (f64.const 1))))
            (f32.store (local.get $out) (f32.demote_f64 (f64.mul (call $load0 (call $VEC)) (local.get $factor))))
            (f32.store offset=4 (local.get $out) (f32.demote_f64 (f64.mul (call $load1 (call $VEC)) (local.get $factor))))
            (f32.store offset=8 (local.get $out) (f32.demote_f64 (f64.mul (call $load2 (call $VEC)) (local.get $factor))))
            (f32.store offset=12 (local.get $out) (f32.demote_f64 (local.get $alpha)))))
        (local.set $in (i32.add (local.get $in) (i32.const 16))) (local.set $out (i32.add (local.get $out) (i32.const 16)))
        (local.set $x (i32.add (local.get $x) (i32.const 1))) (br_if $pixels (i32.lt_u (local.get $x) (local.get $width))))
      (local.set $row (i32.add (local.get $row) (i32.const 1))) (br_if $rows (i32.lt_u (local.get $row) (local.get $height))))
    (i32.const 0))
