        (f64.store (call $VEC) (f64.div (call $load0 (call $VEC)) (local.get $peak)))
        (f64.store offset=8 (call $VEC) (f64.div (call $load1 (call $VEC)) (local.get $peak)))
        (f64.store offset=16 (call $VEC) (f64.div (call $load2 (call $VEC)) (local.get $peak)))))
