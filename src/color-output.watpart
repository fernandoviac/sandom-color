      (then (return (call $color_fail (i32.const 1) (global.get $COLOR_POLICY_VERSION)))))
    (if (i32.gt_u (call $color_policy_get (local.get $p) (global.get $COLOR_POLICY_PRIMARIES)) (i32.const 6))
      (then (return (call $color_fail (i32.const 1) (global.get $COLOR_POLICY_PRIMARIES)))))
    (if (i32.gt_u (call $color_policy_get (local.get $p) (global.get $COLOR_POLICY_TRANSFER)) (i32.const 6))
      (then (return (call $color_fail (i32.const 1) (global.get $COLOR_POLICY_TRANSFER)))))
    (local.set $field (call $color_capability_field (local.get $p) (local.get $capability)))
    (if (i32.ge_s (local.get $field) (i32.const 0))
      (then (return (call $color_fail (i32.const 1) (local.get $field)))))
    (if (i32.gt_u (call $color_policy_get (local.get $p) (global.get $COLOR_POLICY_MASTERING_PRESENT)) (i32.const 1))
      (then (return (call $color_fail (i32.const 1) (global.get $COLOR_POLICY_MASTERING_PRESENT)))))
    (local.set $transfer (call $color_policy_get (local.get $p) (global.get $COLOR_POLICY_TRANSFER)))
    (local.set $range (call $color_policy_get (local.get $p) (global.get $COLOR_POLICY_RANGE)))
    (if (i32.or (i32.gt_u (local.get $range) (i32.const 2)) (i32.ne (call $color_policy_get (local.get $p) (global.get $COLOR_POLICY_GAMUT)) (i32.const 0)))
      (then (return (call $color_fail (i32.const 1) (global.get $COLOR_POLICY_RANGE)))))
    (if (i32.ne (i32.eq (local.get $range) (i32.const 1)) (i32.or (i32.eq (local.get $transfer) (i32.const 3)) (i32.eq (local.get $transfer) (i32.const 4))))
      (then (return (call $color_fail (i32.const 1) (global.get $COLOR_POLICY_TRANSFER)))))
