    (memory.fill (local.get $p) (i32.const 0) (global.get $COLOR_POLICY_SIZE))
    (i32.store (i32.add (local.get $p) (global.get $COLOR_POLICY_VERSION)) (global.get $COLOR_ABI_VERSION))
    (i32.store (i32.add (local.get $p) (global.get $COLOR_POLICY_TRANSFER)) (local.get $transfer))
    (i32.store (i32.add (local.get $p) (global.get $COLOR_POLICY_RANGE))
      (select (i32.const 1) (i32.const 0) (i32.or (i32.eq (local.get $transfer) (i32.const 3)) (i32.eq (local.get $transfer) (i32.const 4)))))
    (i32.store (i32.add (local.get $p) (global.get $COLOR_POLICY_TONE))
