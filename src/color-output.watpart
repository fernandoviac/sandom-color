      (i64.ne (i64.mul (i64.extend_i32_u (local.get $stride)) (i64.extend_i32_u (local.get $height))) (i64.extend_i32_u (local.get $length))))
      (then (return (call $color_fail (i32.const 2) (i32.const 4)))))
    (if (i32.eqz (call $color_span (local.get $src) (local.get $length)))
      (then (return (call $color_fail (i32.const 2) (i32.const 0)))))
