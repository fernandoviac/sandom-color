    (f64.store (i32.add (local.get $p) (global.get $COLOR_POLICY_SOURCE_PEAK)) (f64.const 203))
    (f64.store (i32.add (local.get $p) (global.get $COLOR_POLICY_TARGET_PEAK)) (f64.const 203))
    (f64.store (i32.add (local.get $p) (global.get $COLOR_POLICY_REFERENCE_WHITE)) (f64.const 203))
    (i32.store (i32.add (local.get $p) (global.get $COLOR_POLICY_WHITE)) (i32.const 1))
    (i32.const 0))

  ;; An empty capability for alpha mode $alpha with flags $flags: no depth
  ;; and no encoding yet.
  (func (export "color_capability_init") (param $capability i32) (param $alpha i32) (param $flags i32) (result i32)
    (if (i32.or (i32.and (local.get $capability) (i32.const 3))
          (i32.eqz (call $color_span (local.get $capability) (global.get $COLOR_CAPABILITY_SIZE))))
      (then (return (call $color_fail (i32.const 2) (i32.const 0)))))
    (if (i32.gt_u (local.get $alpha) (i32.const 2))
      (then (return (call $color_fail (i32.const 1) (global.get $COLOR_CAPABILITY_ALPHA)))))
    (memory.fill (local.get $capability) (i32.const 0) (global.get $COLOR_CAPABILITY_SIZE))
    (i32.store (i32.add (local.get $capability) (global.get $COLOR_CAPABILITY_VERSION)) (global.get $COLOR_ABI_VERSION))
    (i32.store (i32.add (local.get $capability) (global.get $COLOR_CAPABILITY_ALPHA)) (local.get $alpha))
    (i32.store (i32.add (local.get $capability) (global.get $COLOR_CAPABILITY_FLAGS)) (local.get $flags))
    (i32.const 0))

  ;; Adds depth code $depth (8, 10, 12, 16, color_depth_float16,
  ;; color_depth_float32) to the capability's depth mask.
  (func (export "color_capability_accept_depth") (param $capability i32) (param $depth i32) (result i32)
