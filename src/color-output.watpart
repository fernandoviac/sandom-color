    (if (i32.or (i32.eqz (call $color_finite (local.get $peak))) (f64.le (local.get $peak) (f64.const 0))) (then (return (call $color_fail (i32.const 3) (global.get $COLOR_POLICY_REFERENCE_WHITE)))))
    (if (i32.gt_u (call $color_policy_get (local.get $p) (global.get $COLOR_POLICY_WHITE)) (i32.const 1)) (then (return (call $color_fail (i32.const 1) (global.get $COLOR_POLICY_WHITE)))))
    (i32.const 0))

  (func $color_output_signal (param $primaries i32) (param $transfer i32)
    (local $peak f64) (local $gain f64) (local $y f64) (local $c i32) (local $x f64)
