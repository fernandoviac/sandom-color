            (local.set $finiteAlpha (call $color_finite (local.get $alpha)))
            (local.set $destinationAlpha (call $color_policy_get (local.get $policy) (global.get $COLOR_POLICY_ALPHA)))
            (local.set $c (i32.const 0))
            (loop $read
              (local.set $value (f64.promote_f32 (f32.load (i32.add (local.get $in) (local.get $c)))))
              (if (f64.eq (local.get $alpha) (f64.const 0)) (then (local.set $value (f64.const 0)))
                (else (if (i32.and (i32.eq (local.get $alphaMode) (i32.const 2))
                  (i32.and (i32.and (f64.gt (local.get $alpha) (f64.const 0)) (f64.ne (local.get $alpha) (f64.const 1)))
                    (i32.or (local.get $finiteAlpha) (i32.eq (local.get $destinationAlpha) (i32.const 1)))))
                  (then (local.set $value (f64.div (local.get $value) (local.get $alpha)))))))
              (f64.store (i32.add (call $VEC) (i32.mul (local.get $c) (i32.const 2))) (local.get $value))
              (local.set $c (i32.add (local.get $c) (i32.const 4))) (br_if $read (i32.lt_u (local.get $c) (i32.const 12))))
            (if (i32.eqz (i32.and (local.get $direct) (call $color_direct_srgb)))
              (then
                (if (i32.eqz (local.get $working))
                  (then (f64.store (call $VEC) (call $color_output_decode (call $load0 (call $VEC))))
                    (f64.store offset=8 (call $VEC) (call $color_output_decode (call $load1 (call $VEC))))
                    (f64.store offset=16 (call $VEC) (call $color_output_decode (call $load2 (call $VEC))))
                    (call $apply_matrix (i32.const 0)) (call $apply_matrix (i32.const 5))))
                (if (i32.and (i32.eqz (call $color_policy_get (local.get $policy) (global.get $COLOR_POLICY_TONE)))
                  (i32.and (i32.ne (local.get $transfer) (i32.const 1)) (f64.ne (local.get $sourcePeak) (local.get $targetPeak))))
                  (then (call $color_output_tone (local.get $sourcePeak) (local.get $targetPeak))))
