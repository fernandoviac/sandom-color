      (local.set $c (i32.add (local.get $c) (i32.const 8))) (br_if $channels (i32.lt_u (local.get $c) (i32.const 24)))))

  (func (export "color_transform_output") (param $src i32) (param $length i32)
    (param $width i32) (param $height i32) (param $stride i32)
    (param $working i32) (param $alphaMode i32) (param $policy i32)
    (param $capability i32) (param $dst i32) (param $capacity i32) (result i32)
    (local $status i32) (local $size i64) (local $row i32) (local $x i32)
    (local $in i32) (local $out i32) (local $c i32) (local $value f64)
    (local $alpha f64) (local $factor f64) (local $primaries i32) (local $transfer i32)
    (local $sourcePeak f64) (local $targetPeak f64) (local $direct i32) (local $bypass i32)
    (local $finiteAlpha i32) (local $destinationAlpha i32)
