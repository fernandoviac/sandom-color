    (if (i32.and (i32.lt_u (local.get $dst) (i32.add (local.get $policy) (global.get $COLOR_POLICY_SIZE)))
      (i32.lt_u (local.get $policy) (i32.add (local.get $dst) (local.get $capacity))))
      (then (return (call $color_fail (i32.const 2) (i32.const 8)))))
    (local.set $primaries (call $color_policy_get (local.get $policy) (global.get $COLOR_POLICY_PRIMARIES)))
    (local.set $transfer (call $color_policy_get (local.get $policy) (global.get $COLOR_POLICY_TRANSFER)))
    (local.set $sourcePeak (f64.load (i32.add (local.get $policy) (global.get $COLOR_POLICY_SOURCE_PEAK))))
    (local.set $targetPeak (f64.load (i32.add (local.get $policy) (global.get $COLOR_POLICY_TARGET_PEAK))))
    (local.set $bypass (i32.and (i32.eq (local.get $transfer) (i32.const 1))
      (i32.and (local.get $working) (i32.eq (local.get $alphaMode) (i32.const 2)))))
    (local.set $direct (i32.and (i32.eqz (local.get $working))
      (i32.and (i32.eqz (local.get $primaries)) (i32.and (i32.eqz (local.get $transfer))
