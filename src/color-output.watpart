    (if (local.get $status) (then (return (local.get $status))))
    (if (i32.or (i32.gt_u (local.get $working) (i32.const 1)) (i32.gt_u (local.get $alphaMode) (i32.const 2)))
      (then (return (call $color_fail (i32.const 1) (i32.const 5)))))
