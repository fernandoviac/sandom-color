      (local.set $x (i32.const 0))
      (local.set $in (i32.add (local.get $src) (i32.mul (local.get $row) (local.get $stride))))
      (loop $pixels
        (if (local.get $bypass)
          (then (memory.copy (local.get $out) (local.get $in) (i32.const 16)))
