      (then (return (call $color_fail (i32.const 2) (i32.const 0)))))
    (local.set $size (i64.mul (i64.mul (i64.extend_i32_u (local.get $width)) (i64.extend_i32_u (local.get $height))) (i64.const 16)))
    (if (i32.or (i32.or (i32.eqz (local.get $width)) (i32.eqz (local.get $height)))
