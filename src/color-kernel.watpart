;; Color conversion kernel (docs/specifications/color-and-image-data.md).
;;
;; The production scalar color kernel. Self-contained f64 transcendentals
;; (log2/exp2/pow/exp/log/cbrt via range reduction + series + Newton) keep
;; observable color arithmetic inside maintained WebAssembly.
;;
;; This file is a module component. Embeddable consumers compose it after
;; color-abi.watpart and provide their own $COLOR_BASE global; color.wat
;; supplies the same pair with $COLOR_BASE zero.
;;
;; Memory map relative to $COLOR_BASE (all f64, little-endian):
;;   0    .. 1151 : 16 conversion matrices, row-major 3x3, 72 bytes each.
;;                  Indices 0..9 are RGB/XYZ pairs, 10..11 are Bradford
;;                  adaptation, and 12..15 are the fixed Oklab transforms.
;;   1152 .. 1175 : D50 white point XYZ (x, y, z).
;;   2048 .. 2071 : VEC — the three-component in/out buffer.
;;   2112+        : internal scratch vectors.

  ;; Scratch offsets.
  (func $VEC (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2048)))
  (func $TMP (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2112)))
  (func $OKLAB (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2176)))
  (func $CUR (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2240)))
  (func $CAND (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2304)))
  (func $CLIP (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2368)))
  (func $CLIPOK (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2432)))

  ;; ------------------------------------------------------------------
  ;; Bounded uniform palettes and RGBA8 indexing.
  ;; ------------------------------------------------------------------

  (func $color_memory_span (param $ptr i32) (param $length i32) (result i32)
    (i64.le_u
      (i64.add (i64.extend_i32_u (local.get $ptr)) (i64.extend_i32_u (local.get $length)))
      (i64.shl (i64.extend_i32_u (memory.size)) (i64.const 16))))
  (func $color_memory_overlap
    (param $a i32) (param $aLength i32) (param $b i32) (param $bLength i32) (result i32)
    (i32.and
      (i32.ne (local.get $aLength) (i32.const 0))
      (i32.and
        (i32.ne (local.get $bLength) (i32.const 0))
        (i32.and
          (i64.lt_u
            (i64.extend_i32_u (local.get $a))
            (i64.add (i64.extend_i32_u (local.get $b)) (i64.extend_i32_u (local.get $bLength))))
          (i64.lt_u
            (i64.extend_i32_u (local.get $b))
            (i64.add (i64.extend_i32_u (local.get $a)) (i64.extend_i32_u (local.get $aLength))))))))

  ;; Validate the input fields and return the derived entry count. Zero is the
  ;; error sentinel; every valid cube contains at least eight entries.
  (func $color_palette_validate (param $record i32) (param $requireEntries i32) (result i32)
    (local $red i32) (local $green i32) (local $blue i32)
    (local $transparent i32) (local $entries i64)
    (if (i32.or (i32.and (local.get $record) (i32.const 3))
        (i32.eqz (call $color_memory_span (local.get $record) (global.get $COLOR_PALETTE_SIZE))))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_SPAN) (i32.const 0)))))
    (local.set $red
      (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_RED_LEVELS))))
    (local.set $green
      (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_GREEN_LEVELS))))
    (local.set $blue
      (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_BLUE_LEVELS))))
    (if (i32.lt_u (local.get $red) (i32.const 2))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_LEVELS) (global.get $COLOR_PALETTE_RED_LEVELS)))))
    (if (i32.lt_u (local.get $green) (i32.const 2))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_LEVELS) (global.get $COLOR_PALETTE_GREEN_LEVELS)))))
    (if (i32.lt_u (local.get $blue) (i32.const 2))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_LEVELS) (global.get $COLOR_PALETTE_BLUE_LEVELS)))))
    (local.set $transparent
      (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_TRANSPARENT))))
    (local.set $entries
      (i64.add
        (i64.mul
          (i64.mul (i64.extend_i32_u (local.get $red)) (i64.extend_i32_u (local.get $green)))
          (i64.extend_i32_u (local.get $blue)))
        (i64.extend_i32_u (i32.ne (local.get $transparent) (global.get $COLOR_PALETTE_TRANSPARENT_NONE)))))
    (if (i64.gt_u (local.get $entries) (i64.const 256))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_LEVELS) (global.get $COLOR_PALETTE_ENTRIES)))))
    (if (i32.and
        (i32.ne (local.get $transparent) (global.get $COLOR_PALETTE_TRANSPARENT_NONE))
        (i32.ge_u (local.get $transparent) (i32.wrap_i64 (local.get $entries))))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_RECORD) (global.get $COLOR_PALETTE_TRANSPARENT)))))
    (if (i32.and (local.get $requireEntries)
        (i32.ne
          (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_ENTRIES)))
          (i32.wrap_i64 (local.get $entries))))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_RECORD) (global.get $COLOR_PALETTE_ENTRIES)))))
    (i32.wrap_i64 (local.get $entries)))

  (func $color_palette_uniform (export "color_palette_uniform") (param $record i32) (param $palette i32) (param $capacity i32) (result i32)
    (local $entries i32) (local $needed i32) (local $transparent i32)
    (local $redLevels i32) (local $greenLevels i32) (local $blueLevels i32)
    (local $index i32) (local $ordinal i32) (local $red i32) (local $green i32) (local $blue i32)
    (local $base i32)
    (call $color_begin)
    (local.set $entries (call $color_palette_validate (local.get $record) (i32.const 0)))
    (if (i32.eqz (local.get $entries)) (then (return (i32.const 0))))
    (local.set $needed (i32.mul (local.get $entries) (i32.const 3)))
    (if (i32.lt_u (local.get $capacity) (local.get $needed))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_SPAN) (i32.const 2)))))
    (if (i32.eqz (call $color_memory_span (local.get $palette) (local.get $needed)))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_SPAN) (i32.const 1)))))
    (if (call $color_memory_overlap
        (local.get $record) (global.get $COLOR_PALETTE_SIZE)
        (local.get $palette) (local.get $needed))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_SPAN) (i32.const 1)))))
    (local.set $redLevels
      (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_RED_LEVELS))))
    (local.set $greenLevels
      (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_GREEN_LEVELS))))
    (local.set $blueLevels
      (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_BLUE_LEVELS))))
    (local.set $transparent
      (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_TRANSPARENT))))
    (block $done
      (loop $colors
        (br_if $done (i32.ge_u (local.get $index) (local.get $entries)))
        (local.set $base
          (i32.add (local.get $palette) (i32.mul (local.get $index) (i32.const 3))))
        (if (i32.eq (local.get $index) (local.get $transparent))
          (then
            (i32.store8 (local.get $base) (i32.const 0))
            (i32.store8 offset=1 (local.get $base) (i32.const 0))
            (i32.store8 offset=2 (local.get $base) (i32.const 0)))
          (else
            (local.set $ordinal
              (i32.sub (local.get $index)
                (i32.and
                  (i32.ne (local.get $transparent) (global.get $COLOR_PALETTE_TRANSPARENT_NONE))
                  (i32.gt_u (local.get $index) (local.get $transparent)))))
            (local.set $red
              (i32.div_u (local.get $ordinal)
                (i32.mul (local.get $greenLevels) (local.get $blueLevels))))
            (local.set $green
              (i32.div_u
                (i32.rem_u (local.get $ordinal)
                  (i32.mul (local.get $greenLevels) (local.get $blueLevels)))
                (local.get $blueLevels)))
            (local.set $blue (i32.rem_u (local.get $ordinal) (local.get $blueLevels)))
            (i32.store8 (local.get $base)
              (i32.div_u (i32.mul (local.get $red) (i32.const 255))
                (i32.sub (local.get $redLevels) (i32.const 1))))
            (i32.store8 offset=1 (local.get $base)
              (i32.div_u (i32.mul (local.get $green) (i32.const 255))
                (i32.sub (local.get $greenLevels) (i32.const 1))))
            (i32.store8 offset=2 (local.get $base)
              (i32.div_u (i32.mul (local.get $blue) (i32.const 255))
                (i32.sub (local.get $blueLevels) (i32.const 1))))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $colors)))
    (i32.store (i32.add (local.get $record) (global.get $COLOR_PALETTE_ENTRIES))
      (local.get $entries))
    (i32.const 1))

  (func $color_index_palette (export "color_index_palette")
    (param $record i32) (param $rgba i32) (param $rgbaLength i32)
    (param $threshold i32) (param $indices i32) (param $indexCapacity i32) (result i32)
    (local $entries i32) (local $pixels i32) (local $transparent i32)
    (local $redLevels i32) (local $greenLevels i32) (local $blueLevels i32)
    (local $pixel i32) (local $source i32) (local $red i32) (local $green i32) (local $blue i32)
    (local $ordinal i32) (local $index i32)
    (call $color_begin)
    (local.set $entries (call $color_palette_validate (local.get $record) (i32.const 1)))
    (if (i32.eqz (local.get $entries)) (then (return (i32.const 0))))
    (local.set $transparent
      (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_TRANSPARENT))))
    (if (i32.or
        (i32.and
          (i32.eq (local.get $transparent) (global.get $COLOR_PALETTE_TRANSPARENT_NONE))
          (i32.ne (local.get $threshold) (i32.const 0)))
        (i32.and
          (i32.ne (local.get $transparent) (global.get $COLOR_PALETTE_TRANSPARENT_NONE))
          (i32.gt_u (local.get $threshold) (i32.const 255))))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_THRESHOLD) (i32.const 3)))))
    (if (i32.and (local.get $rgbaLength) (i32.const 3))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_SPAN) (i32.const 2)))))
    (local.set $pixels (i32.shr_u (local.get $rgbaLength) (i32.const 2)))
    (if (i32.lt_u (local.get $indexCapacity) (local.get $pixels))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_SPAN) (i32.const 5)))))
    (if (i32.eqz (call $color_memory_span (local.get $rgba) (local.get $rgbaLength)))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_SPAN) (i32.const 1)))))
    (if (i32.eqz (call $color_memory_span (local.get $indices) (local.get $pixels)))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_SPAN) (i32.const 4)))))
    (if (call $color_memory_overlap
        (local.get $rgba) (local.get $rgbaLength)
        (local.get $indices) (local.get $pixels))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_SPAN) (i32.const 4)))))
    (if (call $color_memory_overlap
        (local.get $record) (global.get $COLOR_PALETTE_SIZE)
        (local.get $indices) (local.get $pixels))
      (then (return (call $color_reject (global.get $COLOR_ERROR_PALETTE_SPAN) (i32.const 4)))))
    (local.set $redLevels
      (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_RED_LEVELS))))
    (local.set $greenLevels
      (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_GREEN_LEVELS))))
    (local.set $blueLevels
      (i32.load (i32.add (local.get $record) (global.get $COLOR_PALETTE_BLUE_LEVELS))))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $pixel) (local.get $pixels)))
        (local.set $source (i32.add (local.get $rgba) (i32.shl (local.get $pixel) (i32.const 2))))
        (if (i32.and
            (i32.ne (local.get $transparent) (global.get $COLOR_PALETTE_TRANSPARENT_NONE))
            (i32.le_u (i32.load8_u offset=3 (local.get $source)) (local.get $threshold)))
          (then (local.set $index (local.get $transparent)))
          (else
            (local.set $red
              (i32.div_u
                (i32.add
                  (i32.mul (i32.load8_u (local.get $source))
                    (i32.sub (local.get $redLevels) (i32.const 1)))
                  (i32.const 127))
                (i32.const 255)))
            (local.set $green
              (i32.div_u
                (i32.add
                  (i32.mul (i32.load8_u offset=1 (local.get $source))
                    (i32.sub (local.get $greenLevels) (i32.const 1)))
                  (i32.const 127))
                (i32.const 255)))
            (local.set $blue
              (i32.div_u
                (i32.add
                  (i32.mul (i32.load8_u offset=2 (local.get $source))
                    (i32.sub (local.get $blueLevels) (i32.const 1)))
                  (i32.const 127))
                (i32.const 255)))
            (local.set $ordinal
              (i32.add
                (i32.mul (local.get $red)
                  (i32.mul (local.get $greenLevels) (local.get $blueLevels)))
                (i32.add
                  (i32.mul (local.get $green) (local.get $blueLevels))
                  (local.get $blue))))
            (local.set $index
              (i32.add (local.get $ordinal)
                (i32.and
                  (i32.ne (local.get $transparent) (global.get $COLOR_PALETTE_TRANSPARENT_NONE))
                  (i32.ge_u (local.get $ordinal) (local.get $transparent)))))))
        (i32.store8 (i32.add (local.get $indices) (local.get $pixel)) (local.get $index))
        (local.set $pixel (i32.add (local.get $pixel) (i32.const 1)))
        (br $next)))
    (i32.const 1))

  ;; ------------------------------------------------------------------
  ;; Transcendentals.
  ;; ------------------------------------------------------------------

  ;; log2(x) for x > 0. Exponent extraction, mantissa reduced to
  ;; [sqrt(2)/2, sqrt(2)), atanh series in s = (m-1)/(m+1).
  (func $log2 (param $x f64) (result f64)
    (local $bits i64)
    (local $exponent f64)
    (local $mantissa f64)
    (local $s f64)
    (local $s2 f64)
    (local $series f64)
    ;; Subnormal input: scale up by 2^54 and compensate.
    (if (f64.lt (local.get $x) (f64.const 2.2250738585072014e-308))
      (then
        (local.set $x (f64.mul (local.get $x) (f64.const 18014398509481984)))
        (local.set $exponent (f64.const -54)))
      (else
        (local.set $exponent (f64.const 0))))
    (local.set $bits (i64.reinterpret_f64 (local.get $x)))
    (local.set $exponent
      (f64.add (local.get $exponent)
        (f64.convert_i64_s
          (i64.sub
            (i64.and (i64.shr_u (local.get $bits) (i64.const 52)) (i64.const 0x7FF))
            (i64.const 1023)))))
    (local.set $mantissa
      (f64.reinterpret_i64
        (i64.or
          (i64.and (local.get $bits) (i64.const 0x000FFFFFFFFFFFFF))
          (i64.const 0x3FF0000000000000))))
    (if (f64.gt (local.get $mantissa) (f64.const 1.4142135623730951))
      (then
        (local.set $mantissa (f64.mul (local.get $mantissa) (f64.const 0.5)))
        (local.set $exponent (f64.add (local.get $exponent) (f64.const 1)))))
    (local.set $s
      (f64.div
        (f64.sub (local.get $mantissa) (f64.const 1))
        (f64.add (local.get $mantissa) (f64.const 1))))
    (local.set $s2 (f64.mul (local.get $s) (local.get $s)))
    ;; 1 + s2/3 + s2^2/5 + ... + s2^9/19 (Horner).
    (local.set $series (f64.div (f64.const 1) (f64.const 19)))
    (local.set $series (f64.add (f64.div (f64.const 1) (f64.const 17)) (f64.mul (local.get $series) (local.get $s2))))
    (local.set $series (f64.add (f64.div (f64.const 1) (f64.const 15)) (f64.mul (local.get $series) (local.get $s2))))
    (local.set $series (f64.add (f64.div (f64.const 1) (f64.const 13)) (f64.mul (local.get $series) (local.get $s2))))
    (local.set $series (f64.add (f64.div (f64.const 1) (f64.const 11)) (f64.mul (local.get $series) (local.get $s2))))
    (local.set $series (f64.add (f64.div (f64.const 1) (f64.const 9)) (f64.mul (local.get $series) (local.get $s2))))
    (local.set $series (f64.add (f64.div (f64.const 1) (f64.const 7)) (f64.mul (local.get $series) (local.get $s2))))
    (local.set $series (f64.add (f64.div (f64.const 1) (f64.const 5)) (f64.mul (local.get $series) (local.get $s2))))
    (local.set $series (f64.add (f64.div (f64.const 1) (f64.const 3)) (f64.mul (local.get $series) (local.get $s2))))
    (local.set $series (f64.add (f64.const 1) (f64.mul (local.get $series) (local.get $s2))))
    ;; log2(m) = 2 * s * series / ln(2).
    (f64.add
      (local.get $exponent)
      (f64.mul
        (f64.mul (f64.mul (f64.const 2) (local.get $s)) (local.get $series))
        (f64.const 1.4426950408889634))))

  ;; exp2(x). Integer/fraction split, exp Taylor on r*ln(2), exponent
  ;; reassembly through the bit pattern.
  (func $exp2 (param $x f64) (result f64)
    (local $n f64)
    (local $y f64)
    (local $sum f64)
    (local $k f64)
    (if (f64.le (local.get $x) (f64.const -1022))
      (then (return (f64.const 0))))
    (if (f64.ge (local.get $x) (f64.const 1024))
      (then (return (f64.mul (f64.const 1e308) (f64.const 10)))))
    (local.set $n (f64.nearest (local.get $x)))
    (local.set $y
      (f64.mul
        (f64.sub (local.get $x) (local.get $n))
        (f64.const 0.6931471805599453)))
    ;; exp(y), |y| <= 0.347: Horner over 1 + y(1 + y/2(1 + y/3(...)))
    (local.set $sum (f64.const 1))
    (local.set $k (f64.const 13))
    (block $done
      (loop $terms
        (local.set $sum
          (f64.add (f64.const 1)
            (f64.mul (local.get $sum) (f64.div (local.get $y) (local.get $k)))))
        (local.set $k (f64.sub (local.get $k) (f64.const 1)))
        (br_if $done (f64.lt (local.get $k) (f64.const 1)))
        (br $terms)))
    (f64.mul
      (local.get $sum)
      (f64.reinterpret_i64
        (i64.shl
          (i64.add (i64.trunc_f64_s (local.get $n)) (i64.const 1023))
          (i64.const 52)))))

  ;; pow(x, y) for x >= 0.
  (func $pow (param $x f64) (param $y f64) (result f64)
    (if (f64.le (local.get $x) (f64.const 0))
      (then (return (f64.const 0))))
    (call $exp2 (f64.mul (local.get $y) (call $log2 (local.get $x)))))

  (func $exp (param $x f64) (result f64)
    (call $exp2 (f64.mul (local.get $x) (f64.const 1.4426950408889634))))

  (func $log (param $x f64) (result f64)
    (f64.mul (call $log2 (local.get $x)) (f64.const 0.6931471805599453)))

  ;; cbrt(x), sign-mirrored. Seed from exp2(log2/3), two Newton rounds.
  (func $cbrt (param $x f64) (result f64)
    (local $sign f64)
    (local $magnitude f64)
    (local $t f64)
    (if (f64.eq (local.get $x) (f64.const 0))
      (then (return (f64.const 0))))
    (local.set $sign (f64.copysign (f64.const 1) (local.get $x)))
    (local.set $magnitude (f64.abs (local.get $x)))
    (local.set $t
      (call $exp2 (f64.div (call $log2 (local.get $magnitude)) (f64.const 3))))
    ;; Newton: t = (2t + m/t^2) / 3, twice.
    (local.set $t
      (f64.div
        (f64.add
          (f64.mul (f64.const 2) (local.get $t))
          (f64.div (local.get $magnitude) (f64.mul (local.get $t) (local.get $t))))
        (f64.const 3)))
    (local.set $t
      (f64.div
        (f64.add
          (f64.mul (f64.const 2) (local.get $t))
          (f64.div (local.get $magnitude) (f64.mul (local.get $t) (local.get $t))))
        (f64.const 3)))
    (f64.mul (local.get $sign) (local.get $t)))

  ;; ------------------------------------------------------------------
  ;; Transfer functions (CSS Color 4 point-symmetric extension).
  ;; ------------------------------------------------------------------

  (func $srgb_decode (export "srgb_decode") (param $value f64) (result f64)
    (local $sign f64)
    (local $magnitude f64)
    (local.set $sign (f64.copysign (f64.const 1) (local.get $value)))
    (local.set $magnitude (f64.abs (local.get $value)))
    (if (result f64) (f64.le (local.get $magnitude) (f64.const 0.04045))
      (then (f64.div (local.get $value) (f64.const 12.92)))
      (else
        (f64.mul (local.get $sign)
          (call $pow
            (f64.div (f64.add (local.get $magnitude) (f64.const 0.055)) (f64.const 1.055))
            (f64.const 2.4))))))

  (func $srgb_encode (export "srgb_encode") (param $value f64) (result f64)
    (local $sign f64)
    (local $magnitude f64)
    (local.set $sign (f64.copysign (f64.const 1) (local.get $value)))
    (local.set $magnitude (f64.abs (local.get $value)))
    (if (result f64) (f64.le (local.get $magnitude) (f64.const 0.0031308))
      (then (f64.mul (local.get $value) (f64.const 12.92)))
      (else
        (f64.mul (local.get $sign)
          (f64.sub
            (f64.mul (f64.const 1.055)
              (call $pow (local.get $magnitude) (f64.div (f64.const 1) (f64.const 2.4))))
            (f64.const 0.055))))))

  (func $gamma_decode (export "gamma_decode") (param $value f64) (param $exponent f64) (result f64)
    (f64.mul
      (f64.copysign (f64.const 1) (local.get $value))
      (call $pow (f64.abs (local.get $value)) (local.get $exponent))))

  (func $gamma_encode (export "gamma_encode") (param $value f64) (param $exponent f64) (result f64)
    (f64.mul
      (f64.copysign (f64.const 1) (local.get $value))
      (call $pow (f64.abs (local.get $value)) (f64.div (f64.const 1) (local.get $exponent)))))

  ;; Perceptual quantizer, Rec. ITU-R BT.2100. Constants as exact runtime
  ;; divisions so the kernel and the reference share one construction.
  (func $pq_signal_to_luminance (export "pq_signal_to_luminance") (param $signal f64) (result f64)
    (local $power f64)
    (local $numerator f64)
    (local.set $power
      (call $pow
        (f64.max (local.get $signal) (f64.const 0))
        (f64.div (f64.const 32) (f64.const 2523))))
    (local.set $numerator
      (f64.max (f64.sub (local.get $power) (f64.div (f64.const 107) (f64.const 128))) (f64.const 0)))
    (f64.mul (f64.const 10000)
      (call $pow
        (f64.div
          (local.get $numerator)
          (f64.sub
            (f64.div (f64.const 2413) (f64.const 128))
            (f64.mul (f64.div (f64.const 2392) (f64.const 128)) (local.get $power))))
        (f64.div (f64.const 8192) (f64.const 1305)))))

  (func $luminance_to_pq_signal (export "luminance_to_pq_signal") (param $luminance f64) (result f64)
    (local $power f64)
    (local.set $power
      (call $pow
        (f64.div (f64.max (local.get $luminance) (f64.const 0)) (f64.const 10000))
        (f64.div (f64.const 1305) (f64.const 8192))))
    (call $pow
      (f64.div
        (f64.add
          (f64.div (f64.const 107) (f64.const 128))
          (f64.mul (f64.div (f64.const 2413) (f64.const 128)) (local.get $power)))
        (f64.add (f64.const 1)
          (f64.mul (f64.div (f64.const 2392) (f64.const 128)) (local.get $power))))
      (f64.div (f64.const 2523) (f64.const 32))))

  (func $pq_to_working (export "pq_to_working") (param $signal f64) (result f64)
    (f64.div (call $pq_signal_to_luminance (local.get $signal)) (f64.const 203)))

  (func $working_to_pq (export "working_to_pq") (param $value f64) (result f64)
    (call $luminance_to_pq_signal (f64.mul (local.get $value) (f64.const 203))))

  ;; Hybrid log-gamma, Rec. ITU-R BT.2100.
  (func $hlg_b (result f64)
    (f64.sub (f64.const 1) (f64.mul (f64.const 4) (f64.const 0.17883277))))

  (func $hlg_c (result f64)
    (f64.sub (f64.const 0.5)
      (f64.mul (f64.const 0.17883277)
        (call $log (f64.mul (f64.const 4) (f64.const 0.17883277))))))

  (func $hlg_signal_to_scene (export "hlg_signal_to_scene") (param $signal f64) (result f64)
    (local $clamped f64)
    (local.set $clamped (f64.max (local.get $signal) (f64.const 0)))
    (if (result f64) (f64.le (local.get $clamped) (f64.const 0.5))
      (then (f64.div (f64.mul (local.get $clamped) (local.get $clamped)) (f64.const 3)))
      (else
        (f64.div
          (f64.add
            (call $exp
              (f64.div (f64.sub (local.get $clamped) (call $hlg_c)) (f64.const 0.17883277)))
            (call $hlg_b))
          (f64.const 12)))))

  (func $scene_to_hlg_signal (export "scene_to_hlg_signal") (param $sceneLight f64) (result f64)
    (local $clamped f64)
    (local.set $clamped (f64.max (local.get $sceneLight) (f64.const 0)))
    (if (result f64) (f64.le (local.get $clamped) (f64.div (f64.const 1) (f64.const 12)))
      (then (f64.sqrt (f64.mul (f64.const 3) (local.get $clamped))))
      (else
        (f64.add
          (f64.mul (f64.const 0.17883277)
            (call $log
              (f64.sub (f64.mul (f64.const 12) (local.get $clamped)) (call $hlg_b))))
          (call $hlg_c)))))

  ;; A CSS rec2100-hlg channel signal -> working scale (CSS Color HDR 1
  ;; § 8.2 and the hlg_decode sample of § 11.3): the BT.2100 inverse OETF of
  ;; the channel alone, scaled by 3.7743, which places media white at signal
  ;; 0.75 and the 18% reflectance grey card at 0.38. A CSS colour is
  ;; scene-referred, so no system gamma applies; an HLG image decodes through
  ;; $hlg_rgb_to_working instead. A negative channel keeps its sign, as the
  ;; encode does with spow.
  (func $css_hlg_signal_to_working (param $signal f64) (result f64)
    (f64.copysign
      (f64.mul (call $hlg_signal_to_scene (f64.abs (local.get $signal))) (f64.const 3.7743))
      (local.get $signal)))

  ;; ------------------------------------------------------------------
  ;; Vector helpers on memory offsets.
  ;; ------------------------------------------------------------------

  (func $load0 (param $offset i32) (result f64) (f64.load (local.get $offset)))
  (func $load1 (param $offset i32) (result f64) (f64.load (i32.add (local.get $offset) (i32.const 8))))
  (func $load2 (param $offset i32) (result f64) (f64.load (i32.add (local.get $offset) (i32.const 16))))

  (func $store_vec (param $offset i32) (param $v0 f64) (param $v1 f64) (param $v2 f64)
    (f64.store (local.get $offset) (local.get $v0))
    (f64.store (i32.add (local.get $offset) (i32.const 8)) (local.get $v1))
    (f64.store (i32.add (local.get $offset) (i32.const 16)) (local.get $v2)))

  (func $copy_vec (param $source i32) (param $destination i32)
    (call $store_vec (local.get $destination)
      (call $load0 (local.get $source))
      (call $load1 (local.get $source))
      (call $load2 (local.get $source))))

  ;; destination = matrix[index] * source. Reads all inputs before any
  ;; write, so source may equal destination.
  (func $apply (param $index i32) (param $source i32) (param $destination i32)
    (local $base i32)
    (local $v0 f64)
    (local $v1 f64)
    (local $v2 f64)
    (local $r0 f64)
    (local $r1 f64)
    (local $r2 f64)
    (local.set $base (i32.add (global.get $COLOR_BASE) (i32.mul (local.get $index) (i32.const 72))))
    (local.set $v0 (call $load0 (local.get $source)))
    (local.set $v1 (call $load1 (local.get $source)))
    (local.set $v2 (call $load2 (local.get $source)))
    (local.set $r0
      (f64.add
        (f64.add
          (f64.mul (f64.load (local.get $base)) (local.get $v0))
          (f64.mul (f64.load (i32.add (local.get $base) (i32.const 8))) (local.get $v1)))
        (f64.mul (f64.load (i32.add (local.get $base) (i32.const 16))) (local.get $v2))))
    (local.set $r1
      (f64.add
        (f64.add
          (f64.mul (f64.load (i32.add (local.get $base) (i32.const 24))) (local.get $v0))
          (f64.mul (f64.load (i32.add (local.get $base) (i32.const 32))) (local.get $v1)))
        (f64.mul (f64.load (i32.add (local.get $base) (i32.const 40))) (local.get $v2))))
    (local.set $r2
      (f64.add
        (f64.add
          (f64.mul (f64.load (i32.add (local.get $base) (i32.const 48))) (local.get $v0))
          (f64.mul (f64.load (i32.add (local.get $base) (i32.const 56))) (local.get $v1)))
        (f64.mul (f64.load (i32.add (local.get $base) (i32.const 64))) (local.get $v2))))
    (call $store_vec (local.get $destination) (local.get $r0) (local.get $r1) (local.get $r2)))

  (func $apply_matrix (export "apply_matrix") (param $index i32)
    (call $apply (local.get $index) (call $VEC) (call $VEC)))
  ;; Copy one WAT-owned 3x3 matrix to caller memory.
  (func (export "color_matrix_read") (param $index i32) (param $destination i32) (param $capacity i32) (result i32)
    (if (i32.or (i32.ge_u (local.get $index) (i32.const 16)) (i32.lt_u (local.get $capacity) (i32.const 72)))
      (then (return (i32.const 0))))
    (memory.copy (local.get $destination)
      (i32.add (global.get $COLOR_BASE) (i32.mul (local.get $index) (i32.const 72)))
      (i32.const 72))
    (i32.const 1))
  ;; Decode a tagged RGB value in VEC and convert it to linear Rec.2020.
  ;; Missing components become zero before transfer decoding. PQ and HLG are
  ;; defined on Rec.2020 and therefore enter the working space directly. A
  ;; tagged value is an authored colour, so HLG decodes as CSS rec2100-hlg.
  (func $color_convert_tagged_to_working (export "color_convert_tagged_to_working")
    (param $primaries i32) (param $transfer i32) (param $gamma f64)
    (param $missing i32) (result i32)
    (local $channel i32) (local $value f64)
    (if (i32.or
      (i32.or (i32.gt_u (local.get $primaries) (i32.const 6))
        (i32.gt_u (local.get $transfer) (i32.const 6)))
      (i32.or (i32.gt_u (local.get $missing) (i32.const 7))
        (i32.and (i32.eq (local.get $transfer) (i32.const 2))
          (i32.or (f64.ne (local.get $gamma) (local.get $gamma))
            (i32.or (f64.le (local.get $gamma) (f64.const 0))
              (f64.ge (local.get $gamma) (f64.const inf)))))))
      (then (return (i32.const 0))))
    (loop $components
      (if (i32.and (local.get $missing) (i32.shl (i32.const 1) (local.get $channel)))
        (then
          (f64.store
            (i32.add (call $VEC) (i32.mul (local.get $channel) (i32.const 8)))
            (f64.const 0))))
      (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
      (br_if $components (i32.lt_u (local.get $channel) (i32.const 3))))
    (if (i32.eq (local.get $transfer) (i32.const 4))
      (then
        (f64.store (call $VEC) (call $css_hlg_signal_to_working (call $load0 (call $VEC))))
        (f64.store offset=8 (call $VEC) (call $css_hlg_signal_to_working (call $load1 (call $VEC))))
        (f64.store offset=16 (call $VEC) (call $css_hlg_signal_to_working (call $load2 (call $VEC))))
        (return (i32.const 1))))
    (if (i32.eq (local.get $transfer) (i32.const 3))
      (then
        (f64.store (call $VEC) (call $pq_to_working (call $load0 (call $VEC))))
        (f64.store offset=8 (call $VEC) (call $pq_to_working (call $load1 (call $VEC))))
        (f64.store offset=16 (call $VEC) (call $pq_to_working (call $load2 (call $VEC))))
        (return (i32.const 1))))
    (local.set $channel (i32.const 0))
    (loop $decode
      (local.set $value
        (f64.load (i32.add (call $VEC) (i32.mul (local.get $channel) (i32.const 8)))))
      (if (i32.eqz (local.get $transfer))
        (then (local.set $value (call $srgb_decode (local.get $value)))))
      (if (i32.eq (local.get $transfer) (i32.const 2))
        (then (local.set $value (call $gamma_decode (local.get $value) (local.get $gamma)))))
      (if (i32.eq (local.get $transfer) (i32.const 5))
        (then (local.set $value (call $rec2020_decode (local.get $value)))))
      (if (i32.eq (local.get $transfer) (i32.const 6))
        (then (local.set $value (call $prophoto_decode (local.get $value)))))
      (f64.store
        (i32.add (call $VEC) (i32.mul (local.get $channel) (i32.const 8)))
        (local.get $value))
      (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
      (br_if $decode (i32.lt_u (local.get $channel) (i32.const 3))))
    (if (i32.ne (local.get $primaries) (i32.const 2))
      (then
        (if (i32.lt_u (local.get $primaries) (i32.const 5))
          (then (call $apply_matrix (i32.mul (local.get $primaries) (i32.const 2)))))
        (if (i32.or (i32.eq (local.get $primaries) (i32.const 4))
          (i32.eq (local.get $primaries) (i32.const 5)))
          (then (call $apply_matrix (i32.const 10))))
        (call $apply_matrix (i32.const 5))))
    (i32.const 1))

  ;; The only accepted working encodings are extended encoded sRGB and linear
  ;; Rec.2020. Returning -1 rejects every other primaries/transfer pair.
  (func (export "color_working_code")
    (param $primaries i32) (param $transfer i32) (result i32)
    (if (result i32)
      (i32.and (i32.eqz (local.get $primaries)) (i32.eqz (local.get $transfer)))
      (then (i32.const 0))
      (else
        (if (result i32)
          (i32.and (i32.eq (local.get $primaries) (i32.const 2))
            (i32.eq (local.get $transfer) (i32.const 1)))
          (then (i32.const 1))
          (else (i32.const -1))))))

  ;; Primaries routing. A primaries code below 5 has its own matrices: index
  ;; 2 * primaries goes from linear RGB to XYZ at the set's own white point,
  ;; index 2 * primaries + 1 back. ProPhoto RGB and XYZ D50 are D50 sets;
  ;; a D50 source adapts to D65 (Bradford, index 10) and a D50 destination
  ;; from D65 (index 11). The XYZ sets have no RGB matrix.
  (func $primaries_is_d50 (param $primaries i32) (result i32)
    (i32.or (i32.eq (local.get $primaries) (i32.const 4)) (i32.eq (local.get $primaries) (i32.const 5))))

  ;; The vector at $vector from linear $source into XYZ D65.
  (func $primaries_to_xyz_d65 (param $source i32) (param $vector i32)
    (if (i32.lt_u (local.get $source) (i32.const 5))
      (then (call $apply (i32.mul (local.get $source) (i32.const 2)) (local.get $vector) (local.get $vector))))
    (if (call $primaries_is_d50 (local.get $source))
      (then (call $apply (i32.const 10) (local.get $vector) (local.get $vector)))))

  ;; The vector at $vector from XYZ D65 into linear $destination (below 5).
  (func $primaries_from_xyz_d65 (param $destination i32) (param $vector i32)
    (if (i32.eq (local.get $destination) (i32.const 4))
      (then (call $apply (i32.const 11) (local.get $vector) (local.get $vector))))
    (call $apply (i32.add (i32.mul (local.get $destination) (i32.const 2)) (i32.const 1))
      (local.get $vector) (local.get $vector)))

  ;; VEC, linear RGB in $primaries (or XYZ), into linear Rec.2020: unchanged
  ;; for Rec.2020. 0 for an unknown primaries code.
  (func (export "color_linear_to_working") (param $primaries i32) (result i32)
    (if (i32.gt_u (local.get $primaries) (i32.const 6)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $primaries) (i32.const 2)) (then (return (i32.const 1))))
    (call $primaries_to_xyz_d65 (local.get $primaries) (call $VEC))
    (call $apply (i32.const 5) (call $VEC) (call $VEC))
    (i32.const 1))

  ;; VEC, linear Rec.2020, into linear RGB in $primaries without a gamut
  ;; map: unchanged for Rec.2020. 0 for primaries without an RGB matrix.
  (func (export "color_working_to_linear") (param $primaries i32) (result i32)
    (if (i32.gt_u (local.get $primaries) (i32.const 4)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $primaries) (i32.const 2)) (then (return (i32.const 1))))
    (call $apply (i32.const 4) (call $VEC) (call $VEC))
    (call $primaries_from_xyz_d65 (local.get $primaries) (call $VEC))
    (i32.const 1))

  ;; The 3 by 3 matrix, by rows (72 bytes at $out), from linear RGB in
  ;; $source (or XYZ) into linear RGB in $destination, for GPU uniforms.
  ;; Each basis vector goes through the kernel matrices: the source to XYZ,
  ;; a D50 source adapted to D65, a D50 destination adapted to D50, then
  ;; XYZ to the destination. Equal primaries give the identity. 0 for an
  ;; unknown source, a destination without an RGB matrix, or less than 72
  ;; bytes of capacity. Uses VEC as scratch.
  (func $color_primaries_matrix (export "color_primaries_matrix") (param $source i32) (param $destination i32)
    (param $out i32) (param $capacity i32) (result i32)
    (local $column i32)
    (if (i32.or (i32.or (i32.gt_u (local.get $source) (i32.const 6)) (i32.gt_u (local.get $destination) (i32.const 4)))
        (i32.lt_u (local.get $capacity) (i32.const 72)))
      (then (return (i32.const 0))))
    (loop $columns
      (call $store_vec (call $VEC)
        (select (f64.const 1) (f64.const 0) (i32.eqz (local.get $column)))
        (select (f64.const 1) (f64.const 0) (i32.eq (local.get $column) (i32.const 1)))
        (select (f64.const 1) (f64.const 0) (i32.eq (local.get $column) (i32.const 2))))
      (if (i32.ne (local.get $source) (local.get $destination))
        (then
          (call $primaries_to_xyz_d65 (local.get $source) (call $VEC))
          (call $primaries_from_xyz_d65 (local.get $destination) (call $VEC))))
      (f64.store (i32.add (local.get $out) (i32.shl (local.get $column) (i32.const 3))) (call $load0 (call $VEC)))
      (f64.store offset=24 (i32.add (local.get $out) (i32.shl (local.get $column) (i32.const 3))) (call $load1 (call $VEC)))
      (f64.store offset=48 (i32.add (local.get $out) (i32.shl (local.get $column) (i32.const 3))) (call $load2 (call $VEC)))
      (local.set $column (i32.add (local.get $column) (i32.const 1)))
      (br_if $columns (i32.lt_u (local.get $column) (i32.const 3))))
    (i32.const 1))

  ;; VEC, linear RGB in $primaries, into XYZ at the set's own white point,
  ;; and back. 0 for primaries without an RGB matrix.
  (func (export "color_linear_to_xyz") (param $primaries i32) (result i32)
    (if (i32.gt_u (local.get $primaries) (i32.const 4)) (then (return (i32.const 0))))
    (call $apply (i32.mul (local.get $primaries) (i32.const 2)) (call $VEC) (call $VEC))
    (i32.const 1))
  (func (export "color_xyz_to_linear") (param $primaries i32) (result i32)
    (if (i32.gt_u (local.get $primaries) (i32.const 4)) (then (return (i32.const 0))))
    (call $apply (i32.add (i32.mul (local.get $primaries) (i32.const 2)) (i32.const 1)) (call $VEC) (call $VEC))
    (i32.const 1))

  ;; gamut_map_css_color_4 of VEC into linear RGB in $primaries. 0 for
  ;; primaries without an RGB matrix.
  (func (export "color_gamut_map_css_color_4") (param $primaries i32) (result i32)
    (if (i32.gt_u (local.get $primaries) (i32.const 4)) (then (return (i32.const 0))))
    (call $gamut_map_css_color_4
      (i32.add (i32.mul (local.get $primaries) (i32.const 2)) (i32.const 1))
      (i32.mul (local.get $primaries) (i32.const 2))
      (i32.eq (local.get $primaries) (i32.const 4)))
    (i32.const 1))

  ;; Tagged input in VEC to the standard working encoding. The direct sRGB
  ;; route preserves authored finite values bit for bit.
  (func $color_convert_tagged_to_standard (export "color_convert_tagged_to_standard")
    (param $primaries i32) (param $transfer i32) (param $gamma f64)
    (param $missing i32) (result i32)
    (if (i32.and (i32.eqz (local.get $primaries)) (i32.eqz (local.get $transfer)))
      (then
        (if (i32.gt_u (local.get $missing) (i32.const 7))
          (then (return (i32.const 0))))
        (if (i32.and (local.get $missing) (i32.const 1))
          (then (f64.store (call $VEC) (f64.const 0))))
        (if (i32.and (local.get $missing) (i32.const 2))
          (then (f64.store offset=8 (call $VEC) (f64.const 0))))
        (if (i32.and (local.get $missing) (i32.const 4))
          (then (f64.store offset=16 (call $VEC) (f64.const 0))))
        (return (i32.const 1))))
    (if (i32.eqz
      (call $color_convert_tagged_to_working
        (local.get $primaries) (local.get $transfer) (local.get $gamma)
        (local.get $missing)))
      (then (return (i32.const 0))))
    (call $apply_matrix (i32.const 4))
    (call $apply_matrix (i32.const 1))
    (f64.store (call $VEC) (call $srgb_encode (call $load0 (call $VEC))))
    (f64.store offset=8 (call $VEC) (call $srgb_encode (call $load1 (call $VEC))))
    (f64.store offset=16 (call $VEC) (call $srgb_encode (call $load2 (call $VEC))))
    (i32.const 1))

  ;; XYZ D65 -> OKLab at offsets (matrix 12, cbrt, matrix 14).
  (func $xyz_to_oklab_at (param $source i32) (param $destination i32)
    (call $apply (i32.const 12) (local.get $source) (local.get $destination))
    (call $store_vec (local.get $destination)
      (call $cbrt (call $load0 (local.get $destination)))
      (call $cbrt (call $load1 (local.get $destination)))
      (call $cbrt (call $load2 (local.get $destination))))
    (call $apply (i32.const 14) (local.get $destination) (local.get $destination)))

  ;; OKLab -> XYZ D65 at offsets (matrix 15, cube, matrix 13).
  (func $oklab_to_xyz_at (param $source i32) (param $destination i32)
    (local $v0 f64)
    (local $v1 f64)
    (local $v2 f64)
    (call $apply (i32.const 15) (local.get $source) (local.get $destination))
    (local.set $v0 (call $load0 (local.get $destination)))
    (local.set $v1 (call $load1 (local.get $destination)))
    (local.set $v2 (call $load2 (local.get $destination)))
    (call $store_vec (local.get $destination)
      (f64.mul (f64.mul (local.get $v0) (local.get $v0)) (local.get $v0))
      (f64.mul (f64.mul (local.get $v1) (local.get $v1)) (local.get $v1))
      (f64.mul (f64.mul (local.get $v2) (local.get $v2)) (local.get $v2)))
    (call $apply (i32.const 13) (local.get $destination) (local.get $destination)))

  (func $xyz_d65_to_oklab (export "xyz_d65_to_oklab")
    (call $xyz_to_oklab_at (call $VEC) (call $VEC)))

  (func $oklab_to_xyz_d65 (export "oklab_to_xyz_d65")
    (call $oklab_to_xyz_at (call $VEC) (call $VEC)))

  ;; Lab (D50 anchored). Epsilon 216/24389 and kappa 24389/27 as runtime
  ;; divisions.
  (func $lab_f_inverse (param $f f64) (result f64)
    (local $cubed f64)
    (local.set $cubed (f64.mul (f64.mul (local.get $f) (local.get $f)) (local.get $f)))
    (if (result f64) (f64.gt (local.get $cubed) (f64.div (f64.const 216) (f64.const 24389)))
      (then (local.get $cubed))
      (else
        (f64.div
          (f64.sub (f64.mul (f64.const 116) (local.get $f)) (f64.const 16))
          (f64.div (f64.const 24389) (f64.const 27))))))

  (func $lab_f (param $t f64) (result f64)
    (if (result f64) (f64.gt (local.get $t) (f64.div (f64.const 216) (f64.const 24389)))
      (then (call $cbrt (local.get $t)))
      (else
        (f64.div
          (f64.add
            (f64.mul (f64.div (f64.const 24389) (f64.const 27)) (local.get $t))
            (f64.const 16))
          (f64.const 116)))))

  (func $lab_to_xyz_d50 (export "lab_to_xyz_d50")
    (local $lightness f64)
    (local $fy f64)
    (local $y f64)
    (local.set $lightness (call $load0 (call $VEC)))
    (local.set $fy (f64.div (f64.add (local.get $lightness) (f64.const 16)) (f64.const 116)))
    (if (f64.gt (local.get $lightness)
          (f64.mul (f64.div (f64.const 24389) (f64.const 27)) (f64.div (f64.const 216) (f64.const 24389))))
      (then
        (local.set $y (f64.mul (f64.mul (local.get $fy) (local.get $fy)) (local.get $fy))))
      (else
        (local.set $y (f64.div (local.get $lightness) (f64.div (f64.const 24389) (f64.const 27))))))
    (call $store_vec (call $VEC)
      (f64.mul
        (call $lab_f_inverse
          (f64.add (local.get $fy) (f64.div (call $load1 (call $VEC)) (f64.const 500))))
        (f64.load (i32.add (global.get $COLOR_BASE) (i32.const 1152))))
      (local.get $y)
      (f64.mul
        (call $lab_f_inverse
          (f64.sub (local.get $fy) (f64.div (call $load2 (call $VEC)) (f64.const 200))))
        (f64.load (i32.add (global.get $COLOR_BASE) (i32.const 1168))))))

  (func $xyz_d50_to_lab (export "xyz_d50_to_lab")
    (local $fx f64)
    (local $fy f64)
    (local $fz f64)
    (local.set $fx (call $lab_f (f64.div (call $load0 (call $VEC)) (f64.load (i32.add (global.get $COLOR_BASE) (i32.const 1152))))))
    (local.set $fy (call $lab_f (f64.div (call $load1 (call $VEC)) (f64.load (i32.add (global.get $COLOR_BASE) (i32.const 1160))))))
    (local.set $fz (call $lab_f (f64.div (call $load2 (call $VEC)) (f64.load (i32.add (global.get $COLOR_BASE) (i32.const 1168))))))
    (call $store_vec (call $VEC)
      (f64.sub (f64.mul (f64.const 116) (local.get $fy)) (f64.const 16))
      (f64.mul (f64.const 500) (f64.sub (local.get $fx) (local.get $fy)))
      (f64.mul (f64.const 200) (f64.sub (local.get $fy) (local.get $fz)))))

  ;; HLG RGB signal -> working scale (opto-optical transform, 1000-candela
  ;; reference display, system gamma 1.2, 203-candela reference white).
  (func $hlg_rgb_to_working (export "hlg_rgb_to_working")
    (local $scene0 f64)
    (local $scene1 f64)
    (local $scene2 f64)
    (local $luminance f64)
    (local $gain f64)
    (local.set $scene0 (call $hlg_signal_to_scene (call $load0 (call $VEC))))
    (local.set $scene1 (call $hlg_signal_to_scene (call $load1 (call $VEC))))
    (local.set $scene2 (call $hlg_signal_to_scene (call $load2 (call $VEC))))
    (local.set $luminance
      (f64.add
        (f64.add
          (f64.mul (f64.const 0.2627) (local.get $scene0))
          (f64.mul (f64.const 0.678) (local.get $scene1)))
        (f64.mul (f64.const 0.0593) (local.get $scene2))))
    (if (f64.le (local.get $luminance) (f64.const 0))
      (then (local.set $gain (f64.const 0)))
      (else
        (local.set $gain
          (f64.div
            (f64.mul (f64.const 1000)
              (call $pow (local.get $luminance) (f64.sub (f64.const 1.2) (f64.const 1))))
            (f64.const 203)))))
    (call $store_vec (call $VEC)
      (f64.mul (local.get $scene0) (local.get $gain))
      (f64.mul (local.get $scene1) (local.get $gain))
      (f64.mul (local.get $scene2) (local.get $gain))))

  ;; ------------------------------------------------------------------
  ;; Tone map: Rec. ITU-R BT.2390 EETF on the largest channel in the PQ
  ;; domain, one gain for all three channels. Working scale in VEC.
  ;; ------------------------------------------------------------------
  (func $tone_map_bt2390 (export "tone_map_bt2390")
    (param $sourcePeakLuminance f64) (param $targetPeakLuminance f64)
    (local $sourcePeakSignal f64)
    (local $maxChannel f64)
    (local $normalized f64)
    (local $maxNormalized f64)
    (local $kneeStart f64)
    (local $t f64)
    (local $t2 f64)
    (local $t3 f64)
    (local $mapped f64)
    (local $gain f64)
    (local.set $sourcePeakSignal (call $luminance_to_pq_signal (local.get $sourcePeakLuminance)))
    (local.set $maxChannel
      (f64.max
        (f64.max (call $load0 (call $VEC)) (call $load1 (call $VEC)))
        (call $load2 (call $VEC))))
    (if (f64.le (local.get $maxChannel) (f64.const 0))
      (then
        (call $store_vec (call $VEC) (f64.const 0) (f64.const 0) (f64.const 0))
        (return)))
    (local.set $normalized
      (f64.div
        (call $luminance_to_pq_signal (f64.mul (local.get $maxChannel) (f64.const 203)))
        (local.get $sourcePeakSignal)))
    (local.set $maxNormalized
      (f64.div
        (call $luminance_to_pq_signal (local.get $targetPeakLuminance))
        (local.get $sourcePeakSignal)))
    (local.set $kneeStart
      (f64.sub (f64.mul (f64.const 1.5) (local.get $maxNormalized)) (f64.const 0.5)))
    (if (f64.lt (local.get $normalized) (local.get $kneeStart))
      (then (local.set $mapped (local.get $normalized)))
      (else
        (local.set $t
          (f64.div
            (f64.sub (local.get $normalized) (local.get $kneeStart))
            (f64.sub (f64.const 1) (local.get $kneeStart))))
        (local.set $t2 (f64.mul (local.get $t) (local.get $t)))
        (local.set $t3 (f64.mul (local.get $t2) (local.get $t)))
        (local.set $mapped
          (f64.add
            (f64.add
              (f64.mul
                (f64.add
                  (f64.sub (f64.mul (f64.const 2) (local.get $t3))
                    (f64.mul (f64.const 3) (local.get $t2)))
                  (f64.const 1))
                (local.get $kneeStart))
              (f64.mul
                (f64.add
                  (f64.sub (local.get $t3) (f64.mul (f64.const 2) (local.get $t2)))
                  (local.get $t))
                (f64.sub (f64.const 1) (local.get $kneeStart))))
            (f64.mul
              (f64.add
                (f64.mul (f64.const -2) (local.get $t3))
                (f64.mul (f64.const 3) (local.get $t2)))
              (local.get $maxNormalized))))))
    (local.set $gain
      (f64.div
        (f64.div
          (call $pq_signal_to_luminance
            (f64.mul (local.get $mapped) (local.get $sourcePeakSignal)))
          (f64.const 203))
        (local.get $maxChannel)))
    (call $store_vec (call $VEC)
      (f64.mul (call $load0 (call $VEC)) (local.get $gain))
      (f64.mul (call $load1 (call $VEC)) (local.get $gain))
      (f64.mul (call $load2 (call $VEC)) (local.get $gain))))

  ;; ------------------------------------------------------------------
  ;; Gamut map: CSS Color 4, 14.2.2 "Binary Search Gamut Map with Local
  ;; MINDE". VEC holds working RGB in, destination linear RGB out. Chroma
  ;; scales through the rectangular a/b components, so no trigonometry is
  ;; needed.
  ;; ------------------------------------------------------------------

  (func $in_gamut (param $offset i32) (result i32)
    (local $v f64)
    (local.set $v (call $load0 (local.get $offset)))
    (if (i32.or (f64.lt (local.get $v) (f64.const 0)) (f64.gt (local.get $v) (f64.const 1)))
      (then (return (i32.const 0))))
    (local.set $v (call $load1 (local.get $offset)))
    (if (i32.or (f64.lt (local.get $v) (f64.const 0)) (f64.gt (local.get $v) (f64.const 1)))
      (then (return (i32.const 0))))
    (local.set $v (call $load2 (local.get $offset)))
    (if (i32.or (f64.lt (local.get $v) (f64.const 0)) (f64.gt (local.get $v) (f64.const 1)))
      (then (return (i32.const 0))))
    (i32.const 1))

  (func $clip01 (param $source i32) (param $destination i32)
    (call $store_vec (local.get $destination)
      (f64.min (f64.max (call $load0 (local.get $source)) (f64.const 0)) (f64.const 1))
      (f64.min (f64.max (call $load1 (local.get $source)) (f64.const 0)) (f64.const 1))
      (f64.min (f64.max (call $load2 (local.get $source)) (f64.const 0)) (f64.const 1))))

  ;; deltaEOK between the clip of destination linear RGB $source, which
  ;; goes to CLIP, and the OKLab color at $oklab.
  (func $gamut_clip_delta (param $source i32) (param $oklab i32)
    (param $destToXyz i32) (param $destIsD50 i32) (result f64)
    (local $d0 f64) (local $d1 f64) (local $d2 f64)
    (call $clip01 (local.get $source) (call $CLIP))
    (call $apply (local.get $destToXyz) (call $CLIP) (call $CLIPOK))
    (if (local.get $destIsD50)
      (then (call $apply (i32.const 10) (call $CLIPOK) (call $CLIPOK))))
    (call $xyz_to_oklab_at (call $CLIPOK) (call $CLIPOK))
    (local.set $d0 (f64.sub (call $load0 (call $CLIPOK)) (call $load0 (local.get $oklab))))
    (local.set $d1 (f64.sub (call $load1 (call $CLIPOK)) (call $load1 (local.get $oklab))))
    (local.set $d2 (f64.sub (call $load2 (call $CLIPOK)) (call $load2 (local.get $oklab))))
    (f64.sqrt
      (f64.add
        (f64.add (f64.mul (local.get $d0) (local.get $d0)) (f64.mul (local.get $d1) (local.get $d1)))
        (f64.mul (local.get $d2) (local.get $d2)))))

  ;; OKLab at $source -> destination linear RGB at $destination.
  (func $oklab_to_dest (param $source i32) (param $destination i32)
    (param $xyzToDest i32) (param $destIsD50 i32)
    (call $oklab_to_xyz_at (local.get $source) (local.get $destination))
    (if (local.get $destIsD50)
      (then (call $apply (i32.const 11) (local.get $destination) (local.get $destination))))
    (call $apply (local.get $xyzToDest) (local.get $destination) (local.get $destination)))

  (func $gamut_map_css_color_4 (export "gamut_map_css_color_4")
    (param $xyzToDest i32) (param $destToXyz i32) (param $destIsD50 i32)
    (local $lightness f64)
    (local $a0 f64)
    (local $b0 f64)
    (local $chroma f64)
    (local $lowChroma f64)
    (local $highChroma f64)
    (local $midChroma f64)
    (local $scale f64)
    (local $delta f64)
    (local $lowInGamut i32)
    ;; Working RGB is Rec.2020: preserve identity at the gamut boundary.
    ;; A matrix round trip can push an exact 1 above 1 and spuriously map it.
    ;; Ordered bounds leave NaNs on the established propagation path.
    (if (i32.and
          (i32.and (i32.eq (local.get $xyzToDest) (i32.const 5))
                   (i32.eq (local.get $destToXyz) (i32.const 4)))
          (i32.eqz (local.get $destIsD50)))
      (then
        (if (i32.and
              (i32.and
                (f64.ge (call $load0 (call $VEC)) (f64.const 0))
                (f64.le (call $load0 (call $VEC)) (f64.const 1)))
              (i32.and
                (i32.and
                  (f64.ge (call $load1 (call $VEC)) (f64.const 0))
                  (f64.le (call $load1 (call $VEC)) (f64.const 1)))
                (i32.and
                  (f64.ge (call $load2 (call $VEC)) (f64.const 0))
                  (f64.le (call $load2 (call $VEC)) (f64.const 1)))))
          (then (return)))))
    ;; Direct conversion first: working -> XYZ -> (D50) -> destination.
    (call $apply (i32.const 4) (call $VEC) (call $TMP))
    (if (local.get $destIsD50)
      (then (call $apply (i32.const 11) (call $TMP) (call $TMP))))
    (call $apply (local.get $xyzToDest) (call $TMP) (call $CAND))
    (if (call $in_gamut (call $CAND))
      (then
        (call $copy_vec (call $CAND) (call $VEC))
        (return)))
    ;; OKLab of the working color.
    (call $apply (i32.const 4) (call $VEC) (call $TMP))
    (call $xyz_to_oklab_at (call $TMP) (call $OKLAB))
    (local.set $lightness (call $load0 (call $OKLAB)))
    (local.set $a0 (call $load1 (call $OKLAB)))
    (local.set $b0 (call $load2 (call $OKLAB)))
    (if (f64.ge (local.get $lightness) (f64.const 1))
      (then
        (call $store_vec (call $VEC) (f64.const 1) (f64.const 1) (f64.const 1))
        (return)))
    (if (f64.le (local.get $lightness) (f64.const 0))
      (then
        (call $store_vec (call $VEC) (f64.const 0) (f64.const 0) (f64.const 0))
        (return)))
    (local.set $chroma
      (f64.sqrt
        (f64.add
          (f64.mul (local.get $a0) (local.get $a0))
          (f64.mul (local.get $b0) (local.get $b0)))))
    ;; Steps 11-14: the clipped color, when it is within one just
    ;; noticeable difference (deltaEOK 0.02) of the color.
    (call $copy_vec (call $OKLAB) (call $CUR))
    (call $oklab_to_dest (call $CUR) (call $CAND)
      (local.get $xyzToDest) (local.get $destIsD50))
    (if (f64.lt
          (call $gamut_clip_delta (call $CAND) (call $CUR) (local.get $destToXyz) (local.get $destIsD50))
          (f64.const 0.02))
      (then
        (call $copy_vec (call $CLIP) (call $VEC))
        (return)))
    ;; Steps 15-19: binary search of the chroma, epsilon 0.0001. Once a
    ;; clipped candidate is within the difference, the low end is no
    ;; longer known to be in gamut.
    (local.set $lowChroma (f64.const 0))
    (local.set $highChroma (local.get $chroma))
    (local.set $lowInGamut (i32.const 1))
    (block $done
      (loop $search
        (br_if $done
          (i32.eqz (f64.gt (f64.sub (local.get $highChroma) (local.get $lowChroma)) (f64.const 0.0001))))
        (local.set $midChroma
          (f64.mul (f64.add (local.get $lowChroma) (local.get $highChroma)) (f64.const 0.5)))
        (local.set $scale (f64.div (local.get $midChroma) (local.get $chroma)))
        (call $store_vec (call $CUR)
          (local.get $lightness)
          (f64.mul (local.get $a0) (local.get $scale))
          (f64.mul (local.get $b0) (local.get $scale)))
        (call $oklab_to_dest (call $CUR) (call $CAND)
          (local.get $xyzToDest) (local.get $destIsD50))
        (if (i32.and (local.get $lowInGamut) (call $in_gamut (call $CAND)))
          (then
            (local.set $lowChroma (local.get $midChroma))
            (br $search)))
        (local.set $delta
          (call $gamut_clip_delta (call $CAND) (call $CUR) (local.get $destToXyz) (local.get $destIsD50)))
        (if (f64.lt (local.get $delta) (f64.const 0.02))
          (then
            (if (f64.lt (f64.sub (f64.const 0.02) (local.get $delta)) (f64.const 0.0001))
              (then
                (call $copy_vec (call $CLIP) (call $VEC))
                (return)))
            (local.set $lowInGamut (i32.const 0))
            (local.set $lowChroma (local.get $midChroma)))
          (else (local.set $highChroma (local.get $midChroma))))
        (br $search)))
    (call $copy_vec (call $CLIP) (call $VEC)))

  ;; ------------------------------------------------------------------
  ;; Trigonometry for polar forms (lch, oklch). Quadrant reduction with a
  ;; split pi/2, then odd/even Taylor polynomials on [-pi/4, pi/4].
  ;; ------------------------------------------------------------------

  (func $sin_poly (param $r f64) (result f64)
    (local $r2 f64)
    (local $sum f64)
    (local.set $r2 (f64.mul (local.get $r) (local.get $r)))
    (local.set $sum (f64.div (f64.const -1) (f64.const 1307674368000)))
    (local.set $sum (f64.add (f64.div (f64.const 1) (f64.const 6227020800)) (f64.mul (local.get $sum) (local.get $r2))))
    (local.set $sum (f64.add (f64.div (f64.const -1) (f64.const 39916800)) (f64.mul (local.get $sum) (local.get $r2))))
    (local.set $sum (f64.add (f64.div (f64.const 1) (f64.const 362880)) (f64.mul (local.get $sum) (local.get $r2))))
    (local.set $sum (f64.add (f64.div (f64.const -1) (f64.const 5040)) (f64.mul (local.get $sum) (local.get $r2))))
    (local.set $sum (f64.add (f64.div (f64.const 1) (f64.const 120)) (f64.mul (local.get $sum) (local.get $r2))))
    (local.set $sum (f64.add (f64.div (f64.const -1) (f64.const 6)) (f64.mul (local.get $sum) (local.get $r2))))
    (local.set $sum (f64.add (f64.const 1) (f64.mul (local.get $sum) (local.get $r2))))
    (f64.mul (local.get $r) (local.get $sum)))

  (func $cos_poly (param $r f64) (result f64)
    (local $r2 f64)
    (local $sum f64)
    (local.set $r2 (f64.mul (local.get $r) (local.get $r)))
    (local.set $sum (f64.div (f64.const -1) (f64.const 87178291200)))
    (local.set $sum (f64.add (f64.div (f64.const 1) (f64.const 479001600)) (f64.mul (local.get $sum) (local.get $r2))))
    (local.set $sum (f64.add (f64.div (f64.const -1) (f64.const 3628800)) (f64.mul (local.get $sum) (local.get $r2))))
    (local.set $sum (f64.add (f64.div (f64.const 1) (f64.const 40320)) (f64.mul (local.get $sum) (local.get $r2))))
    (local.set $sum (f64.add (f64.div (f64.const -1) (f64.const 720)) (f64.mul (local.get $sum) (local.get $r2))))
    (local.set $sum (f64.add (f64.div (f64.const 1) (f64.const 24)) (f64.mul (local.get $sum) (local.get $r2))))
    (local.set $sum (f64.add (f64.div (f64.const -1) (f64.const 2)) (f64.mul (local.get $sum) (local.get $r2))))
    (f64.add (f64.const 1) (f64.mul (local.get $sum) (local.get $r2))))

  ;; sin/cos for x in [0, 2*pi). Quadrant k = floor(x / (pi/2)),
  ;; r = x - k*pi/2 with the constant split for accuracy.
  (func $sin (param $x f64) (result f64)
    (local $k i32)
    (local $r f64)
    (local.set $k (i32.trunc_f64_s (f64.floor (f64.div (local.get $x) (f64.const 1.5707963267948966)))))
    (local.set $r
      (f64.sub
        (f64.sub (local.get $x)
          (f64.mul (f64.convert_i32_s (local.get $k)) (f64.const 1.5707963267948966)))
        (f64.mul (f64.convert_i32_s (local.get $k)) (f64.const 6.123233995736766e-17))))
    (local.set $k (i32.and (local.get $k) (i32.const 3)))
    (if (result f64) (i32.eq (local.get $k) (i32.const 0))
      (then (call $sin_poly (local.get $r)))
      (else (if (result f64) (i32.eq (local.get $k) (i32.const 1))
        (then (call $cos_poly (local.get $r)))
        (else (if (result f64) (i32.eq (local.get $k) (i32.const 2))
          (then (f64.neg (call $sin_poly (local.get $r))))
          (else (f64.neg (call $cos_poly (local.get $r))))))))))

  ;; cos(x) by the same reduction as $sin: cos(r), -sin(r), -cos(r) or
  ;; sin(r) by quadrant. Adding pi/2 to x first would round away the
  ;; digits of a small result: cos(pi/2) is 6.123233995736766e-17.
  (func $cos (param $x f64) (result f64)
    (local $k i32)
    (local $r f64)
    (local.set $k (i32.trunc_f64_s (f64.floor (f64.div (local.get $x) (f64.const 1.5707963267948966)))))
    (local.set $r
      (f64.sub
        (f64.sub (local.get $x)
          (f64.mul (f64.convert_i32_s (local.get $k)) (f64.const 1.5707963267948966)))
        (f64.mul (f64.convert_i32_s (local.get $k)) (f64.const 6.123233995736766e-17))))
    (local.set $k (i32.and (local.get $k) (i32.const 3)))
    (if (result f64) (i32.eq (local.get $k) (i32.const 0))
      (then (call $cos_poly (local.get $r)))
      (else (if (result f64) (i32.eq (local.get $k) (i32.const 1))
        (then (f64.neg (call $sin_poly (local.get $r))))
        (else (if (result f64) (i32.eq (local.get $k) (i32.const 2))
          (then (f64.neg (call $cos_poly (local.get $r))))
          (else (call $sin_poly (local.get $r)))))))))

  ;; ------------------------------------------------------------------
  ;; Piecewise transfer functions of the Rec. ITU-R BT.2020 signal (tagged
  ;; sources; CSS color(rec2020) has gamma 2.4) and of color(prophoto-rgb).
  ;; ------------------------------------------------------------------

  (func $rec2020_decode (export "rec2020_decode") (param $value f64) (result f64)
    (local $sign f64)
    (local $magnitude f64)
    (local.set $sign (f64.copysign (f64.const 1) (local.get $value)))
    (local.set $magnitude (f64.abs (local.get $value)))
    (if (result f64)
      (f64.lt (local.get $magnitude) (f64.mul (f64.const 0.018053968510807) (f64.const 4.5)))
      (then (f64.div (local.get $value) (f64.const 4.5)))
      (else
        (f64.mul (local.get $sign)
          (call $pow
            (f64.div
              (f64.add (local.get $magnitude) (f64.sub (f64.const 1.09929682680944) (f64.const 1)))
              (f64.const 1.09929682680944))
            (f64.div (f64.const 1) (f64.const 0.45)))))))

  (func $rec2020_encode (export "rec2020_encode") (param $value f64) (result f64)
    (local $sign f64)
    (local $magnitude f64)
    (local.set $sign (f64.copysign (f64.const 1) (local.get $value)))
    (local.set $magnitude (f64.abs (local.get $value)))
    (if (result f64) (f64.lt (local.get $magnitude) (f64.const 0.018053968510807))
      (then (f64.mul (local.get $value) (f64.const 4.5)))
      (else
        (f64.mul (local.get $sign)
          (f64.sub
            (f64.mul (f64.const 1.09929682680944)
              (call $pow (local.get $magnitude) (f64.const 0.45)))
            (f64.sub (f64.const 1.09929682680944) (f64.const 1)))))))

  (func $prophoto_decode (export "prophoto_decode") (param $value f64) (result f64)
    (local $sign f64)
    (local $magnitude f64)
    (local.set $sign (f64.copysign (f64.const 1) (local.get $value)))
    (local.set $magnitude (f64.abs (local.get $value)))
    (if (result f64) (f64.le (local.get $magnitude) (f64.div (f64.const 16) (f64.const 512)))
      (then (f64.div (local.get $value) (f64.const 16)))
      (else (f64.mul (local.get $sign) (call $pow (local.get $magnitude) (f64.const 1.8))))))

  (func $prophoto_encode (export "prophoto_encode") (param $value f64) (result f64)
    (local $sign f64)
    (local $magnitude f64)
    (local.set $sign (f64.copysign (f64.const 1) (local.get $value)))
    (local.set $magnitude (f64.abs (local.get $value)))
    (if (result f64) (f64.le (local.get $magnitude) (f64.div (f64.const 1) (f64.const 512)))
      (then (f64.mul (local.get $value) (f64.const 16)))
      (else
        (f64.mul (local.get $sign)
          (call $pow (local.get $magnitude) (f64.div (f64.const 1) (f64.const 1.8)))))))

  ;; ------------------------------------------------------------------
  ;; CSS color value parser.
  ;;
  ;; Input: lower-case ASCII bytes at INPUT (4096). Output block:
  ;;   2560 f64 component 0..2, 2584 f64 alpha,
  ;;   2592 i32 missing mask, 2596 i32 alpha-is-missing,
  ;;   2600 i32 primaries id, 2604 i32 transfer id,
  ;;   2608 f64 gamma exponent, 2616 i32 form id,
  ;;   2620 i32 authored missing mask. The authored components follow the
  ;;   completed record at 2640 (three f64, see $store_authored).
  ;; Primaries ids: 0 sRGB, 1 Display P3, 2 Rec.2020, 3 A98 RGB,
  ;; 4 ProPhoto RGB, 5 XYZ D50, 6 XYZ D65. Transfer ids:
  ;; 0 sRGB, 1 linear, 2 gamma, 3 PQ, 4 HLG, 5 Rec.2020, 6 ProPhoto RGB.
  ;; Form ids: 1 hex, 2 rgb, 3 hsl, 4 hwb, 5 lab, 6 lch, 7 oklab,
  ;;   8 oklch, 9 color.
  ;; Errors: 1 unrecognized form, 2 bad number, 3 bad unit,
  ;;   4 bad structure, 5 unknown color space, 6 trailing bytes,
  ;;   7 bad hex.
  ;; ------------------------------------------------------------------

  (func $OUT_COMP (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2560)))
  (func $OUT_ALPHA (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2584)))
  (func $OUT_MISSING (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2592)))
  (func $OUT_ALPHA_MISSING (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2596)))
  (func $OUT_PRIMARIES (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2600)))
  (func $OUT_TRANSFER (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2604)))
  (func $OUT_GAMMA (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2608)))
  (func $OUT_FORM (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2616)))
  (func $OUT_AUTHORED_MISSING (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2620)))
  (func $OUT_AUTHORED (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 2640)))
  (func $INPUT (result i32) (i32.add (global.get $COLOR_BASE) (i32.const 4096)))

  (global $pos (mut i32) (i32.const 0))
  (global $end (mut i32) (i32.const 0))
  ;; Component token: 0 number, 1 percent, 2 angle in degrees, 3 none.
  (global $tokType (mut i32) (i32.const 0))
  (global $tokValue (mut f64) (f64.const 0))

  ;; Keyword strings.

  (func $peek (result i32)
    (if (result i32) (i32.ge_u (global.get $pos) (global.get $end))
      (then (i32.const -1))
      (else (i32.load8_u (global.get $pos)))))

  (func $advance (global.set $pos (i32.add (global.get $pos) (i32.const 1))))

  (func $skip_ws
    (local $byte i32)
    (block $done
      (loop $next
        (local.set $byte (call $peek))
        (br_if $done
          (i32.eqz
            (i32.or
              (i32.or (i32.eq (local.get $byte) (i32.const 32)) (i32.eq (local.get $byte) (i32.const 9)))
              (i32.or (i32.eq (local.get $byte) (i32.const 10)) (i32.eq (local.get $byte) (i32.const 13))))))
        (call $advance)
        (br $next))))

  ;; Matches the keyword at $pos and advances past it, or leaves $pos.
  (func $match_kw (param $keyword i32) (param $length i32) (result i32)
    (local $index i32)
    (if (i32.gt_u (i32.add (global.get $pos) (local.get $length)) (global.get $end))
      (then (return (i32.const 0))))
    (block $fail
      (loop $next
        (br_if $fail
          (i32.ne
            (i32.load8_u (i32.add (global.get $pos) (local.get $index)))
            (i32.load8_u (i32.add (local.get $keyword) (local.get $index)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br_if $next (i32.lt_u (local.get $index) (local.get $length))))
      (global.set $pos (i32.add (global.get $pos) (local.get $length)))
      (return (i32.const 1)))
    (i32.const 0))

  (func $is_ident_byte (param $byte i32) (result i32)
    (i32.or
      (i32.or
        (i32.and (i32.ge_s (local.get $byte) (i32.const 97)) (i32.le_s (local.get $byte) (i32.const 122)))
        (i32.and (i32.ge_s (local.get $byte) (i32.const 48)) (i32.le_s (local.get $byte) (i32.const 57))))
      (i32.eq (local.get $byte) (i32.const 45))))

  ;; Exact powers of ten by repeated multiplication (exact through 1e22).
  (func $pow10 (param $exponent i32) (result f64)
    (local $result f64)
    (local.set $result (f64.const 1))
    (block $done
      (loop $next
        (br_if $done (i32.le_s (local.get $exponent) (i32.const 0)))
        (local.set $result (f64.mul (local.get $result) (f64.const 10)))
        (local.set $exponent (i32.sub (local.get $exponent) (i32.const 1)))
        (br $next)))
    (local.get $result))

  ;; Reads one number into $tokValue. Returns 0 on success, 2 on failure.
  ;; Mantissa accumulates 15 exact digits; later digits shift the decimal
  ;; exponent, so the result is deterministic on every host.
  (func $read_number (result i32)
    (local $byte i32)
    (local $sign f64)
    (local $mantissa i64)
    (local $digits i32)
    (local $decimalExponent i32)
    (local $sawDigit i32)
    (local $exponentSign i32)
    (local $exponentValue i32)
    (local $value f64)
    (local.set $sign (f64.const 1))
    (local.set $byte (call $peek))
    (if (i32.eq (local.get $byte) (i32.const 43)) (then (call $advance)))
    (if (i32.eq (local.get $byte) (i32.const 45))
      (then (local.set $sign (f64.const -1)) (call $advance)))
    (block $intDone
      (loop $intNext
        (local.set $byte (call $peek))
        (br_if $intDone
          (i32.or (i32.lt_s (local.get $byte) (i32.const 48)) (i32.gt_s (local.get $byte) (i32.const 57))))
        (local.set $sawDigit (i32.const 1))
        (if (i32.lt_s (local.get $digits) (i32.const 15))
          (then
            (local.set $mantissa
              (i64.add (i64.mul (local.get $mantissa) (i64.const 10))
                (i64.extend_i32_s (i32.sub (local.get $byte) (i32.const 48)))))
            (local.set $digits (i32.add (local.get $digits) (i32.const 1))))
          (else (local.set $decimalExponent (i32.add (local.get $decimalExponent) (i32.const 1)))))
        (call $advance)
        (br $intNext)))
    (if (i32.eq (call $peek) (i32.const 46))
      (then
        (call $advance)
        (block $fracDone
          (loop $fracNext
            (local.set $byte (call $peek))
            (br_if $fracDone
              (i32.or (i32.lt_s (local.get $byte) (i32.const 48)) (i32.gt_s (local.get $byte) (i32.const 57))))
            (local.set $sawDigit (i32.const 1))
            (if (i32.lt_s (local.get $digits) (i32.const 15))
              (then
                (local.set $mantissa
                  (i64.add (i64.mul (local.get $mantissa) (i64.const 10))
                    (i64.extend_i32_s (i32.sub (local.get $byte) (i32.const 48)))))
                (local.set $digits (i32.add (local.get $digits) (i32.const 1)))
                (local.set $decimalExponent (i32.sub (local.get $decimalExponent) (i32.const 1)))))
            (call $advance)
            (br $fracNext)))))
    (if (i32.eqz (local.get $sawDigit)) (then (return (i32.const 2))))
    (if (i32.eq (call $peek) (i32.const 101))
      (then
        (call $advance)
        (local.set $exponentSign (i32.const 1))
        (local.set $byte (call $peek))
        (if (i32.eq (local.get $byte) (i32.const 43)) (then (call $advance)))
        (if (i32.eq (local.get $byte) (i32.const 45))
          (then (local.set $exponentSign (i32.const -1)) (call $advance)))
        (local.set $byte (call $peek))
        (if (i32.or (i32.lt_s (local.get $byte) (i32.const 48)) (i32.gt_s (local.get $byte) (i32.const 57)))
          (then (return (i32.const 2))))
        (block $expDone
          (loop $expNext
            (local.set $byte (call $peek))
            (br_if $expDone
              (i32.or (i32.lt_s (local.get $byte) (i32.const 48)) (i32.gt_s (local.get $byte) (i32.const 57))))
            (if (i32.lt_s (local.get $exponentValue) (i32.const 400))
              (then
                (local.set $exponentValue
                  (i32.add (i32.mul (local.get $exponentValue) (i32.const 10))
                    (i32.sub (local.get $byte) (i32.const 48))))))
            (call $advance)
            (br $expNext)))
        (local.set $decimalExponent
          (i32.add (local.get $decimalExponent)
            (i32.mul (local.get $exponentSign) (local.get $exponentValue))))))
    (local.set $value (f64.convert_i64_s (local.get $mantissa)))
    (if (i32.gt_s (local.get $decimalExponent) (i32.const 0))
      (then
        (local.set $value (f64.mul (local.get $value) (call $pow10 (local.get $decimalExponent)))))
      (else
        (if (i32.lt_s (local.get $decimalExponent) (i32.const 0))
          (then
            (local.set $value
              (f64.div (local.get $value)
                (call $pow10 (i32.sub (i32.const 0) (local.get $decimalExponent)))))))))
    (global.set $tokValue (f64.mul (local.get $sign) (local.get $value)))
    (i32.const 0))

  ;; Reads one component token: none | number [% | angle unit].
  ;; Returns 0 on success or an error code.
  (func $read_component (result i32)
    (local $status i32)
    (call $skip_ws)
    (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3080)) (i32.const 4))
      (then
        (global.set $tokType (i32.const 3))
        (global.set $tokValue (f64.const 0))
        (return (i32.const 0))))
    (local.set $status (call $read_number))
    (if (local.get $status) (then (return (local.get $status))))
    (if (i32.eq (call $peek) (i32.const 37))
      (then
        (call $advance)
        (global.set $tokType (i32.const 1))
        (return (i32.const 0))))
    (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3088)) (i32.const 3))
      (then (global.set $tokType (i32.const 2)) (return (i32.const 0))))
    (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3096)) (i32.const 4))
      (then
        (global.set $tokValue (f64.mul (global.get $tokValue) (f64.const 0.9)))
        (global.set $tokType (i32.const 2))
        (return (i32.const 0))))
    (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3104)) (i32.const 3))
      (then
        (global.set $tokValue
          (f64.mul (global.get $tokValue) (f64.div (f64.const 180) (f64.const 3.141592653589793))))
        (global.set $tokType (i32.const 2))
        (return (i32.const 0))))
    (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3112)) (i32.const 4))
      (then
        (global.set $tokValue (f64.mul (global.get $tokValue) (f64.const 360)))
        (global.set $tokType (i32.const 2))
        (return (i32.const 0))))
    (if (call $is_ident_byte (call $peek)) (then (return (i32.const 3))))
    (global.set $tokType (i32.const 0))
    (i32.const 0))

  ;; Alpha suffix: [legacy ',' | '/'] component, then ')'. Writes alpha
  ;; outputs. Returns 0 or an error code.
  (func $read_alpha_and_close (param $legacy i32) (result i32)
    (local $status i32)
    (f64.store (call $OUT_ALPHA) (f64.const 1))
    (i32.store (call $OUT_ALPHA_MISSING) (i32.const 0))
    (call $skip_ws)
    (if (i32.eq (call $peek) (i32.const 41))
      (then (call $advance) (return (i32.const 0))))
    (if (local.get $legacy)
      (then
        (if (i32.ne (call $peek) (i32.const 44)) (then (return (i32.const 4))))
        (call $advance))
      (else
        (if (i32.ne (call $peek) (i32.const 47)) (then (return (i32.const 4))))
        (call $advance)))
    (local.set $status (call $read_component))
    (if (local.get $status) (then (return (local.get $status))))
    (if (i32.eq (global.get $tokType) (i32.const 2)) (then (return (i32.const 3))))
    ;; The legacy comma syntax takes no `none` (CSS Color 4 §4.4, §5.1).
    (if (i32.and (local.get $legacy) (i32.eq (global.get $tokType) (i32.const 3))) (then (return (i32.const 4))))
    (if (i32.eq (global.get $tokType) (i32.const 3))
      (then (i32.store (call $OUT_ALPHA_MISSING) (i32.const 1)))
      (else
        (f64.store (call $OUT_ALPHA)
          (if (result f64) (i32.eq (global.get $tokType) (i32.const 1))
            (then (f64.div (global.get $tokValue) (f64.const 100)))
            (else (global.get $tokValue))))))
    (call $skip_ws)
    (if (i32.ne (call $peek) (i32.const 41)) (then (return (i32.const 4))))
    (call $advance)
    (i32.const 0))

  ;; Reads three components with one separator style. $legacy is detected
  ;; from the byte after the first component. Components land in OUT_COMP
  ;; raw with their token types in $type0..2 packed into the return via
  ;; globals below.
  (global $type0 (mut i32) (i32.const 0))
  (global $type1 (mut i32) (i32.const 0))
  (global $type2 (mut i32) (i32.const 0))
  (global $legacyForm (mut i32) (i32.const 0))

  (func $read_three_components (result i32)
    (local $status i32)
    (local.set $status (call $read_component))
    (if (local.get $status) (then (return (local.get $status))))
    (global.set $type0 (global.get $tokType))
    (f64.store (call $OUT_COMP) (global.get $tokValue))
    (call $skip_ws)
    (global.set $legacyForm (i32.eq (call $peek) (i32.const 44)))
    (if (global.get $legacyForm)
      (then
        (if (i32.eq (global.get $type0) (i32.const 3)) (then (return (i32.const 4))))
        (call $advance)))
    (local.set $status (call $read_component))
    (if (local.get $status) (then (return (local.get $status))))
    (global.set $type1 (global.get $tokType))
    (f64.store (i32.add (call $OUT_COMP) (i32.const 8)) (global.get $tokValue))
    (call $skip_ws)
    (if (global.get $legacyForm)
      (then
        (if (i32.or
              (i32.ne (call $peek) (i32.const 44))
              (i32.eq (global.get $type1) (i32.const 3)))
          (then (return (i32.const 4))))
        (call $advance)))
    (local.set $status (call $read_component))
    (if (local.get $status) (then (return (local.get $status))))
    (global.set $type2 (global.get $tokType))
    (if (i32.and (global.get $legacyForm) (i32.eq (global.get $tokType) (i32.const 3)))
      (then (return (i32.const 4))))
    (f64.store (i32.add (call $OUT_COMP) (i32.const 16)) (global.get $tokValue))
    (i32.const 0))

  ;; The conversion mask (OUT_MISSING) and the authored mask (result offset
  ;; 60) start equal; forms that convert a missing component to zero clear
  ;; only the conversion mask.
  (func $set_missing_mask
    (local $mask i32)
    (local.set $mask
      (i32.or
        (i32.or
          (i32.eq (global.get $type0) (i32.const 3))
          (i32.shl (i32.eq (global.get $type1) (i32.const 3)) (i32.const 1)))
        (i32.shl (i32.eq (global.get $type2) (i32.const 3)) (i32.const 2))))
    (i32.store (call $OUT_MISSING) (local.get $mask))
    (i32.store (call $OUT_AUTHORED_MISSING) (local.get $mask)))

  ;; Authored components in their own form's units, before conversion:
  ;; sRGB 0..1 for hex, rgb() and color(); hue degrees in [0, 360), then
  ;; saturation and lightness or whiteness and blackness as fractions for
  ;; hsl() and hwb(); L, a, b for lab() and oklab(); L, C, hue for lch()
  ;; and oklch(). color() keeps its own encoding.
  (func $store_authored (param $c0 f64) (param $c1 f64) (param $c2 f64)
    (call $store_vec (call $OUT_AUTHORED) (local.get $c0) (local.get $c1) (local.get $c2)))

  (func $set_encoding (param $primaries i32) (param $transfer i32) (param $gamma f64) (param $form i32)
    (i32.store (call $OUT_PRIMARIES) (local.get $primaries))
    (i32.store (call $OUT_TRANSFER) (local.get $transfer))
    (f64.store (call $OUT_GAMMA) (local.get $gamma))
    (i32.store (call $OUT_FORM) (local.get $form)))

  (func $store_comp (param $index i32) (param $value f64)
    (f64.store (i32.add (call $OUT_COMP) (i32.mul (local.get $index) (i32.const 8)))
      (local.get $value)))

  (func $load_comp (param $index i32) (result f64)
    (f64.load (i32.add (call $OUT_COMP) (i32.mul (local.get $index) (i32.const 8)))))

  ;; Scales one stored component: percent value maps [0,100%] onto
  ;; [0, percentScale]; a plain number multiplies numberScale.
  (func $scale_comp (param $index i32) (param $type i32) (param $numberScale f64) (param $percentScale f64)
    (if (i32.eq (local.get $type) (i32.const 1))
      (then
        (call $store_comp (local.get $index)
          (f64.mul (f64.div (call $load_comp (local.get $index)) (f64.const 100)) (local.get $percentScale))))
      (else
        (call $store_comp (local.get $index)
          (f64.mul (call $load_comp (local.get $index)) (local.get $numberScale))))))

  ;; Hue helper for hsl/hwb: f(n) per CSS Color 4, h in degrees.
  (func $hsl_f (param $n f64) (param $h f64) (param $s f64) (param $l f64) (result f64)
    (local $k f64)
    (local $a f64)
    (local.set $k (f64.add (local.get $n) (f64.div (local.get $h) (f64.const 30))))
    (local.set $k (f64.sub (local.get $k) (f64.mul (f64.const 12) (f64.floor (f64.div (local.get $k) (f64.const 12))))))
    (local.set $a (f64.mul (local.get $s) (f64.min (local.get $l) (f64.sub (f64.const 1) (local.get $l)))))
    (f64.sub (local.get $l)
      (f64.mul (local.get $a)
        (f64.max (f64.const -1)
          (f64.min
            (f64.min (f64.sub (local.get $k) (f64.const 3)) (f64.sub (f64.const 9) (local.get $k)))
            (f64.const 1))))))

  (func $normalize_hue (param $h f64) (result f64)
    (f64.sub (local.get $h) (f64.mul (f64.const 360) (f64.floor (f64.div (local.get $h) (f64.const 360))))))

  ;; Converts stored lab components through the shared VEC pipeline into
  ;; XYZ D65 and stores them back.
  (func $lab_comps_to_xyz_d65
    (call $store_vec (call $VEC)
      (call $load_comp (i32.const 0)) (call $load_comp (i32.const 1)) (call $load_comp (i32.const 2)))
    (call $lab_to_xyz_d50)
    (call $apply_matrix (i32.const 10))
    (call $store_comp (i32.const 0) (call $load0 (call $VEC)))
    (call $store_comp (i32.const 1) (call $load1 (call $VEC)))
    (call $store_comp (i32.const 2) (call $load2 (call $VEC))))

  (func $oklab_comps_to_xyz_d65
    (call $store_vec (call $VEC)
      (call $load_comp (i32.const 0)) (call $load_comp (i32.const 1)) (call $load_comp (i32.const 2)))
    (call $oklab_to_xyz_d65)
    (call $store_comp (i32.const 0) (call $load0 (call $VEC)))
    (call $store_comp (i32.const 1) (call $load1 (call $VEC)))
    (call $store_comp (i32.const 2) (call $load2 (call $VEC))))

  ;; Polar to rectangular for lch/oklch: component1 = chroma,
  ;; component2 = hue degrees.
  (func $polar_to_rectangular
    (local $chroma f64)
    (local $hueRadians f64)
    (local.set $chroma (call $load_comp (i32.const 1)))
    (local.set $hueRadians
      (f64.mul (call $normalize_hue (call $load_comp (i32.const 2)))
        (f64.div (f64.const 3.141592653589793) (f64.const 180))))
    (call $store_comp (i32.const 1) (f64.mul (local.get $chroma) (call $cos (local.get $hueRadians))))
    (call $store_comp (i32.const 2) (f64.mul (local.get $chroma) (call $sin (local.get $hueRadians)))))

  ;; Hex digits: returns 0-15 or -1.
  (func $hex_digit (param $byte i32) (result i32)
    (if (i32.and (i32.ge_s (local.get $byte) (i32.const 48)) (i32.le_s (local.get $byte) (i32.const 57)))
      (then (return (i32.sub (local.get $byte) (i32.const 48)))))
    (if (i32.and (i32.ge_s (local.get $byte) (i32.const 97)) (i32.le_s (local.get $byte) (i32.const 102)))
      (then (return (i32.sub (local.get $byte) (i32.const 87)))))
    (i32.const -1))

  (func $parse_hex (result i32)
    (local $length i32)
    (local $index i32)
    (local $digit i32)
    (local $high i32)
    (local $low i32)
    (call $advance)
    (local.set $length (i32.sub (global.get $end) (global.get $pos)))
    ;; Validate every digit first.
    (block $checked
      (loop $check
        (br_if $checked (i32.ge_s (local.get $index) (local.get $length)))
        (if (i32.lt_s (call $hex_digit (i32.load8_u (i32.add (global.get $pos) (local.get $index)))) (i32.const 0))
          (then (return (i32.const 7))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $check)))
    (f64.store (call $OUT_ALPHA) (f64.const 1))
    (i32.store (call $OUT_ALPHA_MISSING) (i32.const 0))
    (i32.store (call $OUT_MISSING) (i32.const 0))
    (call $set_encoding (i32.const 0) (i32.const 0) (f64.const 0) (i32.const 1))
    (if (i32.or (i32.eq (local.get $length) (i32.const 3)) (i32.eq (local.get $length) (i32.const 4)))
      (then
        (local.set $index (i32.const 0))
        (block $shortDone
          (loop $shortNext
            (br_if $shortDone (i32.ge_s (local.get $index) (local.get $length)))
            (local.set $digit (call $hex_digit (i32.load8_u (i32.add (global.get $pos) (local.get $index)))))
            (local.set $digit (i32.add (i32.mul (local.get $digit) (i32.const 16)) (local.get $digit)))
            (if (i32.lt_s (local.get $index) (i32.const 3))
              (then
                (call $store_comp (local.get $index)
                  (f64.div (f64.convert_i32_s (local.get $digit)) (f64.const 255))))
              (else
                (f64.store (call $OUT_ALPHA)
                  (f64.div (f64.convert_i32_s (local.get $digit)) (f64.const 255)))))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $shortNext)))
        (global.set $pos (global.get $end))
        (return (i32.const 0))))
    (if (i32.or (i32.eq (local.get $length) (i32.const 6)) (i32.eq (local.get $length) (i32.const 8)))
      (then
        (local.set $index (i32.const 0))
        (block $longDone
          (loop $longNext
            (br_if $longDone (i32.ge_s (i32.mul (local.get $index) (i32.const 2)) (local.get $length)))
            (local.set $high (call $hex_digit (i32.load8_u (i32.add (global.get $pos) (i32.mul (local.get $index) (i32.const 2))))))
            (local.set $low (call $hex_digit (i32.load8_u (i32.add (i32.add (global.get $pos) (i32.mul (local.get $index) (i32.const 2))) (i32.const 1)))))
            (local.set $digit (i32.add (i32.mul (local.get $high) (i32.const 16)) (local.get $low)))
            (if (i32.lt_s (local.get $index) (i32.const 3))
              (then
                (call $store_comp (local.get $index)
                  (f64.div (f64.convert_i32_s (local.get $digit)) (f64.const 255))))
              (else
                (f64.store (call $OUT_ALPHA)
                  (f64.div (f64.convert_i32_s (local.get $digit)) (f64.const 255)))))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $longNext)))
        (global.set $pos (global.get $end))
        (return (i32.const 0))))
    (i32.const 7))

  ;; The main entry point. Input bytes are lower-case ASCII at INPUT.
  (func $parse_css_color (param $length i32) (result i32)
    (local $status i32)
    (local $form i32)
    (local $hue f64)
    (local $saturation f64)
    (local $lightnessOrWhite f64)
    (local $blackness f64)
    (local $gray f64)
    (local $index i32)
    (local $primaries i32)
    (local $transfer i32)
    (local $gamma f64)
    (global.set $pos (call $INPUT))
    (global.set $end (i32.add (call $INPUT) (local.get $length)))
    (i32.store (call $OUT_MISSING) (i32.const 0))
    (i32.store (call $OUT_AUTHORED_MISSING) (i32.const 0))
    (call $skip_ws)
    (if (i32.eq (call $peek) (i32.const 35))
      (then
        (local.set $status (call $parse_hex))
        (if (local.get $status) (then (return (local.get $status))))
        (call $store_authored (call $load_comp (i32.const 0)) (call $load_comp (i32.const 1)) (call $load_comp (i32.const 2)))
        (return (i32.const 0))))
    ;; Dispatch on the function keyword. Longer spellings first.
    (local.set $form (i32.const 0))
    (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3000)) (i32.const 5)) (then (local.set $form (i32.const 2))))
    (if (i32.eqz (local.get $form))
      (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3008)) (i32.const 4)) (then (local.set $form (i32.const 2))))))
    (if (i32.eqz (local.get $form))
      (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3016)) (i32.const 5)) (then (local.set $form (i32.const 3))))))
    (if (i32.eqz (local.get $form))
      (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3024)) (i32.const 4)) (then (local.set $form (i32.const 3))))))
    (if (i32.eqz (local.get $form))
      (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3032)) (i32.const 4)) (then (local.set $form (i32.const 4))))))
    (if (i32.eqz (local.get $form))
      (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3040)) (i32.const 4)) (then (local.set $form (i32.const 5))))))
    (if (i32.eqz (local.get $form))
      (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3048)) (i32.const 4)) (then (local.set $form (i32.const 6))))))
    (if (i32.eqz (local.get $form))
      (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3056)) (i32.const 6)) (then (local.set $form (i32.const 7))))))
    (if (i32.eqz (local.get $form))
      (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3064)) (i32.const 6)) (then (local.set $form (i32.const 8))))))
    (if (i32.eqz (local.get $form))
      (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3072)) (i32.const 6)) (then (local.set $form (i32.const 9))))))
    (if (i32.eqz (local.get $form)) (then (return (i32.const 1))))
    ;; color(): resolve the space identifier first.
    (local.set $primaries (i32.const 0))
    (local.set $transfer (i32.const 0))
    (local.set $gamma (f64.const 0))
    (if (i32.eq (local.get $form) (i32.const 9))
      (then
        (call $skip_ws)
        (local.set $primaries (i32.const -1))
        (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3120)) (i32.const 11))
          (then (local.set $primaries (i32.const 0)) (local.set $transfer (i32.const 1))))
        (if (i32.eq (local.get $primaries) (i32.const -1))
          (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3136)) (i32.const 4))
            (then (local.set $primaries (i32.const 0)) (local.set $transfer (i32.const 0))))))
        ;; display-p3-linear before its prefix display-p3.
        (if (i32.eq (local.get $primaries) (i32.const -1))
          (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3264)) (i32.const 17))
            (then (local.set $primaries (i32.const 1)) (local.set $transfer (i32.const 1))))))
        (if (i32.eq (local.get $primaries) (i32.const -1))
          (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3144)) (i32.const 10))
            (then (local.set $primaries (i32.const 1)) (local.set $transfer (i32.const 0))))))
        (if (i32.eq (local.get $primaries) (i32.const -1))
          (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3160)) (i32.const 7))
            (then
              (local.set $primaries (i32.const 3))
              (local.set $transfer (i32.const 2))
              (local.set $gamma (f64.div (f64.const 563) (f64.const 256)))))))
        (if (i32.eq (local.get $primaries) (i32.const -1))
          (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3168)) (i32.const 12))
            (then (local.set $primaries (i32.const 4)) (local.set $transfer (i32.const 6))))))
        (if (i32.eq (local.get $primaries) (i32.const -1))
          (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3192)) (i32.const 10))
            (then (local.set $primaries (i32.const 2)) (local.set $transfer (i32.const 3))))))
        (if (i32.eq (local.get $primaries) (i32.const -1))
          (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3208)) (i32.const 11))
            (then (local.set $primaries (i32.const 2)) (local.set $transfer (i32.const 4))))))
        (if (i32.eq (local.get $primaries) (i32.const -1))
          (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3224)) (i32.const 14))
            (then (local.set $primaries (i32.const 2)) (local.set $transfer (i32.const 1))))))
        ;; rec2020: gamma 2.4 (Rec. ITU-R BT.1886, CSS Color 4 §10.8).
        (if (i32.eq (local.get $primaries) (i32.const -1))
          (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3184)) (i32.const 7))
            (then
              (local.set $primaries (i32.const 2))
              (local.set $transfer (i32.const 2))
              (local.set $gamma (f64.const 2.4))))))
        (if (i32.eq (local.get $primaries) (i32.const -1))
          (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3240)) (i32.const 7))
            (then (local.set $primaries (i32.const 5)) (local.set $transfer (i32.const 1))))))
        (if (i32.eq (local.get $primaries) (i32.const -1))
          (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3248)) (i32.const 7))
            (then (local.set $primaries (i32.const 6)) (local.set $transfer (i32.const 1))))))
        (if (i32.eq (local.get $primaries) (i32.const -1))
          (then (if (call $match_kw (i32.add (global.get $COLOR_BASE) (i32.const 3256)) (i32.const 3))
            (then (local.set $primaries (i32.const 6)) (local.set $transfer (i32.const 1))))))
        (if (i32.eq (local.get $primaries) (i32.const -1)) (then (return (i32.const 5))))
        (if (call $is_ident_byte (call $peek)) (then (return (i32.const 5))))))
    ;; Three components.
    (local.set $status (call $read_three_components))
    (if (local.get $status) (then (return (local.get $status))))
    ;; Alpha and the closing parenthesis.
    (local.set $status (call $read_alpha_and_close (global.get $legacyForm)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $skip_ws)
    (if (i32.ne (call $peek) (i32.const -1)) (then (return (i32.const 6))))
    ;; Form-specific scaling and conversion.
    (call $set_missing_mask)
    ;; The legacy comma syntax fixes the component types (CSS Color 4 §5.1,
    ;; §7.1): rgb() takes three numbers or three percentages, hsl() a hue
    ;; and two percentages. hwb(), lab(), lch(), oklab(), oklch() and
    ;; color() have no legacy syntax.
    (if (global.get $legacyForm)
      (then
        (if (i32.and (i32.eq (local.get $form) (i32.const 2))
              (i32.or (i32.ne (global.get $type0) (global.get $type1)) (i32.ne (global.get $type0) (global.get $type2))))
          (then (return (i32.const 3))))
        (if (i32.and (i32.eq (local.get $form) (i32.const 3))
              (i32.or (i32.eq (global.get $type0) (i32.const 1))
                (i32.or (i32.ne (global.get $type1) (i32.const 1)) (i32.ne (global.get $type2) (i32.const 1)))))
          (then (return (i32.const 3))))
        (if (i32.and (i32.ne (local.get $form) (i32.const 2)) (i32.ne (local.get $form) (i32.const 3)))
          (then (return (i32.const 3))))))
    (if (i32.eq (local.get $form) (i32.const 2))
      (then ;; rgb: number /255, percent -> 0..1. Angles are invalid.
        (if (i32.or (i32.eq (global.get $type0) (i32.const 2))
              (i32.or (i32.eq (global.get $type1) (i32.const 2)) (i32.eq (global.get $type2) (i32.const 2))))
          (then (return (i32.const 3))))
        (call $scale_comp (i32.const 0) (global.get $type0) (f64.div (f64.const 1) (f64.const 255)) (f64.const 1))
        (call $scale_comp (i32.const 1) (global.get $type1) (f64.div (f64.const 1) (f64.const 255)) (f64.const 1))
        (call $scale_comp (i32.const 2) (global.get $type2) (f64.div (f64.const 1) (f64.const 255)) (f64.const 1))
        (call $store_authored (call $load_comp (i32.const 0)) (call $load_comp (i32.const 1)) (call $load_comp (i32.const 2)))
        (call $set_encoding (i32.const 0) (i32.const 0) (f64.const 0) (i32.const 2))
        (return (i32.const 0))))
    (if (i32.or (i32.eq (local.get $form) (i32.const 3)) (i32.eq (local.get $form) (i32.const 4)))
      (then ;; hsl / hwb: none converts as zero; only the authored mask keeps it.
        (i32.store (call $OUT_MISSING) (i32.const 0))
        (if (i32.eq (global.get $type1) (i32.const 2)) (then (return (i32.const 3))))
        (if (i32.eq (global.get $type2) (i32.const 2)) (then (return (i32.const 3))))
        (local.set $hue (call $normalize_hue (call $load_comp (i32.const 0))))
        (call $scale_comp (i32.const 1) (global.get $type1) (f64.div (f64.const 1) (f64.const 100)) (f64.const 1))
        (call $scale_comp (i32.const 2) (global.get $type2) (f64.div (f64.const 1) (f64.const 100)) (f64.const 1))
        ;; An hsl() saturation below 0% clamps to 0% at parsed-value time
        ;; (CSS Color 4 §7).
        (if (i32.eq (local.get $form) (i32.const 3))
          (then (call $store_comp (i32.const 1) (f64.max (call $load_comp (i32.const 1)) (f64.const 0)))))
        (call $store_authored (local.get $hue) (call $load_comp (i32.const 1)) (call $load_comp (i32.const 2)))
        (if (i32.eq (local.get $form) (i32.const 3))
          (then
            (local.set $saturation (call $load_comp (i32.const 1)))
            (local.set $lightnessOrWhite (call $load_comp (i32.const 2)))
            (call $store_comp (i32.const 0)
              (call $hsl_f (f64.const 0) (local.get $hue) (local.get $saturation) (local.get $lightnessOrWhite)))
            (call $store_comp (i32.const 1)
              (call $hsl_f (f64.const 8) (local.get $hue) (local.get $saturation) (local.get $lightnessOrWhite)))
            (call $store_comp (i32.const 2)
              (call $hsl_f (f64.const 4) (local.get $hue) (local.get $saturation) (local.get $lightnessOrWhite))))
          (else
            (local.set $lightnessOrWhite (call $load_comp (i32.const 1)))
            (local.set $blackness (call $load_comp (i32.const 2)))
            (if (f64.ge (f64.add (local.get $lightnessOrWhite) (local.get $blackness)) (f64.const 1))
              (then
                (local.set $gray
                  (f64.div (local.get $lightnessOrWhite)
                    (f64.add (local.get $lightnessOrWhite) (local.get $blackness))))
                (call $store_comp (i32.const 0) (local.get $gray))
                (call $store_comp (i32.const 1) (local.get $gray))
                (call $store_comp (i32.const 2) (local.get $gray)))
              (else
                (block $hwbDone
                  (local.set $index (i32.const 0))
                  (loop $hwbNext
                    (br_if $hwbDone (i32.ge_s (local.get $index) (i32.const 3)))
                    (call $store_comp (local.get $index)
                      (f64.add
                        (f64.mul
                          (call $hsl_f
                            (select (f64.const 0) (select (f64.const 8) (f64.const 4) (i32.eq (local.get $index) (i32.const 1))) (i32.eqz (local.get $index)))
                            (local.get $hue) (f64.const 1) (f64.const 0.5))
                          (f64.sub (f64.sub (f64.const 1) (local.get $lightnessOrWhite)) (local.get $blackness)))
                        (local.get $lightnessOrWhite)))
                    (local.set $index (i32.add (local.get $index) (i32.const 1)))
                    (br $hwbNext)))))))
        (call $set_encoding (i32.const 0) (i32.const 0) (f64.const 0) (local.get $form))
        (return (i32.const 0))))
    ;; lab(), lch(), oklab() and oklch() take an angle only as the hue of
    ;; lch() and oklch() (CSS Color 4 §8.2, §8.3, §9.2, §9.3).
    (if (i32.and (i32.ge_u (local.get $form) (i32.const 5)) (i32.le_u (local.get $form) (i32.const 8)))
      (then
        (if (i32.or (i32.eq (global.get $type0) (i32.const 2)) (i32.eq (global.get $type1) (i32.const 2)))
          (then (return (i32.const 3))))
        (if (i32.and (i32.eq (global.get $type2) (i32.const 2))
              (i32.or (i32.eq (local.get $form) (i32.const 5)) (i32.eq (local.get $form) (i32.const 7))))
          (then (return (i32.const 3))))))
    (if (i32.or (i32.eq (local.get $form) (i32.const 5)) (i32.eq (local.get $form) (i32.const 6)))
      (then ;; lab / lch: L percent -> 0..100; a,b percent -> +-125; chroma percent -> +-150.
        (call $scale_comp (i32.const 0) (global.get $type0) (f64.const 1) (f64.const 100))
        (if (i32.eq (local.get $form) (i32.const 5))
          (then
            (call $scale_comp (i32.const 1) (global.get $type1) (f64.const 1) (f64.const 125))
            (call $scale_comp (i32.const 2) (global.get $type2) (f64.const 1) (f64.const 125))
            (call $store_authored (call $load_comp (i32.const 0)) (call $load_comp (i32.const 1)) (call $load_comp (i32.const 2))))
          (else
            (call $scale_comp (i32.const 1) (global.get $type1) (f64.const 1) (f64.const 150))
            (call $store_authored (call $load_comp (i32.const 0)) (call $load_comp (i32.const 1))
              (call $normalize_hue (call $load_comp (i32.const 2))))
            (call $polar_to_rectangular)))
        (call $lab_comps_to_xyz_d65)
        (call $set_encoding (i32.const 6) (i32.const 1) (f64.const 0) (local.get $form))
        (return (i32.const 0))))
    (if (i32.or (i32.eq (local.get $form) (i32.const 7)) (i32.eq (local.get $form) (i32.const 8)))
      (then ;; oklab / oklch: L percent -> 0..1; a,b percent -> +-0.4.
        (call $scale_comp (i32.const 0) (global.get $type0) (f64.const 1) (f64.const 1))
        (if (i32.eq (local.get $form) (i32.const 7))
          (then
            (call $scale_comp (i32.const 1) (global.get $type1) (f64.const 1) (f64.const 0.4))
            (call $scale_comp (i32.const 2) (global.get $type2) (f64.const 1) (f64.const 0.4))
            (call $store_authored (call $load_comp (i32.const 0)) (call $load_comp (i32.const 1)) (call $load_comp (i32.const 2))))
          (else
            (call $scale_comp (i32.const 1) (global.get $type1) (f64.const 1) (f64.const 0.4))
            (call $store_authored (call $load_comp (i32.const 0)) (call $load_comp (i32.const 1))
              (call $normalize_hue (call $load_comp (i32.const 2))))
            (call $polar_to_rectangular)))
        (call $oklab_comps_to_xyz_d65)
        (call $set_encoding (i32.const 6) (i32.const 1) (f64.const 0) (local.get $form))
        (return (i32.const 0))))
    ;; color(): components are numbers or percents on the 0..1 scale.
    (if (i32.or (i32.eq (global.get $type0) (i32.const 2))
          (i32.or (i32.eq (global.get $type1) (i32.const 2)) (i32.eq (global.get $type2) (i32.const 2))))
      (then (return (i32.const 3))))
    (call $scale_comp (i32.const 0) (global.get $type0) (f64.const 1) (f64.const 1))
    (call $scale_comp (i32.const 1) (global.get $type1) (f64.const 1) (f64.const 1))
    (call $scale_comp (i32.const 2) (global.get $type2) (f64.const 1) (f64.const 1))
    (call $store_authored (call $load_comp (i32.const 0)) (call $load_comp (i32.const 1)) (call $load_comp (i32.const 2)))
    (call $set_encoding (local.get $primaries) (local.get $transfer) (local.get $gamma) (i32.const 9))
    (i32.const 0))

  ;; Complete the parser record in place. The parser itself writes the
  ;; authored missing mask for source-form inspection; converted Lab families
  ;; publish numeric components and therefore clear the consumer mask.
  (func $color_complete_css_result
    (local $form i32)
    (local $primaries i32)
    (local.set $form (i32.load (call $OUT_FORM)))
    (local.set $primaries (i32.load (call $OUT_PRIMARIES)))
    (if (i32.and (i32.ge_u (local.get $form) (i32.const 5))
      (i32.le_u (local.get $form) (i32.const 8)))
      (then (i32.store (call $OUT_MISSING) (i32.const 0))))
    (i32.store offset=64 (call $OUT_COMP)
      (select (i32.const 0) (i32.const 1)
        (i32.or (i32.eq (local.get $primaries) (i32.const 4))
          (i32.eq (local.get $primaries) (i32.const 5)))))
    (i32.store offset=68 (call $OUT_COMP) (i32.const 1))
    (f64.store offset=72 (call $OUT_COMP) (f64.const 203)))

  ;; Normalize ASCII case in the documented parser buffer. On success the
  ;; complete 80-byte tagged-color record begins at the documented result
  ;; offset; no host inference or preprocessing is needed.
  (func (export "color_parse_css") (param $length i32) (result i32)
    (local $status i32) (local $index i32) (local $byte i32)
    (if (i32.gt_u (local.get $length) (i32.const 2048))
      (then (return (i32.const 4))))
    (block $normalized
      (loop $normalize
        (br_if $normalized (i32.eq (local.get $index) (local.get $length)))
        (local.set $byte (i32.load8_u (i32.add (call $INPUT) (local.get $index))))
        (if (i32.and (i32.ge_u (local.get $byte) (i32.const 65))
          (i32.le_u (local.get $byte) (i32.const 90)))
          (then
            (i32.store8 (i32.add (call $INPUT) (local.get $index))
              (i32.add (local.get $byte) (i32.const 32)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $normalize)))
    (local.set $status (call $parse_css_color (local.get $length)))
    (if (i32.eqz (local.get $status)) (then (call $color_complete_css_result)))
    (local.get $status))

  ;; ------------------------------------------------------------------
  ;; CSS color interpolation (CSS Color 4 "Interpolation", CSS Color 5
  ;; color-mix()).
  ;;
  ;; An operand is a 40-byte record: 0 three f64 components in the
  ;; operand's space, 24 f64 alpha, 32 i32 missing mask (bits 0-2 the
  ;; components, bit 3 alpha), 36 i32 space. Spaces: 0 sRGB, 1 OKLab,
  ;; 2 Lab, 3 OKLCh, 4 LCh, 5 HSL, 6 HWB, and the predefined color()
  ;; spaces 7 srgb-linear, 8 display-p3, 9 display-p3-linear, 10 a98-rgb,
  ;; 11 prophoto-rgb, 12 rec2020, 13 xyz-d50, 14 xyz-d65. Spaces 0 to 6
  ;; are interpolation spaces; a predefined space is an operand's authored
  ;; space only. Units: sRGB 0..1 (extended); Lab-family L, a, b;
  ;; LCh-family L, C, hue degrees; HSL hue degrees, saturation and
  ;; lightness as fractions; HWB hue, whiteness and blackness as
  ;; fractions; a predefined space its color() components. A missing
  ;; component and missing alpha store zero.
  ;;
  ;; Conversion follows CSS Color 4 §11.2 and §13.4 in double precision
  ;; with the kernel's matrices and transfer functions (the sample code of
  ;; §19). Before a conversion into another space, the source's powerless
  ;; components become missing (§4.4.1): an HSL hue at a saturation of
  ;; 0.001% or less, an HWB hue at a whiteness and blackness that sum to
  ;; 99.999% or more, an LCh hue at a chroma of 0.0015 or less and an
  ;; OKLCh hue at a chroma of 0.000004 or less; the chroma or saturation
  ;; becomes zero and an HWB's whiteness or blackness completes the sum to
  ;; 100%. Missing components then count as zero; a polar form converts
  ;; to its rectangular form, a rectangular form to another through XYZ
  ;; D65, and a polar destination gets the same powerless rules. Missing
  ;; components carry forward into analogous components, and a fully
  ;; missing set of the components without analogues carries into the
  ;; destination's set (§13.4). Interpolation substitutes a component
  ;; missing from one operand, premultiplies every component but hue, and
  ;; offers the four hue interpolation methods (§13.5).
  ;; ------------------------------------------------------------------

  (func $mix_operand_valid (param $operand i32) (result i32)
    (i32.and (i32.eqz (i32.and (local.get $operand) (i32.const 7)))
      (call $color_memory_span (local.get $operand) (global.get $COLOR_MIX_OPERAND_SIZE))))

  ;; The space of an authored CSS form: hex and rgb() enter as sRGB;
  ;; color() is resolved by $mix_color_function_space.
  (func $mix_form_space (param $form i32) (result i32)
    (if (i32.eq (local.get $form) (i32.const 3)) (then (return (i32.const 5))))
    (if (i32.eq (local.get $form) (i32.const 4)) (then (return (i32.const 6))))
    (if (i32.eq (local.get $form) (i32.const 5)) (then (return (i32.const 2))))
    (if (i32.eq (local.get $form) (i32.const 6)) (then (return (i32.const 4))))
    (if (i32.eq (local.get $form) (i32.const 7)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $form) (i32.const 8)) (then (return (i32.const 3))))
    (i32.const 0))

  ;; The predefined space of a color() with these primaries and transfer,
  ;; or -1 for the other spaces of the parser (rec2100-pq, rec2100-hlg,
  ;; rec2100-linear). rec2020 has the gamma 2.4 transfer.
  (func $mix_color_function_space (param $primaries i32) (param $transfer i32) (result i32)
    (local $key i32)
    (local.set $key (i32.or (i32.shl (local.get $primaries) (i32.const 4)) (local.get $transfer)))
    (if (i32.eqz (local.get $key)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $key) (i32.const 0x01)) (then (return (i32.const 7))))
    (if (i32.eq (local.get $key) (i32.const 0x10)) (then (return (i32.const 8))))
    (if (i32.eq (local.get $key) (i32.const 0x11)) (then (return (i32.const 9))))
    (if (i32.eq (local.get $key) (i32.const 0x32)) (then (return (i32.const 10))))
    (if (i32.eq (local.get $key) (i32.const 0x46)) (then (return (i32.const 11))))
    (if (i32.eq (local.get $key) (i32.const 0x22)) (then (return (i32.const 12))))
    (if (i32.eq (local.get $key) (i32.const 0x51)) (then (return (i32.const 13))))
    (if (i32.eq (local.get $key) (i32.const 0x61)) (then (return (i32.const 14))))
    (i32.const -1))

  ;; The hue component index of a space, or -1.
  (func $mix_hue_index (param $space i32) (result i32)
    (if (i32.ge_u (local.get $space) (i32.const 7)) (then (return (i32.const -1))))
    (if (i32.ge_u (local.get $space) (i32.const 5)) (then (return (i32.const 0))))
    (if (i32.ge_u (local.get $space) (i32.const 3)) (then (return (i32.const 2))))
    (i32.const -1))

  ;; fdlibm arctangent, then the quadrant of atan2.
  (func $atan (param $x f64) (result f64)
    (local $ax f64) (local $id i32) (local $z f64) (local $w f64) (local $s1 f64) (local $s2 f64)
    (local $hi f64) (local $lo f64)
    (local.set $ax (f64.abs (local.get $x)))
    (if (f64.ge (local.get $ax) (f64.const 0x1p66))
      (then (return (f64.copysign (f64.const 1.5707963267948966) (local.get $x)))))
    (local.set $id (i32.const -1))
    (if (f64.ge (local.get $ax) (f64.const 0.4375))
      (then
        (if (f64.lt (local.get $ax) (f64.const 1.1875))
          (then
            (if (f64.lt (local.get $ax) (f64.const 0.6875))
              (then
                (local.set $id (i32.const 0))
                (local.set $ax (f64.div (f64.sub (f64.mul (f64.const 2) (local.get $ax)) (f64.const 1))
                  (f64.add (f64.const 2) (local.get $ax)))))
              (else
                (local.set $id (i32.const 1))
                (local.set $ax (f64.div (f64.sub (local.get $ax) (f64.const 1)) (f64.add (local.get $ax) (f64.const 1)))))))
          (else
            (if (f64.lt (local.get $ax) (f64.const 2.4375))
              (then
                (local.set $id (i32.const 2))
                (local.set $ax (f64.div (f64.sub (local.get $ax) (f64.const 1.5))
                  (f64.add (f64.const 1) (f64.mul (f64.const 1.5) (local.get $ax))))))
              (else
                (local.set $id (i32.const 3))
                (local.set $ax (f64.div (f64.const -1) (local.get $ax)))))))))
    (if (i32.lt_s (local.get $id) (i32.const 0))
      (then (local.set $ax (local.get $x))))
    (local.set $z (f64.mul (local.get $ax) (local.get $ax)))
    (local.set $w (f64.mul (local.get $z) (local.get $z)))
    (local.set $s1
      (f64.mul (local.get $z)
        (f64.add (f64.const 3.33333333333329318027e-01)
          (f64.mul (local.get $w)
            (f64.add (f64.const 1.42857142725034663711e-01)
              (f64.mul (local.get $w)
                (f64.add (f64.const 9.09088713343650656196e-02)
                  (f64.mul (local.get $w)
                    (f64.add (f64.const 6.66107313738753120669e-02)
                      (f64.mul (local.get $w)
                        (f64.add (f64.const 4.97687799461593236017e-02)
                          (f64.mul (local.get $w) (f64.const 1.62858201153657823623e-02)))))))))))))
    (local.set $s2
      (f64.mul (local.get $w)
        (f64.add (f64.const -1.99999999998764832476e-01)
          (f64.mul (local.get $w)
            (f64.add (f64.const -1.11111104054623557880e-01)
              (f64.mul (local.get $w)
                (f64.add (f64.const -7.69187620504482999495e-02)
                  (f64.mul (local.get $w)
                    (f64.add (f64.const -5.83357013379057348645e-02)
                      (f64.mul (local.get $w) (f64.const -3.65315727442169155270e-02)))))))))))
    (if (i32.lt_s (local.get $id) (i32.const 0))
      (then
        (return (f64.sub (local.get $ax)
          (f64.mul (local.get $ax) (f64.add (local.get $s1) (local.get $s2)))))))
    (local.set $hi
      (select (f64.const 4.63647609000806093515e-01)
        (select (f64.const 7.85398163397448278999e-01)
          (select (f64.const 9.82793723247329054082e-01) (f64.const 1.57079632679489655800e+00)
            (i32.eq (local.get $id) (i32.const 2)))
          (i32.eq (local.get $id) (i32.const 1)))
        (i32.eqz (local.get $id))))
    (local.set $lo
      (select (f64.const 2.26987774529616870924e-17)
        (select (f64.const 3.06161699786838301793e-17)
          (select (f64.const 1.39033110312309984516e-17) (f64.const 6.12323399573676603587e-17)
            (i32.eq (local.get $id) (i32.const 2)))
          (i32.eq (local.get $id) (i32.const 1)))
        (i32.eqz (local.get $id))))
    (local.set $z
      (f64.sub (local.get $hi)
        (f64.sub
          (f64.sub (f64.mul (local.get $ax) (f64.add (local.get $s1) (local.get $s2))) (local.get $lo))
          (local.get $ax))))
    (f64.copysign (local.get $z) (local.get $x)))

  ;; atan2(y, x) in radians, with C's signed-zero quadrants.
  (func $atan2 (param $y f64) (param $x f64) (result f64)
    (if (f64.eq (local.get $x) (f64.const 0))
      (then
        (if (f64.ne (local.get $y) (f64.const 0))
          (then (return (f64.copysign (f64.const 1.5707963267948966) (local.get $y)))))
        (if (i64.lt_s (i64.reinterpret_f64 (local.get $x)) (i64.const 0))
          (then (return (f64.copysign (f64.const 3.141592653589793) (local.get $y)))))
        (return (local.get $y))))
    (if (f64.gt (local.get $x) (f64.const 0))
      (then (return (call $atan (f64.div (local.get $y) (local.get $x))))))
    (f64.add (call $atan (f64.div (local.get $y) (local.get $x)))
      (f64.copysign (f64.const 3.141592653589793) (local.get $y))))

  ;; The primaries code ($primaries_to_xyz_d65) of sRGB (0) or of a
  ;; predefined space (7 to 14).
  (func $mix_primaries (param $space i32) (result i32)
    (if (i32.or (i32.eqz (local.get $space)) (i32.eq (local.get $space) (i32.const 7)))
      (then (return (i32.const 0))))
    (if (i32.le_u (local.get $space) (i32.const 9)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $space) (i32.const 10)) (then (return (i32.const 3))))
    (if (i32.eq (local.get $space) (i32.const 11)) (then (return (i32.const 4))))
    (if (i32.eq (local.get $space) (i32.const 12)) (then (return (i32.const 2))))
    ;; xyz-d50 (13) and xyz-d65 (14).
    (i32.sub (local.get $space) (i32.const 8)))

  ;; The transfer function of sRGB or a predefined space, from encoded to
  ;; linear light: sRGB's for sRGB and display-p3, gamma 563/256 for
  ;; a98-rgb, ProPhoto's, gamma 2.4 for rec2020 (BT.1886), none for the
  ;; linear spaces.
  (func $mix_decode (param $space i32) (param $value f64) (result f64)
    (if (i32.or (i32.eqz (local.get $space)) (i32.eq (local.get $space) (i32.const 8)))
      (then (return (call $srgb_decode (local.get $value)))))
    (if (i32.eq (local.get $space) (i32.const 10))
      (then (return (call $gamma_decode (local.get $value) (f64.div (f64.const 563) (f64.const 256))))))
    (if (i32.eq (local.get $space) (i32.const 11)) (then (return (call $prophoto_decode (local.get $value)))))
    (if (i32.eq (local.get $space) (i32.const 12))
      (then (return (call $gamma_decode (local.get $value) (f64.const 2.4)))))
    (local.get $value))

  (func $mix_encode (param $space i32) (param $value f64) (result f64)
    (if (i32.or (i32.eqz (local.get $space)) (i32.eq (local.get $space) (i32.const 8)))
      (then (return (call $srgb_encode (local.get $value)))))
    (if (i32.eq (local.get $space) (i32.const 10))
      (then (return (call $gamma_encode (local.get $value) (f64.div (f64.const 563) (f64.const 256))))))
    (if (i32.eq (local.get $space) (i32.const 11)) (then (return (call $prophoto_encode (local.get $value)))))
    (if (i32.eq (local.get $space) (i32.const 12))
      (then (return (call $gamma_encode (local.get $value) (f64.const 2.4)))))
    (local.get $value))

  ;; The rectangular form of a space: OKLab for OKLCh, Lab for LCh, sRGB
  ;; for HSL and HWB, the space itself otherwise.
  (func $mix_rectangular (param $space i32) (result i32)
    (if (i32.eq (local.get $space) (i32.const 3)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $space) (i32.const 4)) (then (return (i32.const 2))))
    (if (i32.or (i32.eq (local.get $space) (i32.const 5)) (i32.eq (local.get $space) (i32.const 6)))
      (then (return (i32.const 0))))
    (local.get $space))

  ;; VEC in a rectangular space into XYZ D65.
  (func $mix_rectangular_to_xyz_d65 (param $space i32)
    (if (i32.eq (local.get $space) (i32.const 1)) (then (call $oklab_to_xyz_d65) (return)))
    (if (i32.eq (local.get $space) (i32.const 2))
      (then (call $lab_to_xyz_d50) (call $apply_matrix (i32.const 10)) (return)))
    (call $store_vec (call $VEC)
      (call $mix_decode (local.get $space) (call $load0 (call $VEC)))
      (call $mix_decode (local.get $space) (call $load1 (call $VEC)))
      (call $mix_decode (local.get $space) (call $load2 (call $VEC))))
    (call $primaries_to_xyz_d65 (call $mix_primaries (local.get $space)) (call $VEC)))

  ;; VEC in XYZ D65 into a rectangular space.
  (func $mix_xyz_d65_to_rectangular (param $space i32)
    (local $primaries i32)
    (if (i32.eq (local.get $space) (i32.const 1)) (then (call $xyz_d65_to_oklab) (return)))
    (if (i32.eq (local.get $space) (i32.const 2))
      (then (call $apply_matrix (i32.const 11)) (call $xyz_d50_to_lab) (return)))
    (local.set $primaries (call $mix_primaries (local.get $space)))
    (if (i32.eq (local.get $primaries) (i32.const 5)) (then (call $apply_matrix (i32.const 11))))
    (if (i32.lt_u (local.get $primaries) (i32.const 5))
      (then (call $primaries_from_xyz_d65 (local.get $primaries) (call $VEC))))
    (call $store_vec (call $VEC)
      (call $mix_encode (local.get $space) (call $load0 (call $VEC)))
      (call $mix_encode (local.get $space) (call $load1 (call $VEC)))
      (call $mix_encode (local.get $space) (call $load2 (call $VEC)))))

  ;; A hue in degrees in [0, 360).
  (func $mix_unit_degrees (param $hue f64) (result f64)
    (local.set $hue
      (f64.sub (local.get $hue) (f64.mul (f64.const 360) (f64.floor (f64.div (local.get $hue) (f64.const 360))))))
    (select (f64.const 0) (local.get $hue) (f64.ge (local.get $hue) (f64.const 360))))

  ;; VEC in a polar space (OKLCh, LCh, HSL, HWB) into its rectangular
  ;; form: LCH_to_Lab, hslToRgb and hwbToRgb of CSS Color 4 §19, with
  ;; saturation, whiteness and blackness as fractions.
  (func $mix_polar_to_rectangular (param $space i32)
    (local $c0 f64) (local $c1 f64) (local $c2 f64) (local $radians f64) (local $sum f64)
    (local $remainder f64)
    (local.set $c0 (call $load0 (call $VEC)))
    (local.set $c1 (call $load1 (call $VEC)))
    (local.set $c2 (call $load2 (call $VEC)))
    (if (i32.or (i32.eq (local.get $space) (i32.const 3)) (i32.eq (local.get $space) (i32.const 4)))
      (then
        (local.set $radians
          (f64.mul (call $mix_unit_degrees (local.get $c2)) (f64.div (f64.const 3.141592653589793) (f64.const 180))))
        (call $store_vec (call $VEC) (local.get $c0)
          (f64.mul (local.get $c1) (call $cos (local.get $radians)))
          (f64.mul (local.get $c1) (call $sin (local.get $radians))))
        (return)))
    (if (i32.eq (local.get $space) (i32.const 5))
      (then
        (call $store_vec (call $VEC)
          (call $hsl_f (f64.const 0) (local.get $c0) (local.get $c1) (local.get $c2))
          (call $hsl_f (f64.const 8) (local.get $c0) (local.get $c1) (local.get $c2))
          (call $hsl_f (f64.const 4) (local.get $c0) (local.get $c1) (local.get $c2)))
        (return)))
    (if (i32.eq (local.get $space) (i32.const 6))
      (then
        (local.set $sum (f64.add (local.get $c1) (local.get $c2)))
        (if (f64.ge (local.get $sum) (f64.const 1))
          (then
            (local.set $sum (f64.div (local.get $c1) (local.get $sum)))
            (call $store_vec (call $VEC) (local.get $sum) (local.get $sum) (local.get $sum))
            (return)))
        (local.set $remainder (f64.sub (f64.sub (f64.const 1) (local.get $c1)) (local.get $c2)))
        (call $store_vec (call $VEC)
          (f64.add (f64.mul (call $hsl_f (f64.const 0) (local.get $c0) (f64.const 1) (f64.const 0.5)) (local.get $remainder))
            (local.get $c1))
          (f64.add (f64.mul (call $hsl_f (f64.const 8) (local.get $c0) (f64.const 1) (f64.const 0.5)) (local.get $remainder))
            (local.get $c1))
          (f64.add (f64.mul (call $hsl_f (f64.const 4) (local.get $c0) (f64.const 1) (f64.const 0.5)) (local.get $remainder))
            (local.get $c1))))))

  ;; VEC in the rectangular form of a polar space into that space:
  ;; Lab_to_LCH, OKLab_to_OKLCH, rgbToHsl and rgbToHwb of CSS Color 4 §19.
  ;; A powerless hue becomes missing with its chroma or saturation zero,
  ;; and an HWB blackness completes the sum to one (§4.4.1). Returns the
  ;; missing bit of the hue, or 0.
  (func $mix_rectangular_to_polar (param $space i32) (result i32)
    (local $c0 f64) (local $c1 f64) (local $c2 f64) (local $chroma f64) (local $hue f64)
    (local $max f64) (local $min f64) (local $difference f64) (local $light f64) (local $saturation f64)
    (local $white f64) (local $black f64) (local $hueMissing i32)
    (local.set $c0 (call $load0 (call $VEC)))
    (local.set $c1 (call $load1 (call $VEC)))
    (local.set $c2 (call $load2 (call $VEC)))
    (if (i32.or (i32.eq (local.get $space) (i32.const 3)) (i32.eq (local.get $space) (i32.const 4)))
      (then
        (local.set $chroma
          (f64.sqrt (f64.add (f64.mul (local.get $c1) (local.get $c1)) (f64.mul (local.get $c2) (local.get $c2)))))
        (if (f64.le (local.get $chroma)
            (select (f64.const 0.000004) (f64.const 0.0015) (i32.eq (local.get $space) (i32.const 3))))
          (then
            (call $store_vec (call $VEC) (local.get $c0) (f64.const 0) (f64.const 0))
            (return (i32.const 4))))
        (call $store_vec (call $VEC) (local.get $c0) (local.get $chroma)
          (call $mix_unit_degrees
            (f64.mul (call $atan2 (local.get $c2) (local.get $c1)) (f64.div (f64.const 180) (f64.const 3.141592653589793)))))
        (return (i32.const 0))))
    ;; rgbToHue.
    (local.set $max (f64.max (f64.max (local.get $c0) (local.get $c1)) (local.get $c2)))
    (local.set $min (f64.min (f64.min (local.get $c0) (local.get $c1)) (local.get $c2)))
    (local.set $difference (f64.sub (local.get $max) (local.get $min)))
    (local.set $hueMissing (f64.eq (local.get $difference) (f64.const 0)))
    (if (i32.eqz (local.get $hueMissing))
      (then
        (if (f64.eq (local.get $max) (local.get $c0))
          (then
            (local.set $hue
              (f64.add (f64.div (f64.sub (local.get $c1) (local.get $c2)) (local.get $difference))
                (select (f64.const 6) (f64.const 0) (f64.lt (local.get $c1) (local.get $c2))))))
          (else
            (if (f64.eq (local.get $max) (local.get $c1))
              (then
                (local.set $hue
                  (f64.add (f64.div (f64.sub (local.get $c2) (local.get $c0)) (local.get $difference)) (f64.const 2))))
              (else
                (local.set $hue
                  (f64.add (f64.div (f64.sub (local.get $c0) (local.get $c1)) (local.get $difference)) (f64.const 4)))))))
        (local.set $hue (f64.mul (local.get $hue) (f64.const 60)))))
    (if (i32.eq (local.get $space) (i32.const 5))
      (then
        (local.set $light (f64.div (f64.add (local.get $min) (local.get $max)) (f64.const 2)))
        (if (i32.eqz (local.get $hueMissing))
          (then
            (if (i32.eqz
                (i32.or (f64.le (f64.abs (local.get $light)) (f64.const 0.00001))
                  (f64.lt (f64.abs (f64.sub (f64.const 1) (local.get $light))) (f64.const 0.00001))))
              (then
                (local.set $saturation
                  (f64.div (f64.sub (local.get $max) (local.get $light))
                    (f64.min (local.get $light) (f64.sub (f64.const 1) (local.get $light)))))))))
        ;; A color far outside sRGB can have a negative saturation: the hue
        ;; turns half a circle instead.
        (if (f64.lt (local.get $saturation) (f64.const 0))
          (then
            (local.set $hue (f64.add (local.get $hue) (f64.const 180)))
            (local.set $saturation (f64.abs (local.get $saturation)))))
        (if (f64.le (local.get $saturation) (f64.const 0.00001))
          (then
            (local.set $hueMissing (i32.const 1))
            (local.set $saturation (f64.const 0))))
        (call $store_vec (call $VEC)
          (select (f64.const 0) (call $mix_unit_degrees (local.get $hue)) (local.get $hueMissing))
          (local.get $saturation) (local.get $light))
        (return (local.get $hueMissing))))
    (local.set $white (local.get $min))
    (local.set $black (f64.sub (f64.const 1) (local.get $max)))
    (if (f64.ge (f64.add (local.get $white) (local.get $black)) (f64.const 0.99999))
      (then
        (local.set $hueMissing (i32.const 1))
        (if (f64.lt (f64.add (local.get $white) (local.get $black)) (f64.const 1))
          (then (local.set $black (f64.sub (f64.const 1) (local.get $white)))))))
    (call $store_vec (call $VEC)
      (select (f64.const 0) (call $mix_unit_degrees (local.get $hue)) (local.get $hueMissing))
      (local.get $white) (local.get $black))
    (local.get $hueMissing))

  ;; The powerless components of VEC in $space, whose missing components
  ;; ($mask) are zero, become missing before a conversion (CSS Color 4
  ;; §4.4.1, powerlessToMissing of §19): returns the bit of the newly
  ;; missing hue and adjusts the chroma, saturation, whiteness or
  ;; blackness in VEC. HSL and HWB compare in percent, as the ε of §7 and
  ;; §8 are written, so that an authored 99.999% reaches its ε.
  (func $mix_powerless_to_missing (param $space i32) (param $mask i32) (result i32)
    (local $c1 f64) (local $c2 f64) (local $sum f64)
    (local.set $c1 (call $load1 (call $VEC)))
    (local.set $c2 (call $load2 (call $VEC)))
    (if (i32.or (i32.eq (local.get $space) (i32.const 3)) (i32.eq (local.get $space) (i32.const 4)))
      (then
        (if (f64.gt (local.get $c1)
            (select (f64.const 0.000004) (f64.const 0.0015) (i32.eq (local.get $space) (i32.const 3))))
          (then (return (i32.const 0))))
        (if (f64.gt (local.get $c1) (f64.const 0)) (then (f64.store offset=8 (call $VEC) (f64.const 0))))
        (f64.store offset=16 (call $VEC) (f64.const 0))
        (return (i32.const 4))))
    (if (i32.eq (local.get $space) (i32.const 5))
      (then
        (if (f64.gt (f64.mul (local.get $c1) (f64.const 100)) (f64.const 0.001)) (then (return (i32.const 0))))
        (if (f64.gt (local.get $c1) (f64.const 0)) (then (f64.store offset=8 (call $VEC) (f64.const 0))))
        (f64.store (call $VEC) (f64.const 0))
        (return (i32.const 1))))
    (if (i32.eq (local.get $space) (i32.const 6))
      (then
        (local.set $sum (f64.mul (f64.add (local.get $c1) (local.get $c2)) (f64.const 100)))
        (if (f64.lt (local.get $sum) (f64.const 99.999)) (then (return (i32.const 0))))
        (if (f64.lt (local.get $sum) (f64.const 100))
          (then
            (if (i32.and (local.get $mask) (i32.const 2))
              (then (f64.store offset=16 (call $VEC) (f64.const 1)))
              (else
                (if (i32.and (local.get $mask) (i32.const 4))
                  (then (f64.store offset=8 (call $VEC) (f64.const 1)))
                  (else (f64.store offset=16 (call $VEC) (f64.sub (f64.const 1) (local.get $c1)))))))))
        (f64.store (call $VEC) (f64.const 0))
        (return (i32.const 1))))
    (i32.const 0))

  ;; The analogous-component category of each component of a space (CSS
  ;; Color 4 §13.4), four bits per component: 1 red, 2 green, 3 blue,
  ;; 4 lightness, 5 colorfulness, 6 hue, 7 opponent a, 8 opponent b, 0 none
  ;; (HWB whiteness and blackness). The predefined spaces are RGB spaces,
  ;; the XYZ spaces among them as super-saturated RGB.
  (func $mix_categories (param $space i32) (result i32)
    (if (i32.or (i32.eqz (local.get $space)) (i32.ge_u (local.get $space) (i32.const 7)))
      (then (return (i32.const 0x321))))
    (if (i32.le_u (local.get $space) (i32.const 2)) (then (return (i32.const 0x874))))
    (if (i32.le_u (local.get $space) (i32.const 4)) (then (return (i32.const 0x654))))
    (if (i32.eq (local.get $space) (i32.const 5)) (then (return (i32.const 0x456))))
    (i32.const 0x006))

  ;; Whether the category $category (non-zero) is among the three of
  ;; $categories.
  (func $mix_has_category (param $categories i32) (param $category i32) (result i32)
    (i32.and (i32.ne (local.get $category) (i32.const 0))
      (i32.or
        (i32.or
          (i32.eq (i32.and (local.get $categories) (i32.const 15)) (local.get $category))
          (i32.eq (i32.and (i32.shr_u (local.get $categories) (i32.const 4)) (i32.const 15)) (local.get $category)))
        (i32.eq (i32.and (i32.shr_u (local.get $categories) (i32.const 8)) (i32.const 15)) (local.get $category)))))

  ;; Missing components of a source in $from that carry forward into $to
  ;; (CSS Color 4 §13.4): each missing component with an analogue lands on
  ;; it; when every component of $from without an analogue in $to is
  ;; missing, so is every component of $to without an analogue in $from.
  (func $mix_analogous (param $from i32) (param $mask i32) (param $to i32) (result i32)
    (local $source i32) (local $target i32) (local $index i32) (local $other i32)
    (local $category i32) (local $carried i32) (local $sourceRest i32) (local $targetRest i32)
    (local.set $source (call $mix_categories (local.get $from)))
    (local.set $target (call $mix_categories (local.get $to)))
    (loop $components
      (local.set $category
        (i32.and (i32.shr_u (local.get $source) (i32.shl (local.get $index) (i32.const 2))) (i32.const 15)))
      (if (call $mix_has_category (local.get $target) (local.get $category))
        (then
          (if (i32.and (local.get $mask) (i32.shl (i32.const 1) (local.get $index)))
            (then
              (local.set $other (i32.const 0))
              (loop $targets
                (if (i32.eq (local.get $category)
                    (i32.and (i32.shr_u (local.get $target) (i32.shl (local.get $other) (i32.const 2))) (i32.const 15)))
                  (then
                    (local.set $carried (i32.or (local.get $carried) (i32.shl (i32.const 1) (local.get $other))))))
                (local.set $other (i32.add (local.get $other) (i32.const 1)))
                (br_if $targets (i32.lt_u (local.get $other) (i32.const 3)))))))
        (else (local.set $sourceRest (i32.or (local.get $sourceRest) (i32.shl (i32.const 1) (local.get $index))))))
      (if (i32.eqz (call $mix_has_category (local.get $source)
          (i32.and (i32.shr_u (local.get $target) (i32.shl (local.get $index) (i32.const 2))) (i32.const 15))))
        (then (local.set $targetRest (i32.or (local.get $targetRest) (i32.shl (i32.const 1) (local.get $index))))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br_if $components (i32.lt_u (local.get $index) (i32.const 3))))
    (if (i32.and (i32.ne (local.get $sourceRest) (i32.const 0))
        (i32.eq (i32.and (local.get $mask) (local.get $sourceRest)) (local.get $sourceRest)))
      (then (local.set $carried (i32.or (local.get $carried) (local.get $targetRest)))))
    (local.get $carried))

  ;; Load an operand's components into VEC with missing components zero.
  (func $mix_load_resolved (param $operand i32)
    (local $mask i32)
    (local.set $mask (i32.load offset=32 (local.get $operand)))
    (call $store_vec (call $VEC)
      (select (f64.const 0) (f64.load (local.get $operand)) (i32.and (local.get $mask) (i32.const 1)))
      (select (f64.const 0) (f64.load offset=8 (local.get $operand)) (i32.and (local.get $mask) (i32.const 2)))
      (select (f64.const 0) (f64.load offset=16 (local.get $operand)) (i32.and (local.get $mask) (i32.const 4)))))

  ;; Store an operand, zeroing the missing components and alpha.
  (func $mix_store_record
    (param $operand i32) (param $space i32) (param $c0 f64) (param $c1 f64) (param $c2 f64)
    (param $alpha f64) (param $mask i32)
    (f64.store (local.get $operand)
      (select (f64.const 0) (local.get $c0) (i32.and (local.get $mask) (i32.const 1))))
    (f64.store offset=8 (local.get $operand)
      (select (f64.const 0) (local.get $c1) (i32.and (local.get $mask) (i32.const 2))))
    (f64.store offset=16 (local.get $operand)
      (select (f64.const 0) (local.get $c2) (i32.and (local.get $mask) (i32.const 4))))
    (f64.store offset=24 (local.get $operand)
      (select (f64.const 0) (local.get $alpha) (i32.and (local.get $mask) (i32.const 8))))
    (i32.store offset=32 (local.get $operand) (local.get $mask))
    (i32.store offset=36 (local.get $operand) (local.get $space)))

  ;; Store an authored operand: the lightness of Lab, OKLab, LCh and OKLCh
  ;; and the chroma of LCh and OKLCh clamped as parsing clamps them (CSS
  ;; Color 4 §9), alpha clamped to [0, 1].
  (func $mix_store
    (param $operand i32) (param $space i32) (param $c0 f64) (param $c1 f64) (param $c2 f64)
    (param $alpha f64) (param $mask i32)
    (if (i32.and (i32.ge_u (local.get $space) (i32.const 1)) (i32.le_u (local.get $space) (i32.const 4)))
      (then
        (local.set $c0
          (f64.max (f64.const 0)
            (f64.min (local.get $c0)
              (select (f64.const 100) (f64.const 1)
                (i32.or (i32.eq (local.get $space) (i32.const 2)) (i32.eq (local.get $space) (i32.const 4)))))))))
    (if (i32.ge_u (local.get $space) (i32.const 3))
      (then (if (i32.le_u (local.get $space) (i32.const 4))
        (then (local.set $c1 (f64.max (f64.const 0) (local.get $c1)))))))
    (call $mix_store_record (local.get $operand) (local.get $space)
      (local.get $c0) (local.get $c1) (local.get $c2)
      (f64.max (f64.const 0) (f64.min (f64.const 1) (local.get $alpha))) (local.get $mask)))

  ;; The operand of the last successful CSS parse, in its authored form's
  ;; space: color() stays in its predefined space. Another color() space
  ;; enters as extended sRGB, whose missing components stay analogous to
  ;; its own.
  (func $color_mix_operand_from_parse (export "color_mix_operand_from_parse") (param $operand i32) (result i32)
    (local $form i32) (local $space i32) (local $mask i32)
    (call $color_begin)
    (if (i32.eqz (call $mix_operand_valid (local.get $operand)))
      (then (return (call $color_reject (global.get $COLOR_ERROR_SPAN_DIMENSIONS) (i32.const 0)))))
    (local.set $form (i32.load (call $OUT_FORM)))
    (local.set $mask
      (i32.or (i32.and (i32.load (call $OUT_AUTHORED_MISSING)) (i32.const 7))
        (select (i32.const 8) (i32.const 0) (i32.load (call $OUT_ALPHA_MISSING)))))
    (call $copy_vec (call $OUT_AUTHORED) (call $VEC))
    (local.set $space (call $mix_form_space (local.get $form)))
    (if (i32.eq (local.get $form) (i32.const 9))
      (then
        (local.set $space
          (call $mix_color_function_space (i32.load (call $OUT_PRIMARIES)) (i32.load (call $OUT_TRANSFER))))
        (if (i32.lt_s (local.get $space) (i32.const 0))
          (then
            (drop
              (call $color_convert_tagged_to_standard
                (i32.load (call $OUT_PRIMARIES)) (i32.load (call $OUT_TRANSFER))
                (f64.load (call $OUT_GAMMA)) (i32.and (local.get $mask) (i32.const 7))))
            (local.set $space (i32.const 0))))))
    (call $mix_store (local.get $operand) (local.get $space)
      (call $load0 (call $VEC)) (call $load1 (call $VEC)) (call $load2 (call $VEC))
      (f64.load (call $OUT_ALPHA)) (local.get $mask))
    (i32.const 1))

  ;; An opaque or translucent sRGB operand with no missing component: a
  ;; named color, transparent, or a resolved currentcolor.
  (func $color_mix_operand_from_srgb (export "color_mix_operand_from_srgb")
    (param $operand i32) (param $r f64) (param $g f64) (param $b f64) (param $alpha f64) (result i32)
    (call $color_begin)
    (if (i32.eqz (call $mix_operand_valid (local.get $operand)))
      (then (return (call $color_reject (global.get $COLOR_ERROR_SPAN_DIMENSIONS) (i32.const 0)))))
    (call $mix_store (local.get $operand) (i32.const 0)
      (local.get $r) (local.get $g) (local.get $b) (local.get $alpha) (i32.const 0))
    (i32.const 1))

  ;; Convert an operand into an interpolation space (0 to 14) from any
  ;; operand space (CSS Color 4 §11.2, §13.4). $source and $destination
  ;; may be the same record.
  (func $color_mix_convert (export "color_mix_convert")
    (param $source i32) (param $space i32) (param $destination i32) (result i32)
    (local $from i32) (local $mask i32) (local $carried i32) (local $alpha f64)
    (local $fromRectangular i32) (local $toRectangular i32)
    (call $color_begin)
    (if (i32.eqz (call $mix_operand_valid (local.get $source)))
      (then (return (call $color_reject (global.get $COLOR_ERROR_SPAN_DIMENSIONS) (i32.const 0)))))
    (if (i32.gt_u (local.get $space) (i32.const 14))
      (then (return (call $color_reject (global.get $COLOR_ERROR_ENUM_VERSION) (i32.const 1)))))
    (if (i32.eqz (call $mix_operand_valid (local.get $destination)))
      (then (return (call $color_reject (global.get $COLOR_ERROR_SPAN_DIMENSIONS) (i32.const 2)))))
    (local.set $from (i32.load offset=36 (local.get $source)))
    (if (i32.gt_u (local.get $from) (i32.const 14))
      (then (return (call $color_reject (global.get $COLOR_ERROR_ENUM_VERSION) (i32.const 0)))))
    (local.set $mask (i32.load offset=32 (local.get $source)))
    (if (i32.eq (local.get $from) (local.get $space))
      (then
        (memory.copy (local.get $destination) (local.get $source) (global.get $COLOR_MIX_OPERAND_SIZE))
        (return (i32.const 1))))
    (local.set $alpha (f64.load offset=24 (local.get $source)))
    (call $mix_load_resolved (local.get $source))
    (local.set $mask
      (i32.or (local.get $mask) (call $mix_powerless_to_missing (local.get $from) (local.get $mask))))
    (local.set $carried (call $mix_analogous (local.get $from) (local.get $mask) (local.get $space)))
    (local.set $fromRectangular (call $mix_rectangular (local.get $from)))
    (local.set $toRectangular (call $mix_rectangular (local.get $space)))
    (if (i32.ne (local.get $fromRectangular) (local.get $from))
      (then (call $mix_polar_to_rectangular (local.get $from))))
    (if (i32.ne (local.get $fromRectangular) (local.get $toRectangular))
      (then
        (call $mix_rectangular_to_xyz_d65 (local.get $fromRectangular))
        (call $mix_xyz_d65_to_rectangular (local.get $toRectangular))))
    (if (i32.ne (local.get $toRectangular) (local.get $space))
      (then
        (local.set $carried
          (i32.or (local.get $carried) (call $mix_rectangular_to_polar (local.get $space))))))
    (call $mix_store_record (local.get $destination) (local.get $space)
      (call $load0 (call $VEC)) (call $load1 (call $VEC)) (call $load2 (call $VEC))
      (local.get $alpha) (i32.or (local.get $carried) (i32.and (local.get $mask) (i32.const 8))))
    (i32.const 1))

  ;; Interpolate a hue by one of the four methods (0 shorter, 1 longer,
  ;; 2 increasing, 3 decreasing) of CSS Color 4 §13.5, the result in
  ;; [0, 360).
  (func $mix_hue (param $from f64) (param $to f64) (param $progress f64) (param $method i32) (result f64)
    (local $difference f64)
    (local.set $difference (f64.sub (local.get $to) (local.get $from)))
    (if (i32.eqz (local.get $method))
      (then
        (if (f64.gt (local.get $difference) (f64.const 180))
          (then (local.set $from (f64.add (local.get $from) (f64.const 360))))
          (else
            (if (f64.lt (local.get $difference) (f64.const -180))
              (then (local.set $to (f64.add (local.get $to) (f64.const 360)))))))))
    (if (i32.eq (local.get $method) (i32.const 1))
      (then
        (if (i32.and (f64.gt (local.get $difference) (f64.const 0)) (f64.lt (local.get $difference) (f64.const 180)))
          (then (local.set $from (f64.add (local.get $from) (f64.const 360))))
          (else
            (if (i32.and (f64.gt (local.get $difference) (f64.const -180)) (f64.le (local.get $difference) (f64.const 0)))
              (then (local.set $to (f64.add (local.get $to) (f64.const 360)))))))))
    (if (i32.eq (local.get $method) (i32.const 2))
      (then
        (if (f64.lt (local.get $to) (local.get $from))
          (then (local.set $to (f64.add (local.get $to) (f64.const 360)))))))
    (if (i32.eq (local.get $method) (i32.const 3))
      (then
        (if (f64.lt (local.get $from) (local.get $to))
          (then (local.set $from (f64.add (local.get $from) (f64.const 360)))))))
    (call $mix_unit_degrees
      (f64.add (local.get $from) (f64.mul (f64.sub (local.get $to) (local.get $from)) (local.get $progress)))))

  ;; Interpolate two operands of one space at $progress (the second
  ;; operand's share, 0..1) and scale the result alpha by
  ;; $alphaMultiplier (CSS Color 4 §13, CSS Color 5 §3.3). The components
  ;; are not clamped. $result may alias either operand.
  (func $color_mix_interpolate (export "color_mix_interpolate")
    (param $first i32) (param $second i32) (param $method i32) (param $progress f64)
    (param $alphaMultiplier f64) (param $result i32) (result i32)
    (local $space i32) (local $hue i32) (local $index i32) (local $bit i32)
    (local $firstMask i32) (local $secondMask i32) (local $mask i32) (local $premultiplied i32)
    (local $firstAlpha f64) (local $secondAlpha f64) (local $alpha f64)
    (local $a f64) (local $b f64) (local $value f64)
    (local $r0 f64) (local $r1 f64) (local $r2 f64)
    (call $color_begin)
    (if (i32.eqz (call $mix_operand_valid (local.get $first)))
      (then (return (call $color_reject (global.get $COLOR_ERROR_SPAN_DIMENSIONS) (i32.const 0)))))
    (if (i32.eqz (call $mix_operand_valid (local.get $second)))
      (then (return (call $color_reject (global.get $COLOR_ERROR_SPAN_DIMENSIONS) (i32.const 1)))))
    (local.set $space (i32.load offset=36 (local.get $first)))
    (if (i32.or (i32.gt_u (local.get $space) (i32.const 14))
        (i32.ne (local.get $space) (i32.load offset=36 (local.get $second))))
      (then (return (call $color_reject (global.get $COLOR_ERROR_ENUM_VERSION) (i32.const 1)))))
    (if (i32.gt_u (local.get $method) (i32.const 3))
      (then (return (call $color_reject (global.get $COLOR_ERROR_ENUM_VERSION) (i32.const 2)))))
    (if (i32.eqz (i32.and (f64.ge (local.get $progress) (f64.const 0)) (f64.le (local.get $progress) (f64.const 1))))
      (then (return (call $color_reject (global.get $COLOR_ERROR_NUMERIC_PARAMETER) (i32.const 3)))))
    (if (i32.eqz (i32.and (f64.ge (local.get $alphaMultiplier) (f64.const 0)) (f64.le (local.get $alphaMultiplier) (f64.const 1))))
      (then (return (call $color_reject (global.get $COLOR_ERROR_NUMERIC_PARAMETER) (i32.const 4)))))
    (if (i32.eqz (call $mix_operand_valid (local.get $result)))
      (then (return (call $color_reject (global.get $COLOR_ERROR_SPAN_DIMENSIONS) (i32.const 5)))))
    (local.set $hue (call $mix_hue_index (local.get $space)))
    (local.set $firstMask (i32.load offset=32 (local.get $first)))
    (local.set $secondMask (i32.load offset=32 (local.get $second)))
    ;; A component missing from one operand takes the other's value.
    (local.set $firstAlpha
      (select (f64.load offset=24 (local.get $second)) (f64.load offset=24 (local.get $first))
        (i32.and (local.get $firstMask) (i32.const 8))))
    (local.set $secondAlpha
      (select (f64.load offset=24 (local.get $first)) (f64.load offset=24 (local.get $second))
        (i32.and (local.get $secondMask) (i32.const 8))))
    (local.set $mask (i32.and (local.get $firstMask) (local.get $secondMask)))
    ;; With alpha missing from both, the colors stay unpremultiplied and
    ;; the alpha stays missing.
    (local.set $premultiplied (i32.eqz (i32.and (local.get $mask) (i32.const 8))))
    (if (local.get $premultiplied)
      (then
        (local.set $alpha
          (f64.max (f64.const 0)
            (f64.min (f64.const 1)
              (f64.add (local.get $firstAlpha)
                (f64.mul (f64.sub (local.get $secondAlpha) (local.get $firstAlpha)) (local.get $progress))))))))
    (loop $components
      (local.set $bit (i32.shl (i32.const 1) (local.get $index)))
      (local.set $a (f64.load (i32.add (local.get $first) (i32.shl (local.get $index) (i32.const 3)))))
      (local.set $b (f64.load (i32.add (local.get $second) (i32.shl (local.get $index) (i32.const 3)))))
      (if (i32.and (local.get $firstMask) (local.get $bit)) (then (local.set $a (local.get $b))))
      (if (i32.and (local.get $secondMask) (local.get $bit)) (then (local.set $b (local.get $a))))
      (if (i32.eq (local.get $index) (local.get $hue))
        (then (local.set $value (call $mix_hue (local.get $a) (local.get $b) (local.get $progress) (local.get $method))))
        (else
          (if (local.get $premultiplied)
            (then
              (local.set $a (f64.mul (local.get $a) (local.get $firstAlpha)))
              (local.set $b (f64.mul (local.get $b) (local.get $secondAlpha)))))
          (local.set $value
            (f64.add (local.get $a) (f64.mul (f64.sub (local.get $b) (local.get $a)) (local.get $progress))))))
      (if (i32.eqz (local.get $index)) (then (local.set $r0 (local.get $value))))
      (if (i32.eq (local.get $index) (i32.const 1)) (then (local.set $r1 (local.get $value))))
      (if (i32.eq (local.get $index) (i32.const 2)) (then (local.set $r2 (local.get $value))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br_if $components (i32.lt_u (local.get $index) (i32.const 3))))
    (if (i32.and (local.get $premultiplied) (f64.ne (local.get $alpha) (f64.const 0)))
      (then
        (if (i32.ne (local.get $hue) (i32.const 0))
          (then (local.set $r0 (f64.div (local.get $r0) (local.get $alpha)))))
        (local.set $r1 (f64.div (local.get $r1) (local.get $alpha)))
        (if (i32.ne (local.get $hue) (i32.const 2))
          (then (local.set $r2 (f64.div (local.get $r2) (local.get $alpha)))))))
    (call $mix_store_record (local.get $result) (local.get $space)
      (local.get $r0) (local.get $r1) (local.get $r2)
      (f64.mul (local.get $alpha) (local.get $alphaMultiplier)) (local.get $mask))
    (i32.const 1))

  ;; An operand of any operand space as encoded extended sRGB in VEC;
  ;; missing components count as zero (CSS Color 4 §4.4). The alpha stays
  ;; in the operand.
  (func $color_mix_to_srgb (export "color_mix_to_srgb") (param $operand i32) (result i32)
    (local $space i32) (local $rectangular i32)
    (call $color_begin)
    (if (i32.eqz (call $mix_operand_valid (local.get $operand)))
      (then (return (call $color_reject (global.get $COLOR_ERROR_SPAN_DIMENSIONS) (i32.const 0)))))
    (local.set $space (i32.load offset=36 (local.get $operand)))
    (if (i32.gt_u (local.get $space) (i32.const 14))
      (then (return (call $color_reject (global.get $COLOR_ERROR_ENUM_VERSION) (i32.const 0)))))
    (call $mix_load_resolved (local.get $operand))
    (local.set $rectangular (call $mix_rectangular (local.get $space)))
    (if (i32.ne (local.get $rectangular) (local.get $space))
      (then (call $mix_polar_to_rectangular (local.get $space))))
    (if (local.get $rectangular)
      (then
        (call $mix_rectangular_to_xyz_d65 (local.get $rectangular))
        (call $mix_xyz_d65_to_rectangular (i32.const 0))))
    (i32.const 1))

  ;; ------------------------------------------------------------------
  ;; ICC profile lookup-table pipeline (src/color-profile.js).
  ;;
  ;; Applies one parsed A2B transform to a batch of device pixels IN
  ;; PLACE: per-channel curve stages (sampled tables, linear
  ;; interpolation), a trilinear 3-channel color lookup table, an
  ;; optional 3x3 matrix with offsets, the profile connection space
  ;; decode (XYZ u1.15 or Lab), and Bradford D50 -> D65 adaptation.
  ;; Output is linear XYZ at D65.
  ;;
  ;; The caller lays every table out in kernel memory above the fixed
  ;; scratch region and passes explicit pointers; a stage with entries
  ;; 0 / grid 0 / pointer 0 is skipped.
  ;; pcsMode: 0 = XYZ (u1.15 scale), 1 = Lab in the legacy 16-bit
  ;; encoding (mft2), 2 = Lab in the 8-bit / version 4 encoding
  ;; (mft1, mAB).
  ;; ------------------------------------------------------------------

  ;; Sample one curve table (entries f64 values over [0,1]) at x.
  (func $profile_curve (param $ptr i32) (param $entries i32) (param $x f64) (result f64)
    (local $t f64)
    (local $index i32)
    (local $start f64)
    (local.set $x (f64.min (f64.max (local.get $x) (f64.const 0)) (f64.const 1)))
    (local.set $t
      (f64.mul (local.get $x)
        (f64.convert_i32_s (i32.sub (local.get $entries) (i32.const 1)))))
    (local.set $index (i32.trunc_f64_s (f64.floor (local.get $t))))
    (if (i32.ge_s (local.get $index) (i32.sub (local.get $entries) (i32.const 1)))
      (then
        (return
          (f64.load
            (i32.add (local.get $ptr)
              (i32.mul (i32.sub (local.get $entries) (i32.const 1)) (i32.const 8)))))))
    (local.set $start
      (f64.load (i32.add (local.get $ptr) (i32.mul (local.get $index) (i32.const 8)))))
    (f64.add (local.get $start)
      (f64.mul
        (f64.sub
          (f64.load
            (i32.add (local.get $ptr)
              (i32.mul (i32.add (local.get $index) (i32.const 1)) (i32.const 8))))
          (local.get $start))
        (f64.sub (local.get $t) (f64.convert_i32_s (local.get $index))))))

  ;; One color-lookup-table entry: grid-cell (r,g,b), output channel ch.
  (func $clut_fetch (param $clutPtr i32) (param $grid i32)
    (param $r i32) (param $g i32) (param $b i32) (param $ch i32) (result f64)
    (f64.load
      (i32.add (local.get $clutPtr)
        (i32.add
          (i32.mul
            (i32.add
              (i32.mul
                (i32.add (i32.mul (local.get $r) (local.get $grid)) (local.get $g))
                (local.get $grid))
              (local.get $b))
            (i32.const 24))
          (i32.mul (local.get $ch) (i32.const 8))))))

  ;; Trilinear interpolation for one output channel.
  (func $clut_trilinear (param $clutPtr i32) (param $grid i32)
    (param $r0 i32) (param $g0 i32) (param $b0 i32)
    (param $fr f64) (param $fg f64) (param $fb f64) (param $ch i32) (result f64)
    (local $r1 i32)
    (local $g1 i32)
    (local $b1 i32)
    (local $v0 f64)
    (local $v1 f64)
    (local $lo f64)
    (local $hi f64)
    (local.set $r1 (i32.add (local.get $r0) (i32.const 1)))
    (local.set $g1 (i32.add (local.get $g0) (i32.const 1)))
    (local.set $b1 (i32.add (local.get $b0) (i32.const 1)))
    ;; b axis, then g axis, at r0.
    (local.set $lo
      (call $lerp
        (call $clut_fetch (local.get $clutPtr) (local.get $grid) (local.get $r0) (local.get $g0) (local.get $b0) (local.get $ch))
        (call $clut_fetch (local.get $clutPtr) (local.get $grid) (local.get $r0) (local.get $g0) (local.get $b1) (local.get $ch))
        (local.get $fb)))
    (local.set $hi
      (call $lerp
        (call $clut_fetch (local.get $clutPtr) (local.get $grid) (local.get $r0) (local.get $g1) (local.get $b0) (local.get $ch))
        (call $clut_fetch (local.get $clutPtr) (local.get $grid) (local.get $r0) (local.get $g1) (local.get $b1) (local.get $ch))
        (local.get $fb)))
    (local.set $v0 (call $lerp (local.get $lo) (local.get $hi) (local.get $fg)))
    ;; b axis, then g axis, at r1.
    (local.set $lo
      (call $lerp
        (call $clut_fetch (local.get $clutPtr) (local.get $grid) (local.get $r1) (local.get $g0) (local.get $b0) (local.get $ch))
        (call $clut_fetch (local.get $clutPtr) (local.get $grid) (local.get $r1) (local.get $g0) (local.get $b1) (local.get $ch))
        (local.get $fb)))
    (local.set $hi
      (call $lerp
        (call $clut_fetch (local.get $clutPtr) (local.get $grid) (local.get $r1) (local.get $g1) (local.get $b0) (local.get $ch))
        (call $clut_fetch (local.get $clutPtr) (local.get $grid) (local.get $r1) (local.get $g1) (local.get $b1) (local.get $ch))
        (local.get $fb)))
    (local.set $v1 (call $lerp (local.get $lo) (local.get $hi) (local.get $fg)))
    (call $lerp (local.get $v0) (local.get $v1) (local.get $fr)))

  (func $lerp (param $a f64) (param $b f64) (param $t f64) (result f64)
    (f64.add (local.get $a) (f64.mul (f64.sub (local.get $b) (local.get $a)) (local.get $t))))

  ;; Grid coordinate split: index (clamped to grid-2) and fraction.
  ;; Returns the index; writes the fraction to $TMP + slot*8.
  (func $clut_coord (param $x f64) (param $grid i32) (param $slot i32) (result i32)
    (local $t f64)
    (local $index i32)
    (local.set $t
      (f64.mul
        (f64.min (f64.max (local.get $x) (f64.const 0)) (f64.const 1))
        (f64.convert_i32_s (i32.sub (local.get $grid) (i32.const 1)))))
    (local.set $index (i32.trunc_f64_s (f64.floor (local.get $t))))
    (if (i32.gt_s (local.get $index) (i32.sub (local.get $grid) (i32.const 2)))
      (then (local.set $index (i32.sub (local.get $grid) (i32.const 2)))))
    (f64.store
      (i32.add (call $TMP) (i32.mul (local.get $slot) (i32.const 8)))
      (f64.sub (local.get $t) (f64.convert_i32_s (local.get $index))))
    (local.get $index))


  ;; Store the XYZ vector represented by an xy chromaticity.
  (func $colorStoreXyXyz (param $pointer i32) (param $x f64) (param $y f64)
    (f64.store (local.get $pointer) (f64.div (local.get $x) (local.get $y)))
    (f64.store offset=8 (local.get $pointer) (f64.const 1))
    (f64.store offset=16 (local.get $pointer)
      (f64.div
        (f64.sub (f64.sub (f64.const 1) (local.get $x)) (local.get $y))
        (local.get $y))))

  ;; Invert one row-major 3 by 3 matrix. Source and destination must differ.
  (func $colorMatrixInvert (param $source i32) (param $destination i32)
    (local $a f64) (local $b f64) (local $c f64)
    (local $d f64) (local $e f64) (local $f f64)
    (local $g f64) (local $h f64) (local $i f64)
    (local $ca f64) (local $cb f64) (local $cc f64) (local $scale f64)
    (local.set $a (f64.load (local.get $source)))
    (local.set $b (f64.load offset=8 (local.get $source)))
    (local.set $c (f64.load offset=16 (local.get $source)))
    (local.set $d (f64.load offset=24 (local.get $source)))
    (local.set $e (f64.load offset=32 (local.get $source)))
    (local.set $f (f64.load offset=40 (local.get $source)))
    (local.set $g (f64.load offset=48 (local.get $source)))
    (local.set $h (f64.load offset=56 (local.get $source)))
    (local.set $i (f64.load offset=64 (local.get $source)))
    (local.set $ca (f64.sub (f64.mul (local.get $e) (local.get $i)) (f64.mul (local.get $f) (local.get $h))))
    (local.set $cb (f64.sub (f64.mul (local.get $f) (local.get $g)) (f64.mul (local.get $d) (local.get $i))))
    (local.set $cc (f64.sub (f64.mul (local.get $d) (local.get $h)) (f64.mul (local.get $e) (local.get $g))))
    (local.set $scale
      (f64.div (f64.const 1)
        (f64.add
          (f64.add (f64.mul (local.get $a) (local.get $ca)) (f64.mul (local.get $b) (local.get $cb)))
          (f64.mul (local.get $c) (local.get $cc)))))
    (f64.store (local.get $destination) (f64.mul (local.get $ca) (local.get $scale)))
    (f64.store offset=8 (local.get $destination)
      (f64.mul (f64.sub (f64.mul (local.get $c) (local.get $h)) (f64.mul (local.get $b) (local.get $i))) (local.get $scale)))
    (f64.store offset=16 (local.get $destination)
      (f64.mul (f64.sub (f64.mul (local.get $b) (local.get $f)) (f64.mul (local.get $c) (local.get $e))) (local.get $scale)))
    (f64.store offset=24 (local.get $destination) (f64.mul (local.get $cb) (local.get $scale)))
    (f64.store offset=32 (local.get $destination)
      (f64.mul (f64.sub (f64.mul (local.get $a) (local.get $i)) (f64.mul (local.get $c) (local.get $g))) (local.get $scale)))
    (f64.store offset=40 (local.get $destination)
      (f64.mul (f64.sub (f64.mul (local.get $c) (local.get $d)) (f64.mul (local.get $a) (local.get $f))) (local.get $scale)))
    (f64.store offset=48 (local.get $destination) (f64.mul (local.get $cc) (local.get $scale)))
    (f64.store offset=56 (local.get $destination)
      (f64.mul (f64.sub (f64.mul (local.get $b) (local.get $g)) (f64.mul (local.get $a) (local.get $h))) (local.get $scale)))
    (f64.store offset=64 (local.get $destination)
      (f64.mul (f64.sub (f64.mul (local.get $a) (local.get $e)) (f64.mul (local.get $b) (local.get $d))) (local.get $scale))))

  (func $colorMatrixVectorComponent
    (param $matrix i32) (param $row i32) (param $vector i32) (result f64)
    (local $base i32)
    (local.set $base (i32.add (local.get $matrix) (i32.mul (local.get $row) (i32.const 24))))
    (f64.add
      (f64.add
        (f64.mul (f64.load (local.get $base)) (f64.load (local.get $vector)))
        (f64.mul (f64.load offset=8 (local.get $base)) (f64.load offset=8 (local.get $vector))))
      (f64.mul (f64.load offset=16 (local.get $base)) (f64.load offset=16 (local.get $vector)))))

  (func $colorMatrixMultiply (param $a i32) (param $b i32) (param $destination i32)
    (local $row i32) (local $column i32) (local $out i32)
    (block $done
      (loop $rows
        (local.set $column (i32.const 0))
        (loop $columns
          (local.set $out
            (i32.add (local.get $destination)
              (i32.mul
                (i32.add (i32.mul (local.get $row) (i32.const 3)) (local.get $column))
                (i32.const 8))))
          (f64.store (local.get $out)
            (f64.add
              (f64.add
                (f64.mul
                  (f64.load (i32.add (local.get $a) (i32.mul (local.get $row) (i32.const 24))))
                  (f64.load (i32.add (local.get $b) (i32.mul (local.get $column) (i32.const 8)))))
                (f64.mul
                  (f64.load offset=8 (i32.add (local.get $a) (i32.mul (local.get $row) (i32.const 24))))
                  (f64.load offset=24 (i32.add (local.get $b) (i32.mul (local.get $column) (i32.const 8))))))
              (f64.mul
                (f64.load offset=16 (i32.add (local.get $a) (i32.mul (local.get $row) (i32.const 24))))
                (f64.load offset=48 (i32.add (local.get $b) (i32.mul (local.get $column) (i32.const 8)))))))
          (local.set $column (i32.add (local.get $column) (i32.const 1)))
          (br_if $columns (i32.lt_u (local.get $column) (i32.const 3))))
        (local.set $row (i32.add (local.get $row) (i32.const 1)))
        (br_if $rows (i32.lt_u (local.get $row) (i32.const 3))))))

  ;; SMPTE RP 177: primary XYZ columns are scaled so RGB white maps to the
  ;; declared white point. The adjacent matrix is its XYZ-to-RGB inverse.
  (func $colorDeriveRgbMatrices
    (param $destination i32)
    (param $rx f64) (param $ry f64)
    (param $gx f64) (param $gy f64)
    (param $bx f64) (param $by f64)
    (param $wx f64) (param $wy f64)
    (local $inverse i32) (local $white i32)
    (local $s0 f64) (local $s1 f64) (local $s2 f64)
    (local.set $inverse (call $TMP))
    (local.set $white (call $CUR))
    (call $colorStoreXyXyz (local.get $white) (local.get $wx) (local.get $wy))
    (f64.store (local.get $destination) (f64.div (local.get $rx) (local.get $ry)))
    (f64.store offset=8 (local.get $destination) (f64.div (local.get $gx) (local.get $gy)))
    (f64.store offset=16 (local.get $destination) (f64.div (local.get $bx) (local.get $by)))
    (f64.store offset=24 (local.get $destination) (f64.const 1))
    (f64.store offset=32 (local.get $destination) (f64.const 1))
    (f64.store offset=40 (local.get $destination) (f64.const 1))
    (f64.store offset=48 (local.get $destination)
      (f64.div (f64.sub (f64.sub (f64.const 1) (local.get $rx)) (local.get $ry)) (local.get $ry)))
    (f64.store offset=56 (local.get $destination)
      (f64.div (f64.sub (f64.sub (f64.const 1) (local.get $gx)) (local.get $gy)) (local.get $gy)))
    (f64.store offset=64 (local.get $destination)
      (f64.div (f64.sub (f64.sub (f64.const 1) (local.get $bx)) (local.get $by)) (local.get $by)))
    (call $colorMatrixInvert (local.get $destination) (local.get $inverse))
    (local.set $s0 (call $colorMatrixVectorComponent (local.get $inverse) (i32.const 0) (local.get $white)))
    (local.set $s1 (call $colorMatrixVectorComponent (local.get $inverse) (i32.const 1) (local.get $white)))
    (local.set $s2 (call $colorMatrixVectorComponent (local.get $inverse) (i32.const 2) (local.get $white)))
    (f64.store (local.get $destination) (f64.mul (f64.load (local.get $destination)) (local.get $s0)))
    (f64.store offset=8 (local.get $destination) (f64.mul (f64.load offset=8 (local.get $destination)) (local.get $s1)))
    (f64.store offset=16 (local.get $destination) (f64.mul (f64.load offset=16 (local.get $destination)) (local.get $s2)))
    (f64.store offset=24 (local.get $destination) (f64.mul (f64.load offset=24 (local.get $destination)) (local.get $s0)))
    (f64.store offset=32 (local.get $destination) (f64.mul (f64.load offset=32 (local.get $destination)) (local.get $s1)))
    (f64.store offset=40 (local.get $destination) (f64.mul (f64.load offset=40 (local.get $destination)) (local.get $s2)))
    (f64.store offset=48 (local.get $destination) (f64.mul (f64.load offset=48 (local.get $destination)) (local.get $s0)))
    (f64.store offset=56 (local.get $destination) (f64.mul (f64.load offset=56 (local.get $destination)) (local.get $s1)))
    (f64.store offset=64 (local.get $destination) (f64.mul (f64.load offset=64 (local.get $destination)) (local.get $s2)))
    (call $colorMatrixInvert (local.get $destination) (i32.add (local.get $destination) (i32.const 72))))

  ;; Linear Bradford adaptation, derived independently in each direction.
  (func $colorDeriveAdaptation
    (param $destination i32)
    (param $sourceWhite i32) (param $destinationWhite i32)
    (local $bradford i32) (local $inverse i32) (local $scaled i32)
    (local $s0 f64) (local $s1 f64) (local $s2 f64)
    (local.set $bradford (i32.add (global.get $COLOR_BASE) (i32.const 2704)))
